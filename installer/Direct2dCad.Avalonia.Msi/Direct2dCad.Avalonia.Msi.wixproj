<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">1.0.6</Version>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">0.1.6</ReleaseVersion>
    <PackageName>Direct2dCad Avalonia</PackageName>
    <OutputName>Direct2dCad.Avalonia</OutputName>
    <DefineConstants>$(DefineConstants);PayloadDirectory=$(PayloadDirectory);ReleaseVersion=$(ReleaseVersion);Version=$(Version);IconFile=$(MSBuildProjectDirectory)\..\..\Direct2dCad.wpf\Direct2dCad.ico</DefineConstants>
    <OutputPath Condition="'$(ReleaseArtifactsDirectory)' != ''">$(ReleaseArtifactsDirectory)\</OutputPath>
    <SuppressIces>ICE30;ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <BindPath Include="$(PayloadDirectory)" BindName="AppPayload" />
  </ItemGroup>
</Project>
