<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">1.0.5</Version>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">0.1.5</ReleaseVersion>
    <PackageName>Direct2dCad</PackageName>
    <OutputName>Direct2dCad</OutputName>
    <DefineConstants>$(DefineConstants);PublishDirectory=$(PublishDirectory);ReleaseVersion=$(ReleaseVersion);Version=$(Version)</DefineConstants>
    <OutputPath Condition="'$(ReleaseArtifactsDirectory)' != ''">$(ReleaseArtifactsDirectory)\</OutputPath>
    <SuppressIces>ICE30;ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <BindPath Include="$(PublishDirectory)" BindName="AppPayload" />
  </ItemGroup>
</Project>
