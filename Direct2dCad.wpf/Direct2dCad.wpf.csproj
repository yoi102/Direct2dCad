<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Direct2dCad.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishAot>false</PublishAot>
    <AssemblyName>Direct2dCad</AssemblyName>
    <!-- Program.Main runs the MCP stdio bridge before WPF starts, then calls the generated App.Main. -->
    <StartupObject>Direct2dCad.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Direct2dCad.ico" />

    <None Include="Direct2dCad.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antelcat.I18N.WPF" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.DependencyInjection" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Json" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.Arc" />
    <PackageReference Include="gong-wpf-dragdrop" />
    <PackageReference Include="MahApps.Metro" />
    <PackageReference Include="MaterialDesignThemes.MahApps" />
    <PackageReference Include="MessagePipe" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Direct2dCad.Mcp\Direct2dCad.Mcp.csproj" />
    <ProjectReference Include="..\Direct2dCad.Agent.Codex\Direct2dCad.Agent.Codex.csproj" />
    <ProjectReference Include="..\Direct2dCad.AI.Contracts\Direct2dCad.AI.Contracts.csproj" />
    <ProjectReference Include="..\Direct2dCad.AI.LmStudio\Direct2dCad.AI.LmStudio.csproj" />
    <ProjectReference Include="..\Direct2dCad.CommandLine\Direct2dCad.CommandLine.csproj" />
    <ProjectReference Include="..\Direct2dCad.wpf.Controls\Direct2dCad.wpf.Controls.csproj" />
    <ProjectReference Include="..\Direct2dCad.Editor\Direct2dCad.Editor.csproj" />
    <ProjectReference Include="..\Direct2dCad.Ole.Windows\Direct2dCad.Ole.Windows.csproj" />
    <ProjectReference Include="..\Direct2dCad.Rendering.Direct2D\Direct2dCad.Rendering.Direct2D.csproj" />
    <ProjectReference Include="..\Direct2dCad.ViewModels\Direct2dCad.ViewModels.csproj" />
    <ProjectReference Include="..\Direct2dCad.ViewModels.Services\Direct2dCad.ViewModels.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Direct2dCad.Windows.IntegrationTests" />
  </ItemGroup>

</Project>
