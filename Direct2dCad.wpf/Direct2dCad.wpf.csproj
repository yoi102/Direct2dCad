<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Direct2dCad.ico</ApplicationIcon>
    <Version>0.0.0.1</Version>
    <AssemblyVersion>0.0.0.1</AssemblyVersion>
    <FileVersion>0.0.0.1</FileVersion>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishAot>false</PublishAot>
    <AssemblyName>Direct2dCad</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Direct2dCad.ico" />

    <None Include="Direct2dCad.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antelcat.I18N.WPF" Version="2.0.0-preview-1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.DependencyInjection" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Json" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.Arc" Version="5.0.0" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="MahApps.Metro" Version="3.0.0-rc0529" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="5.3.3-ci1419" />
    <PackageReference Include="MessagePipe" Version="1.8.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Direct2dCad.Agent.Codex\Direct2dCad.Agent.Codex.csproj" />
    <ProjectReference Include="..\Direct2dCad.AI.Contracts\Direct2dCad.AI.Contracts.csproj" />
    <ProjectReference Include="..\Direct2dCad.AI.LmStudio\Direct2dCad.AI.LmStudio.csproj" />
    <ProjectReference Include="..\Direct2dCad.CommandLine\Direct2dCad.CommandLine.csproj" />
    <ProjectReference Include="..\Direct2dCad.wpf.Controls\Direct2dCad.wpf.Controls.csproj" />
    <ProjectReference Include="..\Direct2dCad.Editor\Direct2dCad.Editor.csproj" />
    <ProjectReference Include="..\Direct2dCad.Ole.Windows\Direct2dCad.Ole.Windows.csproj" />
    <ProjectReference Include="..\Direct2dCad.ViewModels\Direct2dCad.ViewModels.csproj" />
    <ProjectReference Include="..\Direct2dCad.ViewModels.Services\Direct2dCad.ViewModels.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Direct2dCad.Windows.IntegrationTests" />
  </ItemGroup>

</Project>
