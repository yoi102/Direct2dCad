<mah:MetroWindow x:Class="Direct2dCad.wpf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:controls="clr-namespace:Direct2dCad.wpf.Controls"
                 xmlns:views="clr-namespace:Direct2dCad.wpf.Views"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
                 xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                 xmlns:avalonDockThemes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Arc"
                 xmlns:selectors="clr-namespace:Direct2dCad.wpf.Selectors"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ass="clr-namespace:Direct2dCad.wpf.Assists"
                 xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
                 xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
                 xmlns:vm="clr-namespace:Direct2dCad.ViewModels;assembly=Direct2dCad.ViewModels"
                 xmlns:svc="clr-namespace:Direct2dCad.ViewModels.Services.Platform;assembly=Direct2dCad.ViewModels.Services"
                 xmlns:vm_tb="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
                 xmlns:v_tb="clr-namespace:Direct2dCad.wpf.Views.Toolboxes"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                 Icon="Direct2dCad.ico"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Topmost="{Binding Topmost}"
                 TitleAlignment="Center"
                 TitleCharacterCasing="Normal"
                 ShowIconOnTitleBar="True"
                 Title="{I18N {x:Static r:LangKeys.Direct2dCad}}"
                 WindowStartupLocation="CenterScreen"
                 Height="1000"
                 Width="1200">
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button Margin="15 0 0 0"
                    Content="{md:PackIcon Kind=Github, Size=20}"
                    Click="IconClicked"
                    Width="35"
                    Height="22" />
            <Menu VerticalAlignment="Center"
                  md:MenuAssist.TopLevelMenuItemHeight="25">
                <MenuItem Foreground="White"
                          Header="{I18N {x:Static r:LangKeys.File}}">
                    <MenuItem Command="{Binding NewCommand}"
                              Icon="{md:PackIcon Kind=FilePlus}"
                              Foreground="White"
                              Header="{I18N {x:Static r:LangKeys.New}}" />
                    <MenuItem Command="{Binding OpenFileCommand}"
                              Icon="{md:PackIcon Kind=FolderOpen}"
                              Foreground="White"
                              Header="{I18N {x:Static r:LangKeys.OpenFile}}" />
                    <MenuItem Command="{Binding CurrentEditorTabViewModel.SaveFileCommand}"
                              Icon="{md:PackIcon Kind=ContentSave}"
                              Foreground="White"
                              Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}"
                              Header="{I18N {x:Static r:LangKeys.Save}}" />
                    <MenuItem Command="{Binding CurrentEditorTabViewModel.SaveAsFileCommand}"
                              Icon="{md:PackIcon Kind=ContentSaveAdd}"
                              Foreground="White"
                              Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}"
                              Header="{I18N {x:Static r:LangKeys.SaveAs}}" />
                </MenuItem>
            </Menu>

        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>

            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource MaterialDesignActionSecondaryToggleButton}"
                              Content="{md:PackIcon Kind=PinOff,  Size=20}"
                              IsChecked="{Binding Topmost}"
                              Background="Transparent"
                              Foreground="White"
                              md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=Pin}" />
                <ToggleButton md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=WeatherNight}"
                              Background="Transparent"
                              Content="{md:PackIcon Kind=WhiteBalanceSunny,Size=20}"
                              Foreground="White"
                              IsChecked="{Binding IsDarkTheme}"
                              Style="{StaticResource MaterialDesignActionSecondaryToggleButton}" />

                <Menu VerticalAlignment="Center"
                      md:MenuAssist.TopLevelMenuItemHeight="25"
                      Width="70">
                    <MenuItem Foreground="White"
                              Header="{Binding CurrentCultureLCID, Converter={x:Static cv:LCIDToStringConverter.Instance}}">
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="1033"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="{I18N {x:Static r:LangKeys.English}}" />
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="1041"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="{I18N {x:Static r:LangKeys.Japanese}}" />
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="2052"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="{I18N {x:Static r:LangKeys.Chinese}}" />
                    </MenuItem>
                </Menu>
            </StackPanel>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <Grid>
        <md:DialogHost Style="{StaticResource MaterialDesignEmbeddedDialogHost}"
                       Identifier="{x:Static svc:ViewServiceIdentifiers.RootDialogHost}"
                       Background="{DynamicResource MaterialDesign.Brush.Background}"
                       DialogTheme="Inherit">

            <Grid RowDefinitions="auto * auto"
                  Background="{DynamicResource MaterialDesign.Brush.Background}">
                <views:MainRibbonView Grid.Row="0"
                                      Height="150"
                                      DataContext="{Binding Path=.}" />
                <Grid  Grid.Row="1">
                    <Grid.Resources>

                        <!--侧边栏工具箱的DataTemplate-->
                        <!-- DataTemplate: how to render each toolbox VM's content -->
                        <DataTemplate DataType="{x:Type vm_tb:EntityPropertiesToolboxViewModel}">
                            <v_tb:EntityPropertiesToolboxView />
                        </DataTemplate>
                        <!-- DataTemplate: how to render each toolbox VM's content -->
                        <DataTemplate DataType="{x:Type vm_tb:DocumentExplorerToolboxViewModel}">
                            <v_tb:DocumentExplorerToolboxView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm_tb:LayersToolboxViewModel}">
                            <v_tb:LayersToolboxView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm_tb:BlocksToolboxViewModel}">
                            <v_tb:BlocksToolboxView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm_tb:EntitySearchToolboxViewModel}">
                            <v_tb:EntitySearchToolboxView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm_tb:SelectionFilterToolboxViewModel}">
                            <v_tb:SelectionFilterToolboxView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm_tb:CommandLineToolboxViewModel}">
                            <v_tb:CommandLineToolboxView />
                        </DataTemplate>
                        <!-- DataTemplate: how to render each toolbox VM's content -->
                        <DataTemplate DataType="{x:Type vm:EditorTabViewModel}">
                            <views:EditorTabView />
                        </DataTemplate>            



                        <!-- Document header template (tab header with icon + title) -->
                        <DataTemplate x:Key="DocumentTabHeaderTemplate">
                            <StackPanel Orientation="Horizontal">

                                <md:PackIcon Kind="{Binding ., Converter={x:Static cv:DocumentViewModelTypeToIconType.Instance}}"
                                             Width="14"
                                             Height="14"
                                             Margin="0,0,5,0" />

                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>

                        <!-- LayoutItem style selector: different styles for toolboxes vs documents -->
                        <selectors:PanesStyleSelector x:Key="PanesStyleSelector">
                            <selectors:PanesStyleSelector.ToolboxStyle>
                                <Style TargetType="{x:Type avalonDockControls:LayoutAnchorableItem}">
                                    <Setter Property="Title"
                                            Value="{Binding Model.Title}" />
                                    <Setter Property="ContentId"
                                            Value="{Binding Model.ContentId}" />
                                    <Setter Property="ClipToBounds"
                                            Value="True" />
                                </Style>
                            </selectors:PanesStyleSelector.ToolboxStyle>
                            <selectors:PanesStyleSelector.DocumentStyle>
                                <Style TargetType="{x:Type avalonDockControls:LayoutDocumentItem}">
                                    <Setter Property="Title"
                                            Value="{Binding Model.Title}" />
                                    <Setter Property="ToolTip"
                                            Value="{Binding Model.ToolTip}" />
                                    <Setter Property="ContentId"
                                            Value="{Binding Model.ContentId}" />
                                </Style>
                            </selectors:PanesStyleSelector.DocumentStyle>
                        </selectors:PanesStyleSelector>
                    </Grid.Resources>

                    <avalonDock:ToggleDockingManager x:Name="dockManager"
                                                     Grid.Row="1"
                                                     BorderThickness="0"
                                                     DocumentClosing="dockManager_DocumentClosing"
                                                     DockLayout="{Binding DockLayout}"
                                                     DocumentHeaderTemplate="{StaticResource DocumentTabHeaderTemplate}"
                                                     LayoutItemContainerStyleSelector="{StaticResource PanesStyleSelector}">
                        <i:Interaction.Triggers>

                            <!-- 文档关闭前 -->
                            <i:EventTrigger EventName="DocumentClosed">
                                <i:InvokeCommandAction Command="{Binding DocumentClosedCommand}"
                                                       EventArgsParameterPath="Document.Content"
                                                       PassEventArgsToCommand="True" />
                            </i:EventTrigger>

                            <!-- Active 文档切换 -->
                            <i:EventTrigger EventName="ActiveContentChanged">
                                <i:InvokeCommandAction Command="{Binding ActiveContentChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <avalonDock:ToggleDockingManager.Theme>
                            <avalonDockThemes:ArcDarkTheme />
                        </avalonDock:ToggleDockingManager.Theme>
                        <avalonDock:LayoutRoot>
                            <avalonDock:LayoutPanel Orientation="Horizontal">
                                <avalonDock:LayoutDocumentPaneGroup>

                                    <avalonDock:LayoutDocumentPane x:Name="LayoutDocumentPane">
                                        <avalonDock:LayoutDocument Title="{I18N {x:Static r:LangKeys.Welcome}}"
                                                                   ContentId="welcome">
                                            <Border Background="{DynamicResource AppEditorBg}"
                                                    Padding="40">
                                                <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <md:PackIcon  Kind="HandWaveOutline"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Width="80"
                                                                  Height="80" />
                                                    <TextBlock Margin="0 20 0 0"
                                                               Text="{I18N {x:Static r:LangKeys.Direct2dCad}}"
                                                               FontSize="28"
                                                               FontWeight="Light"
                                                               HorizontalAlignment="Center" />

                                                    <TextBlock Margin="0 25 0 0"
                                                               FontSize="13"
                                                               TextAlignment="Center"
                                                               LineHeight="24">
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </avalonDock:LayoutDocument>
                                    </avalonDock:LayoutDocumentPane>
                                </avalonDock:LayoutDocumentPaneGroup>
                            </avalonDock:LayoutPanel>
                        </avalonDock:LayoutRoot>
                    </avalonDock:ToggleDockingManager>
                </Grid>

                <views:MainStatusBarView  Grid.Row="2"
                                          DataContext="{Binding Path=.}" />
            </Grid>
        </md:DialogHost>

        <md:Snackbar Margin="10"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     ass:SnackbarIdentifierAssist.SnackbarIdentifier="{x:Static svc:ViewServiceIdentifiers.RootSnackbar}"
                     MessageQueue="{md:MessageQueue}" />
    </Grid>
</mah:MetroWindow>
