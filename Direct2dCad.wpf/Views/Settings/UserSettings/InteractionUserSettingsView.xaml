<UserControl x:Class="Direct2dCad.wpf.Views.Settings.UserSettings.InteractionUserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="400"
             d:Width="600"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:usersettings="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels"
             d:DataContext="{d:DesignInstance Type=usersettings:InteractionUserSettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,8,0,12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>
        <Style x:Key="SettingLabel"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,16,10" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style x:Key="SettingInput"
               TargetType="Control">
            <Setter Property="MinWidth"
                    Value="190" />
            <Setter Property="Margin"
                    Value="0,0,0,10" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.SelectedEntity}}" />
            <TextBlock Grid.Row="1"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="1"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectedEntityStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="2"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="2"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding SelectedEntityStrokeWidth}" />

            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.Grip}}" />
            <TextBlock Grid.Row="4"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="4"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GripStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="5"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.FillColor}}" />
            <mah:ColorPicker Grid.Row="5"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GripFillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="6"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.Size}}" />
            <mah:NumericUpDown Grid.Row="6"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.5"
                               Value="{Binding GripSize}" />
            <TextBlock Grid.Row="7"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="7"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding GripStrokeWidth}" />

            <TextBlock Grid.Row="8"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.GripPreview}}" />
            <TextBlock Grid.Row="9"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="9"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GripPreviewStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="10"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.FillColor}}" />
            <mah:ColorPicker Grid.Row="10"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GripPreviewFillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="11"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="11"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding GripPreviewStrokeWidth}" />

            <TextBlock Grid.Row="12"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:LangKeys.SelectionWindow}}" />
            <TextBlock Grid.Row="13"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="13"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectionWindowStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="14"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.FillColor}}" />
            <mah:ColorPicker Grid.Row="14"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectionWindowFillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="15"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="15"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding SelectionWindowStrokeWidth}" />

            <TextBlock Grid.Row="16"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:LangKeys.SelectionCrossing}}" />
            <TextBlock Grid.Row="17"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="17"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectionCrossingStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="18"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.FillColor}}" />
            <mah:ColorPicker Grid.Row="18"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectionCrossingFillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="19"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="19"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding SelectionCrossingStrokeWidth}" />
        </Grid>

        <Expander Margin="0,12,0,8"
                  IsExpanded="True"
                  Header="{I18N {x:Static r:UserSettingsLangKeys.RadialMenu}}">
            <StackPanel Margin="12,8,8,8">
                <CheckBox Margin="0,0,0,10"
                          Content="{I18N {x:Static r:UserSettingsLangKeys.RadialMenuEnabled}}"
                          IsChecked="{Binding RadialMenu.IsEnabled, Mode=TwoWay}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
                             Margin="0,0,12,0"
                             ItemsSource="{Binding RadialMenu.Profiles}"
                             SelectedItem="{Binding RadialMenu.SelectedProfile, Mode=TwoWay}"
                             DisplayMemberPath="DisplayName" />
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding RadialMenu.SelectedProfile.Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="{Binding DisplayName}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.RadialMenu.ActionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedAction, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
