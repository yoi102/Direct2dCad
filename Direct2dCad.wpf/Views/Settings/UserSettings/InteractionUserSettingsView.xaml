<UserControl x:Class="Direct2dCad.wpf.Views.Settings.UserSettings.InteractionUserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Direct2dCad.wpf.Controls"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="400"
             d:Width="600"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:usersettings="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels"
             d:DataContext="{d:DesignInstance Type=usersettings:InteractionUserSettingsViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../CadToolIconResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,8,0,12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>
        <Style x:Key="SettingLabel"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,16,10" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style x:Key="SettingInput"
               TargetType="Control">
            <Setter Property="MinWidth"
                    Value="190" />
            <Setter Property="Margin"
                    Value="0,0,0,10" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.SelectedEntity}}" />
            <TextBlock Grid.Row="1"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="1"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectedEntityStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="2"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="2"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding SelectedEntityStrokeWidth}" />

            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.Grip}}" />
            <TextBlock Grid.Row="4"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="4"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GripStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="5"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.FillColor}}" />
            <mah:ColorPicker Grid.Row="5"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GripFillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="6"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.Size}}" />
            <mah:NumericUpDown Grid.Row="6"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.5"
                               Value="{Binding GripSize}" />
            <TextBlock Grid.Row="7"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="7"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding GripStrokeWidth}" />

            <TextBlock Grid.Row="8"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.GripPreview}}" />
            <TextBlock Grid.Row="9"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="9"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GripPreviewStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="10"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.FillColor}}" />
            <mah:ColorPicker Grid.Row="10"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GripPreviewFillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="11"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="11"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding GripPreviewStrokeWidth}" />

            <TextBlock Grid.Row="12"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:LangKeys.SelectionWindow}}" />
            <TextBlock Grid.Row="13"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="13"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectionWindowStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="14"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.FillColor}}" />
            <mah:ColorPicker Grid.Row="14"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectionWindowFillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="15"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="15"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding SelectionWindowStrokeWidth}" />

            <TextBlock Grid.Row="16"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource SectionHeader}"
                       Text="{I18N {x:Static r:LangKeys.SelectionCrossing}}" />
            <TextBlock Grid.Row="17"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeColor}}" />
            <mah:ColorPicker Grid.Row="17"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectionCrossingStrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="18"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.FillColor}}" />
            <mah:ColorPicker Grid.Row="18"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SelectionCrossingFillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="19"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.StrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="19"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding SelectionCrossingStrokeWidth}" />
        </Grid>

        <Expander Margin="0,12,0,8"
                  IsExpanded="True"
                  Header="{I18N {x:Static r:UserSettingsLangKeys.RadialMenu}}">
            <StackPanel Margin="12,8,8,8">
                <CheckBox Margin="0,0,0,10"
                          Content="{I18N {x:Static r:UserSettingsLangKeys.RadialMenuEnabled}}"
                          IsChecked="{Binding RadialMenu.IsEnabled, Mode=TwoWay}" />
                <Grid IsEnabled="{Binding RadialMenu.IsEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
                             Margin="0,0,12,0"
                             ItemsSource="{Binding RadialMenu.Profiles}"
                             SelectedItem="{Binding RadialMenu.SelectedProfile, Mode=TwoWay}"
                             DisplayMemberPath="DisplayName" />
                    <StackPanel Grid.Column="1">
                        <Canvas x:Name="RadialMenuCanvas"
                                Width="348"
                                Height="348"
                                HorizontalAlignment="Center">
                            <Ellipse Width="312"
                                     Height="312"
                                     Canvas.Left="18"
                                     Canvas.Top="18"
                                     Fill="{DynamicResource MaterialDesignPaper}"
                                     Stroke="{DynamicResource MaterialDesignDivider}"
                                     StrokeThickness="1" />
                            <Line X1="174" Y1="174" X2="174" Y2="18" Stroke="{DynamicResource MaterialDesignDivider}" />
                            <Line X1="174" Y1="174" X2="284" Y2="64" Stroke="{DynamicResource MaterialDesignDivider}" />
                            <Line X1="174" Y1="174" X2="330" Y2="174" Stroke="{DynamicResource MaterialDesignDivider}" />
                            <Line X1="174" Y1="174" X2="284" Y2="284" Stroke="{DynamicResource MaterialDesignDivider}" />
                            <Line X1="174" Y1="174" X2="174" Y2="330" Stroke="{DynamicResource MaterialDesignDivider}" />
                            <Line X1="174" Y1="174" X2="64" Y2="284" Stroke="{DynamicResource MaterialDesignDivider}" />
                            <Line X1="174" Y1="174" X2="18" Y2="174" Stroke="{DynamicResource MaterialDesignDivider}" />
                            <Line X1="174" Y1="174" X2="64" Y2="64" Stroke="{DynamicResource MaterialDesignDivider}" />
                            <ItemsControl ItemsSource="{Binding RadialMenu.SelectedProfile.Slots}"
                                          dd:DragDrop.IsDropTarget="True"
                                          dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          dd:DragDrop.IsDragSource="True"
                                          dd:DragDrop.DragHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          dd:DragDrop.UseDefaultDragAdorner="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="147" />
                                        <Setter Property="Canvas.Top" Value="22" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Index}" Value="1"><Setter Property="Canvas.Left" Value="248" /><Setter Property="Canvas.Top" Value="64" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Index}" Value="2"><Setter Property="Canvas.Left" Value="288" /><Setter Property="Canvas.Top" Value="147" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Index}" Value="3"><Setter Property="Canvas.Left" Value="248" /><Setter Property="Canvas.Top" Value="247" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Index}" Value="4"><Setter Property="Canvas.Left" Value="147" /><Setter Property="Canvas.Top" Value="288" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Index}" Value="5"><Setter Property="Canvas.Left" Value="46" /><Setter Property="Canvas.Top" Value="247" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Index}" Value="6"><Setter Property="Canvas.Left" Value="6" /><Setter Property="Canvas.Top" Value="147" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Index}" Value="7"><Setter Property="Canvas.Left" Value="46" /><Setter Property="Canvas.Top" Value="64" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="54"
                                                Height="54"
                                                Padding="9"
                                                Background="{DynamicResource MaterialDesign.Brush.Background}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                BorderThickness="1"
                                                CornerRadius="27"
                                                ToolTip="{Binding SelectedAction.DisplayName}">
                                            <controls:CadRadialMenuActionIcon Action="{Binding SelectedAction.Action}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Width="92"
                                    Height="92"
                                    Canvas.Left="128"
                                    Canvas.Top="128"
                                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="46"
                                    Tag="CadRadialMenuDeleteTarget"
                                    ToolTip="{I18N {x:Static r:LangKeys.DeleteSelection}}"
                                    dd:DragDrop.IsDropTarget="True"
                                    dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <md:PackIcon Kind="DeleteOutline"
                                             Width="28"
                                             Height="28"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Opacity="0.65" />
                            </Border>
                        </Canvas>
                        <ListBox Margin="0,8,0,0"
                                 Height="170"
                                 ItemsSource="{Binding RadialMenu.ActionOptions}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 dd:DragDrop.IsDragSource="True"
                                 dd:DragDrop.UseDefaultDragAdorner="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="42" />
                                    <Setter Property="Height" Value="42" />
                                    <Setter Property="Padding" Value="8" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <controls:CadRadialMenuActionIcon Action="{Binding Action}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
