<mah:MetroWindow x:Class="Direct2dCad.wpf.Views.Settings.UserSettings.UserSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
                 xmlns:local="clr-namespace:Direct2dCad.wpf.Views.Settings.UserSettings"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:usersettings="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels"
                 d:DataContext="{d:DesignInstance Type=usersettings:UserSettingsViewModel}"
                 mc:Ignorable="d"
                 Title="{I18N {x:Static r:UserSettingsLangKeys.ApplicationSettings}}"
                 Background="{DynamicResource MaterialDesign.Brush.Background}"
                 TitleCharacterCasing="Normal"
                 Width="760"
                 Height="650"
                 MinWidth="650"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <Border>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:UserSettingsView />

            <TextBlock Grid.Row="1"
                       Margin="4,8,4,0"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       Text="{Binding ValidationError}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="88"
                        Margin="0,0,8,0"
                        Click="Ok_Click"
                        Content="{I18N {x:Static r:LangKeys.Ok}}"
                        IsDefault="True" />
                <Button MinWidth="88"
                        Margin="0,0,8,0"
                        Click="Apply_Click"
                        Content="{I18N {x:Static r:LangKeys.Apply}}" />
                <Button MinWidth="88"
                        Click="Cancel_Click"
                        Content="{I18N {x:Static r:LangKeys.Cancel}}"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</mah:MetroWindow>
