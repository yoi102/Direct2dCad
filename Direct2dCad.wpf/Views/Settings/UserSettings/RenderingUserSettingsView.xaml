<UserControl x:Class="Direct2dCad.wpf.Views.Settings.UserSettings.RenderingUserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="400"
             d:Width="600"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:usersettings="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels"
             d:DataContext="{d:DesignInstance Type=usersettings:RenderingUserSettingsViewModel}">
    <StackPanel>
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.Antialiasing}}"
                  IsChecked="{Binding IsAntialiasingEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:LangKeys.TextAntialiasing}}"
                  IsChecked="{Binding IsTextAntialiasingEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.ShowFramesPerSecond}}"
                  IsChecked="{Binding ShowFramesPerSecond}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.ZoomSnapshotPreview}}"
                  IsChecked="{Binding IsZoomSnapshotPreviewEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.ApproximateTileScaleFallback}}"
                  IsChecked="{Binding AllowApproximateTileScaleFallback}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.LevelOfDetailOptimization}}"
                  IsChecked="{Binding IsLevelOfDetailEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.BackgroundChunkRecording}}"
                  IsChecked="{Binding IsBackgroundChunkRecordingEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.ParallelRendering}}"
                  IsChecked="{Binding IsParallelRenderingEnabled}" />
        <Grid Margin="24,0,0,0"
              IsEnabled="{Binding IsParallelRenderingEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,12,10"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.ParallelRenderingMode}}" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,0,10"
                      ItemsSource="{Binding ParallelRenderingModeOptions}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedParallelRenderingMode}" />
            <TextBlock Grid.Row="1"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.ParallelRenderingWorkerCount}}" />
            <mah:NumericUpDown Grid.Row="1"
                               Grid.Column="1"
                               Width="100"
                               HorizontalAlignment="Left"
                               Minimum="2"
                               Maximum="4"
                               Interval="1"
                               Value="{Binding ParallelRenderingWorkerCount}" />
        </Grid>
    </StackPanel>
</UserControl>
