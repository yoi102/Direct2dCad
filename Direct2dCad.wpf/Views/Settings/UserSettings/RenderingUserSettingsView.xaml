<UserControl x:Class="Direct2dCad.wpf.Views.Settings.UserSettings.RenderingUserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="400"
             d:Width="600"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:usersettings="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels"
             d:DataContext="{d:DesignInstance Type=usersettings:RenderingUserSettingsViewModel}">
    <StackPanel>
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.Antialiasing}}"
                  IsChecked="{Binding IsAntialiasingEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:LangKeys.TextAntialiasing}}"
                  IsChecked="{Binding IsTextAntialiasingEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.ShowFramesPerSecond}}"
                  IsChecked="{Binding ShowFramesPerSecond}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.ZoomSnapshotPreview}}"
                  IsChecked="{Binding IsZoomSnapshotPreviewEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.ApproximateTileScaleFallback}}"
                  IsChecked="{Binding AllowApproximateTileScaleFallback}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.LevelOfDetailOptimization}}"
                  IsChecked="{Binding IsLevelOfDetailEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.BackgroundChunkRecording}}"
                  IsChecked="{Binding IsBackgroundChunkRecordingEnabled}" />
        <CheckBox Margin="0,0,0,12"
                  Content="{I18N {x:Static r:UserSettingsLangKeys.MultiDeviceRendering}}"
                  IsChecked="{Binding IsMultiDeviceRenderingEnabled}" />
        <DockPanel IsEnabled="{Binding IsMultiDeviceRenderingEnabled}">
            <TextBlock Margin="24,0,12,0"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:UserSettingsLangKeys.MultiDeviceRenderingDeviceCount}}" />
            <mah:NumericUpDown Width="100"
                               HorizontalAlignment="Left"
                               Minimum="2"
                               Maximum="4"
                               Interval="1"
                               Value="{Binding MultiDeviceRenderingDeviceCount}" />
        </DockPanel>
    </StackPanel>
</UserControl>
