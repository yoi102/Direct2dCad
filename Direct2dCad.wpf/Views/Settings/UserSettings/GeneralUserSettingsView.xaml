<UserControl x:Class="Direct2dCad.wpf.Views.Settings.UserSettings.GeneralUserSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="400"
             d:Width="600"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:usersettings="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels"
             d:DataContext="{d:DesignInstance Type=usersettings:GeneralUserSettingsViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="{I18N {x:Static r:UserSettingsLangKeys.DarkTheme}}" />
        <CheckBox Grid.Row="0"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsDarkTheme}" />
        <TextBlock Grid.Row="1"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="{I18N {x:Static r:UserSettingsLangKeys.Language}}" />
        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  MinWidth="190"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding CultureOptions}"
                  SelectedItem="{Binding SelectedCulture}"
                  DisplayMemberPath="Name" />
        <TextBlock Grid.Row="2"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="{I18N {x:Static r:UserSettingsLangKeys.PrimaryColor}}" />
        <mah:ColorPicker Grid.Row="2"
                         Grid.Column="1"
                         MinWidth="190"
                         Margin="0,0,0,12"
                         HorizontalAlignment="Stretch"
                         AddToRecentColorsTrigger="SelectedColorChanged"
                         SelectedColor="{Binding PrimaryColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
        <TextBlock Grid.Row="3"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="{I18N {x:Static r:UserSettingsLangKeys.SecondaryColor}}" />
        <mah:ColorPicker Grid.Row="3"
                         Grid.Column="1"
                         MinWidth="190"
                         Margin="0,0,0,12"
                         HorizontalAlignment="Stretch"
                         AddToRecentColorsTrigger="SelectedColorChanged"
                         SelectedColor="{Binding SecondaryColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
    </Grid>
</UserControl>
