<UserControl x:Class="Direct2dCad.wpf.Views.Settings.DocumentSettings.DocumentGridSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:ex="clr-namespace:Direct2dCad.wpf.Extensions"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:vm_en="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions"
             xmlns:settings="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="560"
             d:Width="600"
             d:DataContext="{d:DesignInstance Type=settings:DocumentGridSettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,16,10"
                           VerticalAlignment="Center"
                           Text="{I18N {x:Static r:LangKeys.GridType}}" />
                <ComboBox Grid.Column="1"
                          MinWidth="190"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadGridType}}}"
                          SelectedItem="{Binding GridType}" />
            </Grid>

            <Expander Margin="0,4,8,8"
                      IsExpanded="True"
                      Header="{I18N {x:Static r:LangKeys.GridDensity}}">
                <Grid Margin="12,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="260" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,8"
                                   FontWeight="SemiBold"
                                   Text="{I18N {x:Static r:LangKeys.GridSpacingOptions}}" />
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding GridSpacingPresets}"
                                 SelectedItem="{Binding SelectedGridSpacingPreset}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="2"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,6,0,0" Orientation="Horizontal">
                            <Button Width="30" Height="30" Padding="4"
                                    Command="{Binding AddGridSpacingPresetCommand}"
                                    ToolTip="{I18N {x:Static r:LangKeys.AddGridSpacingPreset}}">
                                <md:PackIcon Kind="Plus" Width="18" Height="18" />
                            </Button>
                            <Button Width="30" Height="30" Margin="4,0,0,0" Padding="4"
                                    Command="{Binding EditGridSpacingPresetCommand}"
                                    ToolTip="{I18N {x:Static r:LangKeys.EditGridSpacingPreset}}">
                                <md:PackIcon Kind="Pencil" Width="18" Height="18" />
                            </Button>
                            <Button Width="30" Height="30" Margin="4,0,0,0" Padding="4"
                                    Command="{Binding MoveGridSpacingPresetUpCommand}"
                                    ToolTip="{I18N {x:Static r:LangKeys.MoveUp}}">
                                <md:PackIcon Kind="ArrowUp" Width="18" Height="18" />
                            </Button>
                            <Button Width="30" Height="30" Margin="4,0,0,0" Padding="4"
                                    Command="{Binding MoveGridSpacingPresetDownCommand}"
                                    ToolTip="{I18N {x:Static r:LangKeys.MoveDown}}">
                                <md:PackIcon Kind="ArrowDown" Width="18" Height="18" />
                            </Button>
                            <Button Width="30" Height="30" Margin="12,0,0,0" Padding="4"
                                    Command="{Binding DeleteGridSpacingPresetCommand}"
                                    ToolTip="{I18N {x:Static r:LangKeys.DeleteGridSpacingPreset}}">
                                <md:PackIcon Kind="Delete" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,14"
                                   FontWeight="SemiBold"
                                   Text="{I18N {x:Static r:LangKeys.GridSpacingSelection}}" />
                        <TextBlock Grid.Row="1" Margin="0,0,12,10" VerticalAlignment="Center"
                                   Text="{I18N {x:Static r:LangKeys.MajorGridSpacing}}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                  ItemsSource="{Binding GridSpacingPresets}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedMajorGridPreset}" />
                        <TextBlock Grid.Row="2" Margin="0,0,12,10" VerticalAlignment="Center"
                                   Text="{I18N {x:Static r:LangKeys.MinorGridSpacing}}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                  ItemsSource="{Binding GridSpacingPresets}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedMinorGridPreset}" />
                        <TextBlock Grid.Row="3" Margin="0,0,12,10" VerticalAlignment="Center"
                                   Text="{I18N {x:Static r:LangKeys.MinimumScreenSpacing}}" />
                        <mah:NumericUpDown Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                           Minimum="4" Maximum="200" Interval="1"
                                           Value="{Binding GridMinimumScreenSpacing}" />
                    </Grid>
                </Grid>
            </Expander>

            <Expander Margin="0,4,8,8"
                      IsExpanded="True"
                      Header="{I18N {x:Static r:LangKeys.GridAppearance}}">
                <Grid Margin="12,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="198" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MinorGridColor}}" />
                    <mah:ColorPicker Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                     AddToRecentColorsTrigger="SelectedColorChanged"
                                     SelectedColor="{Binding GridMinorLineColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                    <TextBlock Grid.Row="1" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MinorGridLineWidth}}" />
                    <mah:NumericUpDown Grid.Row="1" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.05" Maximum="10" Interval="0.05"
                                       Value="{Binding GridMinorLineWidth}" />
                    <TextBlock Grid.Row="2" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MajorGridColor}}" />
                    <mah:ColorPicker Grid.Row="2" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                     AddToRecentColorsTrigger="SelectedColorChanged"
                                     SelectedColor="{Binding GridMajorLineColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                    <TextBlock Grid.Row="3" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MajorGridLineWidth}}" />
                    <mah:NumericUpDown Grid.Row="3" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.05" Maximum="10" Interval="0.05"
                                       Value="{Binding GridMajorLineWidth}" />
                </Grid>
            </Expander>

            <Expander Margin="0,4,8,8"
                      IsExpanded="True"
                      Header="{I18N {x:Static r:LangKeys.SnapMarker}}">
                <Grid Margin="12,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="198" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SnapMarkerType}}" />
                    <ComboBox Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadSnapMarkerType}}}"
                              SelectedItem="{Binding SnapMarkerType}" />
                    <TextBlock Grid.Row="1" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SnapMarkerColor}}" />
                    <mah:ColorPicker Grid.Row="1" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                     AddToRecentColorsTrigger="SelectedColorChanged"
                                     SelectedColor="{Binding SnapMarkerColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                    <TextBlock Grid.Row="2" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SnapMarkerLength}}" />
                    <mah:NumericUpDown Grid.Row="2" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="2" Maximum="200" Interval="1"
                                       Value="{Binding SnapMarkerLength}" />
                    <TextBlock Grid.Row="3" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SnapMarkerStrokeWidth}}" />
                    <mah:NumericUpDown Grid.Row="3" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.1" Maximum="10" Interval="0.1"
                                       Value="{Binding SnapMarkerStrokeWidth}" />
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
