<UserControl x:Class="Direct2dCad.wpf.Views.Settings.DocumentSettings.DocumentGridSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:ex="clr-namespace:Direct2dCad.wpf.Extensions"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:vm_en="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions"
             xmlns:settings="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="560"
             d:Width="600"
             d:DataContext="{d:DesignInstance Type=settings:DocumentGridSettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,16,10"
                           VerticalAlignment="Center"
                           Text="{I18N {x:Static r:LangKeys.GridType}}" />
                <ComboBox Grid.Column="1"
                          MinWidth="190"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadGridType}}}"
                          SelectedItem="{Binding GridType}" />
            </Grid>

            <Expander Margin="0,4,8,8"
                      IsExpanded="True"
                      Header="{I18N {x:Static r:LangKeys.GridDensity}}">
                <Grid Margin="12,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="198" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,16,10"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.GridDensityPreset}}" />
                    <ComboBox Grid.Column="1"
                              MinWidth="190"
                              Margin="0,0,0,10"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding GridDensityPresets}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedGridDensityPreset}" />

                    <TextBlock Grid.Row="1" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MajorGridSpacingXMillimeters}}" />
                    <mah:NumericUpDown Grid.Row="1" Grid.Column="1"
                                       MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.001" Maximum="100000"
                                       Interval="1" Speedup="True"
                                       Value="{Binding GridMajorSpacingXMillimeters}" />

                    <TextBlock Grid.Row="2" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MajorGridSpacingYMillimeters}}" />
                    <mah:NumericUpDown Grid.Row="2" Grid.Column="1"
                                       MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.001" Maximum="100000"
                                       Interval="1" Speedup="True"
                                       Value="{Binding GridMajorSpacingYMillimeters}" />

                    <TextBlock Grid.Row="3" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MinorGridSpacingXMillimeters}}" />
                    <mah:NumericUpDown Grid.Row="3" Grid.Column="1"
                                       MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.001" Maximum="100000"
                                       Interval="0.1" Speedup="True"
                                       Value="{Binding GridMinorSpacingXMillimeters}" />

                    <TextBlock Grid.Row="4" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MinorGridSpacingYMillimeters}}" />
                    <mah:NumericUpDown Grid.Row="4" Grid.Column="1"
                                       MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.001" Maximum="100000"
                                       Interval="0.1" Speedup="True"
                                       Value="{Binding GridMinorSpacingYMillimeters}" />

                    <TextBlock Grid.Row="5" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MinimumScreenSpacing}}" />
                    <mah:NumericUpDown Grid.Row="5" Grid.Column="1"
                                       MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="4" Maximum="200"
                                       Interval="1"
                                       Value="{Binding GridMinimumScreenSpacing}" />
                </Grid>
            </Expander>

            <Expander Margin="0,4,8,8"
                      IsExpanded="True"
                      Header="{I18N {x:Static r:LangKeys.GridAppearance}}">
                <Grid Margin="12,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="198" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MinorGridColor}}" />
                    <mah:ColorPicker Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                     AddToRecentColorsTrigger="SelectedColorChanged"
                                     SelectedColor="{Binding GridMinorLineColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                    <TextBlock Grid.Row="1" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MinorGridLineWidth}}" />
                    <mah:NumericUpDown Grid.Row="1" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.05" Maximum="10" Interval="0.05"
                                       Value="{Binding GridMinorLineWidth}" />
                    <TextBlock Grid.Row="2" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MajorGridColor}}" />
                    <mah:ColorPicker Grid.Row="2" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                     AddToRecentColorsTrigger="SelectedColorChanged"
                                     SelectedColor="{Binding GridMajorLineColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                    <TextBlock Grid.Row="3" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.MajorGridLineWidth}}" />
                    <mah:NumericUpDown Grid.Row="3" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.05" Maximum="10" Interval="0.05"
                                       Value="{Binding GridMajorLineWidth}" />
                </Grid>
            </Expander>

            <Expander Margin="0,4,8,8"
                      IsExpanded="True"
                      Header="{I18N {x:Static r:LangKeys.SnapMarker}}">
                <Grid Margin="12,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="198" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SnapMarkerType}}" />
                    <ComboBox Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadSnapMarkerType}}}"
                              SelectedItem="{Binding SnapMarkerType}" />
                    <TextBlock Grid.Row="1" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SnapMarkerColor}}" />
                    <mah:ColorPicker Grid.Row="1" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                     AddToRecentColorsTrigger="SelectedColorChanged"
                                     SelectedColor="{Binding SnapMarkerColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                    <TextBlock Grid.Row="2" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SnapMarkerLength}}" />
                    <mah:NumericUpDown Grid.Row="2" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="2" Maximum="200" Interval="1"
                                       Value="{Binding SnapMarkerLength}" />
                    <TextBlock Grid.Row="3" Margin="0,0,16,10" VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.SnapMarkerStrokeWidth}}" />
                    <mah:NumericUpDown Grid.Row="3" Grid.Column="1" MinWidth="190" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                       Minimum="0.1" Maximum="10" Interval="0.1"
                                       Value="{Binding SnapMarkerStrokeWidth}" />
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
