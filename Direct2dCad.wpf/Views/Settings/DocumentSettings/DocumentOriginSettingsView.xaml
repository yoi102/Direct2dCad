<UserControl x:Class="Direct2dCad.wpf.Views.Settings.DocumentSettings.DocumentOriginSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:ex="clr-namespace:Direct2dCad.wpf.Extensions"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:vm_en="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions"
             xmlns:settings="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Height="400"
             d:Width="600"
             d:DataContext="{d:DesignInstance Type=settings:DocumentOriginSettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SettingLabel"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,16,10" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style x:Key="SettingInput"
               TargetType="Control">
            <Setter Property="Margin"
                    Value="0,0,0,10" />
            <Setter Property="MinWidth"
                    Value="190" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.OriginDisplayType}}" />
            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      Style="{StaticResource SettingInput}"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadOriginDisplayType}}}"
                      SelectedItem="{Binding OriginDisplayType}" />
            <TextBlock Grid.Row="1"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.OriginMarkerType}}" />
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Style="{StaticResource SettingInput}"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadOriginMarkerType}}}"
                      SelectedItem="{Binding OriginMarkerType}" />
            <TextBlock Grid.Row="2"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.OriginLinePattern}}" />
            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      Style="{StaticResource SettingInput}"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadOriginLinePattern}}}"
                      SelectedItem="{Binding OriginLinePattern}" />
            <TextBlock Grid.Row="3"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.OriginColor}}" />
            <mah:ColorPicker Grid.Row="3"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding OriginColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="4"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.PositionX}}" />
            <mah:NumericUpDown Grid.Row="4"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Interval="1"
                               Value="{Binding OriginX}" />
            <TextBlock Grid.Row="5"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.PositionY}}" />
            <mah:NumericUpDown Grid.Row="5"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Interval="1"
                               Value="{Binding OriginY}" />
            <TextBlock Grid.Row="6"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.OriginSize}}" />
            <mah:NumericUpDown Grid.Row="6"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="1"
                               Value="{Binding OriginSize}" />
            <TextBlock Grid.Row="7"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.OriginStrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="7"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding OriginStrokeWidth}" />
        </Grid>
    </ScrollViewer>
</UserControl>
