<UserControl x:Class="Direct2dCad.wpf.Views.Settings.DocumentGridSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:ex="clr-namespace:Direct2dCad.wpf.Extensions"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:vm_en="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions"
             xmlns:settings="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=settings:DocumentGridSettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SettingLabel"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,16,10" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style x:Key="SettingInput"
               TargetType="Control">
            <Setter Property="Margin"
                    Value="0,0,0,10" />
            <Setter Property="MinWidth"
                    Value="190" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.GridType}}" />
            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      Style="{StaticResource SettingInput}"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadGridType}}}"
                      SelectedItem="{Binding GridType}" />
            <TextBlock Grid.Row="1"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.SpacingX}}" />
            <mah:NumericUpDown Grid.Row="1"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="1"
                               Value="{Binding GridSpacingX}" />
            <TextBlock Grid.Row="2"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.SpacingY}}" />
            <mah:NumericUpDown Grid.Row="2"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="1"
                               Value="{Binding GridSpacingY}" />
            <TextBlock Grid.Row="3"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.Subdivision}}" />
            <mah:NumericUpDown Grid.Row="3"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="1"
                               Interval="1"
                               NumericInputMode="Numbers"
                               Value="{Binding GridSubdivision}" />
            <TextBlock Grid.Row="4"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.MinimumScreenSpacing}}" />
            <mah:NumericUpDown Grid.Row="4"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="1"
                               Value="{Binding GridMinimumScreenSpacing}" />
            <TextBlock Grid.Row="5"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.MinimumWorldSpacing}}" />
            <mah:NumericUpDown Grid.Row="5"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="1"
                               Value="{Binding GridMinimumWorldSpacing}" />
            <TextBlock Grid.Row="6"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.MinorGridColor}}" />
            <mah:ColorPicker Grid.Row="6"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GridMinorLineColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="7"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.MinorGridLineWidth}}" />
            <mah:NumericUpDown Grid.Row="7"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.05"
                               Value="{Binding GridMinorLineWidth}" />
            <TextBlock Grid.Row="8"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.MajorGridColor}}" />
            <mah:ColorPicker Grid.Row="8"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding GridMajorLineColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="9"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.MajorGridLineWidth}}" />
            <mah:NumericUpDown Grid.Row="9"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.05"
                               Value="{Binding GridMajorLineWidth}" />
            <TextBlock Grid.Row="10"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.SnapSpacingX}}" />
            <mah:NumericUpDown Grid.Row="10"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0"
                               Interval="1"
                               Value="{Binding GridSnapSpacingX}" />
            <TextBlock Grid.Row="11"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.SnapSpacingY}}" />
            <mah:NumericUpDown Grid.Row="11"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0"
                               Interval="1"
                               Value="{Binding GridSnapSpacingY}" />
            <TextBlock Grid.Row="12"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.SnapMarkerType}}" />
            <ComboBox Grid.Row="12"
                      Grid.Column="1"
                      Style="{StaticResource SettingInput}"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadSnapMarkerType}}}"
                      SelectedItem="{Binding SnapMarkerType}" />
            <TextBlock Grid.Row="13"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.SnapMarkerColor}}" />
            <mah:ColorPicker Grid.Row="13"
                             Grid.Column="1"
                             Style="{StaticResource SettingInput}"
                             AddToRecentColorsTrigger="SelectedColorChanged"
                             SelectedColor="{Binding SnapMarkerColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
            <TextBlock Grid.Row="14"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.SnapMarkerLength}}" />
            <mah:NumericUpDown Grid.Row="14"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="1"
                               Value="{Binding SnapMarkerLength}" />
            <TextBlock Grid.Row="15"
                       Style="{StaticResource SettingLabel}"
                       Text="{I18N {x:Static r:LangKeys.SnapMarkerStrokeWidth}}" />
            <mah:NumericUpDown Grid.Row="15"
                               Grid.Column="1"
                               Style="{StaticResource SettingInput}"
                               Minimum="0.001"
                               Interval="0.1"
                               Value="{Binding SnapMarkerStrokeWidth}" />
        </Grid>
    </ScrollViewer>
</UserControl>
