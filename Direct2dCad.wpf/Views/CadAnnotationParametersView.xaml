<UserControl x:Class="Direct2dCad.wpf.Views.CadAnnotationParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             AutomationProperties.AutomationId="AnnotationParametersSurface">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool" />
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="GotKeyboardFocus" Handler="ParameterInput_OnGotKeyboardFocus" />
            <EventSetter Event="LostKeyboardFocus" Handler="ParameterInput_OnLostKeyboardFocus" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="12,0,12,8" IsEnabled="{Binding CanEditDimensionParameters, FallbackValue=False}"
                Visibility="{Binding IsDimensionContext, Converter={StaticResource Bool}, FallbackValue=Collapsed}">
        <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionSettings}}"
                   FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionStyle}}" />
        <ComboBox AutomationProperties.AutomationId="DimensionStyleSelector"
                  AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionStyle}}"
                  ItemsSource="{Binding DimensionStyleNames}" SelectedItem="{Binding DimensionStyleName}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{I18N {x:Static r:LangKeys.Unit}}" />
                <ComboBox AutomationProperties.AutomationId="DimensionUnitSelector"
                          AutomationProperties.Name="{I18N {x:Static r:LangKeys.Unit}}"
                          ItemsSource="{Binding DimensionUnitOptions}" SelectedValue="{Binding DimensionUnit}"
                          SelectedValuePath="Unit" DisplayMemberPath="Symbol" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionPrecision}}" />
                <TextBox AutomationProperties.AutomationId="DimensionPrecisionInput"
                         AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionPrecision}}"
                         Text="{Binding DimensionPrecision, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionTextOverride}}" Margin="0,8,0,2" />
        <TextBox AutomationProperties.AutomationId="DimensionTextOverrideInput"
                 AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionTextOverride}}"
                 Text="{Binding DimensionTextOverride, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding DimensionAssociationDisplay}" Margin="0,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Expander Header="{I18N {x:Static r:LangKeys.DimensionTextAndArrows}}" IsExpanded="True" Margin="0,12,0,0"
                  AutomationProperties.AutomationId="DimensionTextAndArrowsSection">
            <StackPanel Margin="8,4,8,8">
                <TextBlock Text="{I18N {x:Static r:LangKeys.ShapeFont}}" />
                <ComboBox AutomationProperties.AutomationId="DimensionShapeFontSelector"
                          AutomationProperties.Name="{I18N {x:Static r:LangKeys.ShapeFont}}"
                          ItemsSource="{Binding DimensionFonts}" DisplayMemberPath="Name"
                          SelectedValuePath="Id.Value" SelectedValue="{Binding DimensionShapeFont}" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionArrowStyle}}" />
                <ComboBox AutomationProperties.AutomationId="DimensionArrowSelector"
                          AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionArrowStyle}}"
                          ItemsSource="{Binding DimensionArrowOptions}" SelectedValue="{Binding DimensionArrow}"
                          SelectedValuePath="Value" DisplayMemberPath="Name" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionTextHeight}}" />
                    <TextBox Grid.Row="1" AutomationProperties.AutomationId="DimensionTextHeightInput"
                             AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionTextHeight}}"
                             Text="{Binding DimensionTextHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Column="2" Text="{I18N {x:Static r:LangKeys.DimensionArrowSize}}" />
                    <TextBox Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="DimensionArrowSizeInput"
                             AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionArrowSize}}"
                             Text="{Binding DimensionArrowSize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Header="{I18N {x:Static r:LangKeys.DimensionDetails}}" Margin="0,8,0,0"
                  AutomationProperties.AutomationId="DimensionDetailsSection">
            <StackPanel Margin="8,4,8,8">
                <TextBlock Text="{I18N {x:Static r:LangKeys.AnnotationScale}}" />
                <TextBox AutomationProperties.AutomationId="DimensionAnnotationScaleInput"
                         AutomationProperties.Name="{I18N {x:Static r:LangKeys.AnnotationScale}}"
                         Text="{Binding DimensionAnnotationScale, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionLineWeight}}" />
                <TextBox AutomationProperties.AutomationId="DimensionLineWeightInput"
                         AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionLineWeight}}"
                         Text="{Binding DimensionLineWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.ExtensionGap}}" />
                <TextBox AutomationProperties.AutomationId="DimensionExtensionGapInput"
                         AutomationProperties.Name="{I18N {x:Static r:LangKeys.ExtensionGap}}"
                         Text="{Binding DimensionExtensionGap, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.ExtensionBeyond}}" />
                <TextBox AutomationProperties.AutomationId="DimensionExtensionBeyondInput"
                         AutomationProperties.Name="{I18N {x:Static r:LangKeys.ExtensionBeyond}}"
                         Text="{Binding DimensionExtensionBeyond, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
            </StackPanel>
        </Expander>
        <TextBlock Text="{Binding StepInputError}" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>
