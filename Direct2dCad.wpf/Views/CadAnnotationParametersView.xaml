<UserControl x:Class="Direct2dCad.wpf.Views.CadAnnotationParametersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" AutomationProperties.AutomationId="AnnotationParametersSurface">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Bool" />
            <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,2" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10" IsEnabled="{Binding CanEditDimensionParameters, FallbackValue=False}" Visibility="{Binding IsDimensionContext, Converter={StaticResource Bool}, FallbackValue=Collapsed}">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{I18N {x:Static r:LangKeys.DimensionSettings}}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionStyle}}" />
        <ComboBox Style="{DynamicResource PropertyChoiceEditor}" AutomationProperties.AutomationId="DimensionStyleSelector" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionStyle}}" ItemsSource="{Binding DimensionStyleNames}" SelectedItem="{Binding DimensionStyleName}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{I18N {x:Static r:LangKeys.Unit}}" />
                <ComboBox Style="{DynamicResource PropertyChoiceEditor}" AutomationProperties.AutomationId="DimensionUnitSelector" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Unit}}" ItemsSource="{Binding DimensionUnitOptions}" SelectedValue="{Binding DimensionUnit}" SelectedValuePath="Unit" DisplayMemberPath="Symbol" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionPrecision}}" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" GotKeyboardFocus="ParameterInput_OnGotKeyboardFocus" LostKeyboardFocus="ParameterInput_OnLostKeyboardFocus" AutomationProperties.AutomationId="DimensionPrecisionInput" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionPrecision}}" Text="{Binding DimensionPrecision, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionTextOverride}}" Margin="0,8,0,2" />
        <TextBox Style="{DynamicResource PropertyTextEditor}" GotKeyboardFocus="ParameterInput_OnGotKeyboardFocus" LostKeyboardFocus="ParameterInput_OnLostKeyboardFocus" AutomationProperties.AutomationId="DimensionTextOverrideInput" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionTextOverride}}" Text="{Binding DimensionTextOverride, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding DimensionAssociationDisplay}" Margin="0,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Expander Style="{DynamicResource PropertySection}" Header="{I18N {x:Static r:LangKeys.DimensionTextAndArrows}}" IsExpanded="False" Margin="0,6,0,0" AutomationProperties.AutomationId="DimensionTextAndArrowsSection">
            <StackPanel Margin="8,4,8,8">
                <TextBlock Text="{I18N {x:Static r:LangKeys.ShapeFont}}" />
                <ComboBox Style="{DynamicResource PropertyChoiceEditor}" AutomationProperties.AutomationId="DimensionShapeFontSelector" AutomationProperties.Name="{I18N {x:Static r:LangKeys.ShapeFont}}" ItemsSource="{Binding DimensionFonts}" DisplayMemberPath="Name" SelectedValuePath="Id.Value" SelectedValue="{Binding DimensionShapeFont}" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionArrowStyle}}" />
                <ComboBox Style="{DynamicResource PropertyChoiceEditor}" AutomationProperties.AutomationId="DimensionArrowSelector" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionArrowStyle}}" ItemsSource="{Binding DimensionArrowOptions}" SelectedValue="{Binding DimensionArrow}" SelectedValuePath="Value" DisplayMemberPath="Name" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionTextHeight}}" />
                    <TextBox Style="{DynamicResource PropertyTextEditor}" GotKeyboardFocus="ParameterInput_OnGotKeyboardFocus" LostKeyboardFocus="ParameterInput_OnLostKeyboardFocus" Grid.Row="1" AutomationProperties.AutomationId="DimensionTextHeightInput" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionTextHeight}}" Text="{Binding DimensionTextHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    <TextBlock Grid.Column="2" Text="{I18N {x:Static r:LangKeys.DimensionArrowSize}}" />
                    <TextBox Style="{DynamicResource PropertyTextEditor}" GotKeyboardFocus="ParameterInput_OnGotKeyboardFocus" LostKeyboardFocus="ParameterInput_OnLostKeyboardFocus" Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="DimensionArrowSizeInput" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionArrowSize}}" Text="{Binding DimensionArrowSize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                </Grid>
            </StackPanel>
        </Expander>
        <Expander Style="{DynamicResource PropertySection}" Header="{I18N {x:Static r:LangKeys.DimensionDetails}}" Margin="0,8,0,0" AutomationProperties.AutomationId="DimensionDetailsSection">
            <StackPanel Margin="8,4,8,8">
                <TextBlock Text="{I18N {x:Static r:LangKeys.AnnotationScale}}" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" GotKeyboardFocus="ParameterInput_OnGotKeyboardFocus" LostKeyboardFocus="ParameterInput_OnLostKeyboardFocus" AutomationProperties.AutomationId="DimensionAnnotationScaleInput" AutomationProperties.Name="{I18N {x:Static r:LangKeys.AnnotationScale}}" Text="{Binding DimensionAnnotationScale, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionLineWeight}}" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" GotKeyboardFocus="ParameterInput_OnGotKeyboardFocus" LostKeyboardFocus="ParameterInput_OnLostKeyboardFocus" AutomationProperties.AutomationId="DimensionLineWeightInput" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DimensionLineWeight}}" Text="{Binding DimensionLineWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.ExtensionGap}}" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" GotKeyboardFocus="ParameterInput_OnGotKeyboardFocus" LostKeyboardFocus="ParameterInput_OnLostKeyboardFocus" AutomationProperties.AutomationId="DimensionExtensionGapInput" AutomationProperties.Name="{I18N {x:Static r:LangKeys.ExtensionGap}}" Text="{Binding DimensionExtensionGap, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.ExtensionBeyond}}" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" GotKeyboardFocus="ParameterInput_OnGotKeyboardFocus" LostKeyboardFocus="ParameterInput_OnLostKeyboardFocus" AutomationProperties.AutomationId="DimensionExtensionBeyondInput" AutomationProperties.Name="{I18N {x:Static r:LangKeys.ExtensionBeyond}}" Text="{Binding DimensionExtensionBeyond, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
            </StackPanel>
        </Expander>
        <TextBlock Text="{Binding StepInputError}" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>