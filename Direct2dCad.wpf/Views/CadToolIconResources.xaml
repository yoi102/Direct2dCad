<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        These templates are shared by the ribbon and the canvas context menu.
        ContentControl.Foreground is inherited from the hosting ToggleButton or
        MenuItem, so the same icon follows both controls' visual states.
    -->
    <Style x:Key="CadIconStrokePath"
           TargetType="Path">
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
        <Setter Property="Fill"
                Value="Transparent" />
    </Style>

    <Style x:Key="CadIconPoint"
           TargetType="Ellipse">
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
    </Style>

