<UserControl x:Class="Direct2dCad.wpf.Views.MainRibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:vm="clr-namespace:Direct2dCad.ViewModels;assembly=Direct2dCad.ViewModels"
             xmlns:vm_en="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Direct2dCad.wpf.Views"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             AutomationProperties.AutomationId="MainRibbon"
             mc:Ignorable="d"
             d:DesignHeight="150"
             d:DesignWidth="1500">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="CadToolIconResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style TargetType="ToggleButton">
                <!--<Style x:Key="LayoutToggleButton"
                         TargetType="ToggleButton">-->
                <Setter Property="Width"
                        Value="26" />
                <Setter Property="Height"
                        Value="22" />
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Margin"
                        Value="1,0" />
                <Setter Property="Padding"
                        Value="4,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource MaterialDesign.Brush.ToolBar.Item.Foreground}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}" />
                                </Trigger>
                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource MaterialDesign.Brush.ToolBar.Item.Foreground}" />

                                    <Setter Property="Foreground"
                                            Value="{DynamicResource MaterialDesign.Brush.SnackBar.Foreground}" />
                                </Trigger>
                                <Trigger Property="IsChecked"
                                         Value="False">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource MaterialDesign.Brush.SnackBar.MouseOver}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                </Style>

                <Style x:Key="RibbonIconButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource MaterialDesignFlatButton}">
                    <Setter Property="Width" Value="33" />
                    <Setter Property="Height" Value="33" />
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue=''}" />
                </Style>

                <Style x:Key="RibbonDropDownButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource MaterialDesignFlatButton}">
                    <Setter Property="Width" Value="80" />
                    <Setter Property="Height" Value="80" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue=''}" />
                    <EventSetter Event="Click" Handler="RibbonDropDownButton_OnClick" />
                    <EventSetter Event="PreviewKeyDown" Handler="RibbonDropDownButton_OnPreviewKeyDown" />
                </Style>

                <Style x:Key="RibbonDropDownMenuStyle"
                       TargetType="ContextMenu"
                       BasedOn="{StaticResource {x:Type ContextMenu}}">
                    <Style.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Height" Value="36" />
                        </Style>
                    </Style.Resources>
                    <Setter Property="DataContext" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="Placement" Value="Bottom" />
                    <Setter Property="VerticalOffset" Value="2" />
                    <Setter Property="MinWidth" Value="220" />
                </Style>

                <Style x:Key="RibbonToolFocusVisual" TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control">
                                <Rectangle Margin="1" RadiusX="3" RadiusY="3" StrokeThickness="1" StrokeDashArray="2,2"
                                           Stroke="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="RibbonToolToggleButtonStyle"
                       TargetType="ToggleButton"
                       BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Width" Value="33" />
                    <Setter Property="Height" Value="33" />
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource RibbonToolFocusVisual}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue=''}" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0 0 10 5"
                    Orientation="Horizontal"
                    Panel.ZIndex="11">

            <!--Toggle Primary Side Bar (Left)-->

            <ToggleButton AutomationProperties.AutomationId="TogglePrimarySideBarButton"
                          ToolTip="{I18N {x:Static r:LangKeys.TogglePrimarySideBar}}"
                          IsChecked="{Binding IsPrimarySideBarOpen, Mode=OneWay}"
                          Command="{Binding TogglePrimarySideBarCommand}">
                <Viewbox Width="20"
                         Height="20">
                    <Canvas Width="20"
                            Height="20">
                        <Rectangle Width="15"
                                   Height="13"
                                   RadiusX="1"
                                   RadiusY="1"
                                   StrokeThickness="1"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Canvas.Left="0.5"
                                   Canvas.Top="1.5" />
                        <Rectangle Width="4.5"
                                   Height="11"
                                   Fill="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Opacity="0.4"
                                   Canvas.Left="1.5"
                                   Canvas.Top="2.5" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>


            <!--Toggle Panel (Bottom)-->

            <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.TogglePanel}}"
                          IsChecked="{Binding IsBottomPanelOpen, Mode=OneWay}"
                          Command="{Binding ToggleBottomPanelCommand}">
                <Viewbox Width="14"
                         Height="14">
                    <Canvas Width="16"
                            Height="16">
                        <Rectangle Width="15"
                                   Height="13"
                                   RadiusX="1"
                                   RadiusY="1"
                                   StrokeThickness="1"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Canvas.Left="0.5"
                                   Canvas.Top="1.5" />
                        <Rectangle Width="13"
                                   Height="4.5"
                                   Fill="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Opacity="0.4"
                                   Canvas.Left="1.5"
                                   Canvas.Top="9" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>


            <!--Toggle Secondary Side Bar (Right)-->

            <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.ToggleSecondarySideBar}}"
                          IsChecked="{Binding IsSecondarySideBarOpen, Mode=OneWay}"
                          Command="{Binding ToggleSecondarySideBarCommand}">
                <Viewbox Width="14"
                         Height="14">
                    <Canvas Width="16"
                            Height="16">
                        <Rectangle Width="15"
                                   Height="13"
                                   RadiusX="1"
                                   RadiusY="1"
                                   StrokeThickness="1"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Canvas.Left="0.5"
                                   Canvas.Top="1.5" />
                        <Rectangle Width="4.5"
                                   Height="11"
                                   Fill="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Opacity="0.4"
                                   Canvas.Left="10"
                                   Canvas.Top="2.5" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>
        </StackPanel>

        <TabControl Style="{StaticResource MahApps.Styles.TabControl}"
                    SelectedIndex="{Binding TabControlSelectedIndex}"
                    TabStripPlacement="Bottom"
                    mah:TabControlHelper.Underlined="TabPanel"
                    mah:TabControlHelper.UnderlinePlacement="Top"
                    mah:HeaderedControlHelper.HeaderFontFamily="Segoe Script"
                    mah:HeaderedControlHelper.HeaderFontSize="18">

            <TabItem Header="{I18N {x:Static r:LangKeys.File}}"
                     AutomationProperties.AutomationId="FileRibbonTab"
                     Style="{StaticResource MahApps.Styles.TabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal" Margin="10,2">

                    <Button ToolTip="{I18N {x:Static r:LangKeys.ApplicationSettings}}"
                            AutomationProperties.AutomationId="UserSettingsButton"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="80"
                            Height="80"
                            Padding="0"
                            Command="{Binding OpenUserSettingsDialogCommand}">
                        <Grid RowDefinitions="* auto">

                            <md:PackIcon Kind="AccountCog"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="50"
                                         Height="50" />
                            <TextBlock Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       Text="{I18N {x:Static r:LangKeys.Settings}}" />


                        </Grid>
                    </Button>


                    <Button ToolTip="{I18N {x:Static r:LangKeys.New}}"
                            AutomationProperties.AutomationId="NewDocumentButton"
                            Style="{StaticResource RibbonDropDownButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource RibbonDropDownMenuStyle}"
                                         AutomationProperties.AutomationId="NewDocumentMenu">
                                <MenuItem Header="{I18N {x:Static r:LangKeys.BlankDrawing}}"
                                          Icon="{md:PackIcon Kind=FilePlus, Size=22}"
                                          Command="{Binding NewCommand}"
                                          AutomationProperties.AutomationId="NewBlankDocumentMenuItem" />
                                <Separator />
                                <MenuItem Header="A4 · mm · 1:1"
                                          Command="{Binding NewTemplateCommand}" CommandParameter="A4"
                                          AutomationProperties.AutomationId="NewA4TemplateButton">
                                    <MenuItem.Icon>
                                        <ContentControl Width="24" Height="24" ContentTemplate="{StaticResource CadA4TemplateIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="A3 · mm · 1:100"
                                          Command="{Binding NewTemplateCommand}" CommandParameter="A3-100"
                                          AutomationProperties.AutomationId="NewA3TemplateButton">
                                    <MenuItem.Icon>
                                        <ContentControl Width="24" Height="24" ContentTemplate="{StaticResource CadA3TemplateIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Letter · in · 1:1"
                                          Command="{Binding NewTemplateCommand}" CommandParameter="Letter"
                                          AutomationProperties.AutomationId="NewLetterTemplateButton">
                                    <MenuItem.Icon>
                                        <ContentControl Width="24" Height="24" ContentTemplate="{StaticResource CadLetterTemplateIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid RowDefinitions="* auto">

                            <md:PackIcon Kind="FilePlus"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="50"
                                         Height="50" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.New}}" />
                                <md:PackIcon Kind="MenuDown" Width="14" Height="14" Margin="2,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                        </Grid>
                    </Button>

                    <Button ToolTip="{I18N {x:Static r:LangKeys.OpenFile}}"
                            AutomationProperties.AutomationId="OpenDocumentButton"
                            Style="{StaticResource RibbonDropDownButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource RibbonDropDownMenuStyle}"
                                         AutomationProperties.AutomationId="OpenDocumentMenu">
                                <MenuItem Header="{I18N {x:Static r:LangKeys.OpenFile}}"
                                          Icon="{md:PackIcon Kind=FolderOpen, Size=22}"
                                          Command="{Binding OpenFileCommand}"
                                          AutomationProperties.AutomationId="OpenNativeDocumentMenuItem" />
                                <MenuItem Header="{I18N {x:Static r:LangKeys.ImportDxf}}"
                                          Icon="{md:PackIcon Kind=FileImportOutline, Size=22}"
                                          Command="{Binding ImportDxfCommand}"
                                          AutomationProperties.AutomationId="ImportDxfButton" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid RowDefinitions="* auto">

                            <md:PackIcon Kind="FolderOpen"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="50"
                                         Height="50" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.OpenFile}}" />
                                <md:PackIcon Kind="MenuDown" Width="14" Height="14" Margin="2,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                        </Grid>
                    </Button>
                    <Button ToolTip="{I18N {x:Static r:LangKeys.Save}}"
                            AutomationProperties.AutomationId="SaveDocumentButton"
                            Style="{StaticResource RibbonDropDownButtonStyle}"
                            Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource RibbonDropDownMenuStyle}"
                                         AutomationProperties.AutomationId="SaveDocumentMenu">
                                <MenuItem Header="{I18N {x:Static r:LangKeys.Save}}"
                                          Icon="{md:PackIcon Kind=ContentSave, Size=22}"
                                          Command="{Binding CurrentEditorTabViewModel.SaveFileCommand}"
                                          AutomationProperties.AutomationId="SaveDocumentMenuItem" />
                                <MenuItem Header="{I18N {x:Static r:LangKeys.SaveAs}}"
                                          Icon="{md:PackIcon Kind=ContentSaveAdd, Size=22}"
                                          Command="{Binding CurrentEditorTabViewModel.SaveAsFileCommand}"
                                          AutomationProperties.AutomationId="SaveAsDocumentMenuItem" />
                                <Separator />
                                <MenuItem Header="{I18N {x:Static r:LangKeys.SaveCompressedCopy}}"
                                          Icon="{md:PackIcon Kind=FolderZipOutline, Size=22}"
                                          Command="{Binding CurrentEditorTabViewModel.SaveCompressedCopyCommand}"
                                          AutomationProperties.AutomationId="SaveCompressedCopyButton" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid RowDefinitions="* auto"
                              Margin="0">
                            <md:PackIcon Kind="ContentSave"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="50"
                                         Height="50" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Save}}" />
                                <md:PackIcon Kind="MenuDown" Width="14" Height="14" Margin="2,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Width="80"
                            Height="80"
                            Padding="0"
                            ToolTip="{I18N {x:Static r:LangKeys.ExportDxf}}"
                            AutomationProperties.Name="{I18N {x:Static r:LangKeys.ExportDxf}}"
                            Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}"
                            Command="{Binding CurrentEditorTabViewModel.ExportDxfCommand}"
                            AutomationProperties.AutomationId="ExportDxfButton">
                        <Grid RowDefinitions="* auto">
                            <md:PackIcon Kind="FileExportOutline"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="50"
                                         Height="50" />
                            <TextBlock Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       Text="{I18N {x:Static r:LangKeys.ExportDxf}}" />
                        </Grid>
                    </Button>
                    <Button ToolTip="{I18N {x:Static r:LangKeys.Print}}"
                            AutomationProperties.AutomationId="PrintDocumentButton"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="80"
                            Height="80"
                            Padding="0"
                            Visibility="{Binding IsPrintAvailable, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}"
                            Command="{Binding CurrentEditorTabViewModel.PrintCommand}">
                        <Grid RowDefinitions="* auto">
                            <md:PackIcon Kind="Printer"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="50"
                                         Height="50" />
                            <TextBlock Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       Text="{I18N {x:Static r:LangKeys.Print}}" />
                        </Grid>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{I18N {x:Static r:LangKeys.Draw}}"
                     AutomationProperties.AutomationId="DrawRibbonTab"
                     Style="{StaticResource MahApps.Styles.TabItem}"
                     Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}">
                <ScrollViewer AutomationProperties.AutomationId="DrawRibbonScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal" Margin="10,2">

                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.Select}}"
                                  AutomationProperties.AutomationId="SelectToolButton"
                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.Select}}"
                                  Width="80"
                                  Height="80"
                                  Padding="0"
                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                  CommandParameter="Select">
                        <Grid RowDefinitions="* auto">

                            <md:PackIcon Kind="ArrowAll"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="50"
                                         Height="50" />
                            <TextBlock Grid.Row="1"
                                       HorizontalAlignment="Center"
                                       Text="{I18N {x:Static r:LangKeys.Select}}" />

                        </Grid>
                    </ToggleButton>

                    <Border Width="1"
                            Margin="15,0"
                            Background="#616161"
                            Opacity="0.4" />

                    <WrapPanel Width="80">
                        <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.CircleCenterRadius}}"
                                      AutomationProperties.AutomationId="CircleCenterRadiusToolButton"
                                      AutomationProperties.Name="{I18N {x:Static r:LangKeys.CircleCenterRadius}}"
                                      IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.CircleCenterRadius}}"
                                      Width="33"
                                      Height="33"
                                      Margin="0"
                                      Padding="0"
                                      Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                      CommandParameter="CircleCenterRadius">
                            <Viewbox Width="33"
                                     Height="33"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stretch="Uniform">
                                <Canvas Width="512"
                                        Height="512">

                                    <Ellipse Width="300"
                                             Height="300"
                                             Canvas.Left="106"
                                             Canvas.Top="106"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="38"
                                             Fill="Transparent"
                                             d:Stroke="#616161" />

                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="32"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          d:Stroke="#616161"
                                          Data="M 256,256 L 350,180" />

                                    <Ellipse Width="40"
                                             Height="40"
                                             Canvas.Left="236"
                                             Canvas.Top="236"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             d:Fill="#616161" />

                                </Canvas>
                            </Viewbox>
                        </ToggleButton>

                        <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.CircleCenterDiameter}}"
                                      AutomationProperties.AutomationId="CircleCenterDiameterToolButton"
                                      AutomationProperties.Name="{I18N {x:Static r:LangKeys.CircleCenterDiameter}}"
                                      IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.CircleCenterDiameter}}"
                                      Width="33"
                                      Height="33"
                                      Margin="3"
                                      Padding="0"
                                      Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                      CommandParameter="CircleCenterDiameter">
                            <Viewbox Width="33"
                                     Height="33"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stretch="Uniform">
                                <Canvas Width="512"
                                        Height="512">

                                    <Ellipse Width="300"
                                             Height="300"
                                             Canvas.Left="106"
                                             Canvas.Top="106"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="38"
                                             Fill="Transparent"
                                             d:Stroke="#616161" />

                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          d:Stroke="#616161"
                                          Data="M 160,320 L 352,192" />

                                    <Ellipse Width="40"
                                             Height="40"
                                             Canvas.Left="236"
                                             Canvas.Top="236"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             d:Fill="#616161" />

                                </Canvas>
                            </Viewbox>
                        </ToggleButton>
                        <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.CircleTwoPoint}}"
                                      IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.CircleTwoPoint}}"
                                      Width="33"
                                      Height="33"
                                      Margin="3"
                                      Padding="0"
                                      Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                      CommandParameter="CircleTwoPoint">
                            <Viewbox Width="33"
                                     Height="33"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stretch="Uniform">
                                <Canvas Width="512"
                                        Height="512">
                                    <!-- 圆 -->
                                    <Ellipse Width="300"
                                             Height="300"
                                             Canvas.Left="106"
                                             Canvas.Top="106"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="22"
                                             Fill="Transparent"
                                             d:Stroke="#616161" />



                                    <!-- 点1 -->
                                    <Ellipse Width="44"
                                             Height="44"
                                             Canvas.Left="128"
                                             Canvas.Top="308"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             d:Fill="#616161" />

                                    <!-- 点2 -->
                                    <Ellipse Width="44"
                                             Height="44"
                                             Canvas.Left="340"
                                             Canvas.Top="160"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             d:Fill="#616161" />

                                </Canvas>
                            </Viewbox>
                        </ToggleButton>
                        <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.CircleThreePoint}}"
                                      IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.CircleThreePoint}}"
                                      Width="33"
                                      Height="33"
                                      Margin="3"
                                      Padding="0"
                                      Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                      CommandParameter="CircleThreePoint">
                            <Viewbox Width="33"
                                     Height="33"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stretch="Uniform">
                                <Canvas Width="512"
                                        Height="512">

                                    <!-- 圆 -->
                                    <Ellipse Width="300"
                                             Height="300"
                                             Canvas.Left="106"
                                             Canvas.Top="106"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="22"
                                             Fill="Transparent"
                                             d:Stroke="#616161" />


                                    <!-- 三个点 -->
                                    <Ellipse Width="44"
                                             Height="44"
                                             Canvas.Left="108"
                                             Canvas.Top="292"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             d:Fill="#616161" />

                                    <Ellipse Width="44"
                                             Height="44"
                                             Canvas.Left="234"
                                             Canvas.Top="94"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             d:Fill="#616161" />

                                    <Ellipse Width="44"
                                             Height="44"
                                             Canvas.Left="360"
                                             Canvas.Top="292"
