<UserControl x:Class="Direct2dCad.wpf.Views.CadEditParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             AutomationProperties.AutomationId="EditParametersSurface">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool" />
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="IsEnabled" Value="{Binding CanEditDocument, FallbackValue=False}" />
            <Setter Property="Visibility" Value="{Binding IsCurveEditTool, Converter={StaticResource Bool}, FallbackValue=Collapsed}" />
        </Style>
    </UserControl.Style>
    <Border Padding="8,6" CornerRadius="4" MaxWidth="360"
            Background="{DynamicResource MaterialDesign.Brush.Background}">
        <StackPanel>
            <WrapPanel>
                <TextBlock Text="{Binding CurrentToolNameDisplay}" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding EditKeyboardHint}" />
                <ToggleButton AutomationProperties.AutomationId="EditWholePolylineToggle" IsChecked="{Binding EditWholePolyline}"
                              Margin="0,0,6,0" Width="22" Height="22"
                              Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                              ToolTip="{I18N {x:Static r:LangKeys.EditWholePolyline}}" Click="Action_OnClick"
                              AutomationProperties.Name="{I18N {x:Static r:LangKeys.EditWholePolyline}}"
                              Visibility="{Binding HasCornerParameters, Converter={StaticResource Bool}}">
                    <md:PackIcon Kind="VectorPolyline" Width="16" Height="16" />
                </ToggleButton>
                <ToggleButton AutomationProperties.AutomationId="EditTrimCornerToggle" IsChecked="{Binding TrimCornerLines}"
                              IsEnabled="{Binding CanChangeCornerTrim}"
                              Margin="0,0,6,0"
                              Width="22" Height="22"
                              Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                              ToolTip="{I18N {x:Static r:LangKeys.TrimCornerLines}}" Click="Action_OnClick"
                              AutomationProperties.Name="{I18N {x:Static r:LangKeys.TrimCornerLines}}"
                              Visibility="{Binding HasCornerParameters, Converter={StaticResource Bool}}">
                    <md:PackIcon Kind="ContentCut" Width="16" Height="16" />
                </ToggleButton>
            </WrapPanel>
            <TextBlock AutomationProperties.AutomationId="EditStepPrompt" Text="{Binding EditInstruction}"
                       Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
            <TextBlock AutomationProperties.AutomationId="EditFeedback" Text="{Binding EditFeedback}" ToolTip="{Binding EditErrorDetail}"
                       TextWrapping="Wrap" FontSize="11" Foreground="#F07178">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
