<UserControl x:Class="Direct2dCad.wpf.Views.Dialogs.AiAssistantSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:ai="clr-namespace:Direct2dCad.AI;assembly=Direct2dCad.AI"
             xmlns:svc="clr-namespace:Direct2dCad.ViewModels.Services.Platform;assembly=Direct2dCad.ViewModels.Services"
             xmlns:settings="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels"
             d:DataContext="{d:DesignInstance Type=settings:AiAssistantSettingsDialogViewModel}"
             mc:Ignorable="d"
             MinWidth="500"
             MaxWidth="620">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,18"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{I18N {x:Static r:LangKeys.AiSettings}}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="138" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,14,12"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:LangKeys.AiProvider}}" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding ProviderOptions}"
                      SelectedItem="{Binding Provider, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="LM Studio" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}"
                                                     Value="{x:Static ai:AiAssistantProvider.Codex}">
                                            <Setter Property="Text" Value="Codex" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2"
              Visibility="{Binding IsLmStudio, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="138" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,14,12"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:LangKeys.Endpoint}}" />
            <TextBox Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="0,0,0,12"
                     Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1"
                       Margin="0,0,14,12"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:LangKeys.Model}}" />
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,6,12"
                      IsEditable="True"
                      ItemsSource="{Binding LmStudioModels}"
                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                      Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Margin="0,0,0,12"
                    Padding="0"
                    Command="{Binding RefreshModelsCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="{I18N {x:Static r:LangKeys.RefreshModels}}">
                <md:PackIcon Width="17" Height="17" Kind="Refresh" />
            </Button>

            <Expander Grid.Row="2"
                      Grid.ColumnSpan="3"
                      Margin="0,2,0,8"
                      Header="{I18N {x:Static r:LangKeys.Advanced}}">
                <Grid Margin="10,10,2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,10,12"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.Temperature}}" />
                    <Slider Grid.Column="1"
                            Margin="0,0,8,12"
                            Minimum="0"
                            Maximum="2"
                            IsSnapToTickEnabled="True"
                            TickFrequency="0.1"
                            Value="{Binding Temperature, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2"
                               Margin="0,0,0,12"
                               Text="{Binding Temperature, StringFormat=F1}"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Text="{I18N {x:Static r:LangKeys.ContextWindowTokens}}" />
                    <mah:NumericUpDown Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Minimum="4096"
                                       Maximum="262144"
                                       Interval="4096"
                                       Value="{Binding ContextWindowTokens, Mode=TwoWay}" />
                </Grid>
            </Expander>
        </Grid>

        <Grid Grid.Row="2"
              Visibility="{Binding IsCodex, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="138" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,14,12"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:LangKeys.CodexExecutable}}" />
            <TextBox Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="0,0,0,12"
                     Text="{Binding CodexExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1"
                       Margin="0,0,14,12"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:LangKeys.Model}}" />
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,6,12"
                      IsEditable="True"
                      ItemsSource="{Binding CodexModels}"
                      SelectedItem="{Binding SelectedCodexModel, Mode=TwoWay}"
                      Text="{Binding SelectedCodexModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Margin="0,0,0,12"
                    Padding="0"
                    Command="{Binding RefreshModelsCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="{I18N {x:Static r:LangKeys.RefreshModels}}">
                <md:PackIcon Width="17" Height="17" Kind="Refresh" />
            </Button>

            <TextBlock Grid.Row="2"
                       Margin="0,0,14,12"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:LangKeys.ReasoningEffort}}" />
            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding ReasoningEffortOptions}"
                      SelectedItem="{Binding CodexReasoningEffort, Mode=TwoWay}" />

            <TextBlock Grid.Row="3"
                       Margin="0,0,14,8"
                       VerticalAlignment="Center"
                       Text="{I18N {x:Static r:LangKeys.ServiceTier}}" />
            <ComboBox Grid.Row="3"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding ServiceTierOptions}"
                      SelectedItem="{Binding CodexServiceTier, Mode=TwoWay}" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,6,0,4">
            <CheckBox Content="{I18N {x:Static r:LangKeys.EnableCadAiTools}}"
                      IsChecked="{Binding EnableCadTools, Mode=TwoWay}" />
            <ProgressBar Height="2"
                         Margin="0,10,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                       Text="{Binding ConnectionStatus}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasConnectionStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="82"
                    Margin="0,0,8,0"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static svc:AiAssistantSettingsDialogAction.Confirm}"
                    Content="{I18N {x:Static r:LangKeys.Ok}}"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}" />
            <Button MinWidth="82"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static svc:AiAssistantSettingsDialogAction.Cancel}"
                    Content="{I18N {x:Static r:LangKeys.Cancel}}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</UserControl>
