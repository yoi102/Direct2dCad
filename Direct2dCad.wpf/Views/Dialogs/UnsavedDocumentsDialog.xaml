<UserControl x:Class="Direct2dCad.wpf.Views.Dialogs.UnsavedDocumentsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:svc="clr-namespace:Direct2dCad.ViewModels.Services.Platform;assembly=Direct2dCad.ViewModels.Services"
             Width="520">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <md:PackIcon Width="26"
                         Height="26"
                         Margin="0,0,12,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                         Kind="ContentSave" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{I18N {x:Static r:LangKeys.UnsavedDocumentsTitle}}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="38,16,0,10"
                   Text="{I18N {x:Static r:LangKeys.UnsavedDocumentsMessage}}"
                   TextWrapping="Wrap" />

        <ListBox x:Name="DocumentsList"
                 Grid.Row="2"
                 MinHeight="90"
                 MaxHeight="280"
                 Margin="38,0,0,24"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="48"
                          Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Width="18"
                                     Height="18"
                                     VerticalAlignment="Center"
                                     Kind="FileDocument" />
                        <StackPanel Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Opacity="0.65"
                                       Text="{Binding Location}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static svc:UnsavedDocumentDialogResult.Save}"
                    Content="{I18N {x:Static r:LangKeys.SaveAll}}"
                    IsDefault="True"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button Margin="0,0,8,0"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static svc:UnsavedDocumentDialogResult.Discard}"
                    Content="{I18N {x:Static r:LangKeys.DontSave}}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static svc:UnsavedDocumentDialogResult.Cancel}"
                    Content="{I18N {x:Static r:LangKeys.Cancel}}"
                    IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}" />
        </StackPanel>
    </Grid>
</UserControl>
