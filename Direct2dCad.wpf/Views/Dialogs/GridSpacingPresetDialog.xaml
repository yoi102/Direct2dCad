<UserControl x:Class="Direct2dCad.wpf.Views.Dialogs.GridSpacingPresetDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:svc="clr-namespace:Direct2dCad.ViewModels.Services.Platform;assembly=Direct2dCad.ViewModels.Services"
             MinWidth="380"
             MaxWidth="460">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3"
                   Margin="0,0,0,18"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{Binding Title}" />

        <TextBlock Grid.Row="1"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="{I18N {x:Static r:LangKeys.Name}}" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Margin="0,0,0,12"
                 MaxLength="80"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="X" />
        <mah:NumericUpDown Grid.Row="2"
                           Grid.Column="1"
                           Margin="0,0,8,12"
                           Minimum="0.001"
                           Maximum="100000"
                           Interval="0.1"
                           Speedup="True"
                           Value="{Binding SpacingX}" />
        <TextBlock Grid.Row="2"
                   Grid.Column="2"
                   Margin="0,0,0,12"
                   VerticalAlignment="Center"
                   Text="mm" />

        <CheckBox Grid.Row="3"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,12"
                  Content="{I18N {x:Static r:LangKeys.LinkGridAxes}}"
                  IsChecked="{Binding LinkAxes}" />

        <TextBlock Grid.Row="4"
                   Margin="0,0,12,8"
                   VerticalAlignment="Center"
                   Text="Y" />
        <mah:NumericUpDown Grid.Row="4"
                           Grid.Column="1"
                           Margin="0,0,8,8"
                           Minimum="0.001"
                           Maximum="100000"
                           Interval="0.1"
                           IsReadOnly="{Binding LinkAxes}"
                           Speedup="True"
                           Value="{Binding SpacingY}" />
        <TextBlock Grid.Row="4"
                   Grid.Column="2"
                   Margin="0,0,0,8"
                   VerticalAlignment="Center"
                   Text="mm" />

        <Grid Grid.Row="5" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock Margin="0,4,190,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       Text="{Binding ValidationError}"
                       TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="82"
                        Margin="0,0,8,0"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static svc:GridSpacingPresetDialogAction.Confirm}"
                        Content="{I18N {x:Static r:LangKeys.Ok}}"
                        IsDefault="True"
                        IsEnabled="{Binding IsValid}" />
                <Button MinWidth="82"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static svc:GridSpacingPresetDialogAction.Cancel}"
                        Content="{I18N {x:Static r:LangKeys.Cancel}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
