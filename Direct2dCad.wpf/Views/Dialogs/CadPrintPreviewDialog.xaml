<mah:MetroWindow x:Class="Direct2dCad.wpf.Views.Dialogs.CadPrintPreviewDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:printing="clr-namespace:System.Printing;assembly=ReachFramework"
                 xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
                 Width="1100"
                 Height="780"
                 MinWidth="820"
                 MinHeight="580"
                 AutomationProperties.AutomationId="PrintPreviewDialog"
                 Background="{DynamicResource MaterialDesign.Brush.Background}"
                 ShowInTaskbar="False"
                 Title="{I18N {x:Static r:LangKeys.PrintPreview}}"
                 TitleCharacterCasing="Normal"
                 WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,2,14">
            <TextBlock x:Name="DocumentNameText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,5,0,0"
                       Opacity="0.72"
                       Text="{I18N {x:Static r:LangKeys.PrintPreviewDescription}}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="18"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Foreground}"
                    BorderThickness="1"
                    CornerRadius="3">
                <StackPanel>
                    <TextBlock Margin="0,0,0,18"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="{I18N {x:Static r:LangKeys.PrinterSettings}}" />

                    <TextBlock Margin="0,0,0,5"
                               Text="{I18N {x:Static r:LangKeys.Printer}}" />
                    <ComboBox x:Name="PrinterCombo"
                              MinHeight="32"
                              Margin="0,0,0,16"
                              AutomationProperties.AutomationId="PrintPreviewPrinterCombo"
                              SelectionChanged="PrinterCombo_SelectionChanged" />

                    <TextBlock Margin="0,0,0,5"
                               Text="{I18N {x:Static r:LangKeys.PaperSize}}" />
                    <ComboBox x:Name="PaperSizeCombo"
                              MinHeight="32"
                              Margin="0,0,0,16"
                              AutomationProperties.AutomationId="PrintPreviewPaperSizeCombo"
                              SelectionChanged="PaperSizeCombo_SelectionChanged" />

                    <TextBlock Margin="0,0,0,5"
                               Text="{I18N {x:Static r:LangKeys.Orientation}}" />
                    <ComboBox x:Name="OrientationCombo"
                              MinHeight="32"
                              Margin="0,0,0,16"
                              AutomationProperties.AutomationId="PrintPreviewOrientationCombo"
                              SelectedValuePath="Tag"
                              SelectionChanged="OrientationCombo_SelectionChanged">
                        <ComboBoxItem Content="{I18N {x:Static r:LangKeys.Portrait}}"
                                      Tag="{x:Static printing:PageOrientation.Portrait}" />
                        <ComboBoxItem Content="{I18N {x:Static r:LangKeys.Landscape}}"
                                      Tag="{x:Static printing:PageOrientation.Landscape}" />
                    </ComboBox>

                    <TextBlock Margin="0,0,0,5"
                               Text="{I18N {x:Static r:LangKeys.Copies}}" />
                    <mah:NumericUpDown x:Name="CopiesInput"
                                       MinHeight="32"
                                       Minimum="1"
                                       Maximum="999"
                                       Interval="1"
                                       Value="1"
                                       AutomationProperties.AutomationId="PrintPreviewCopiesInput" />

                    <TextBlock Margin="0,0,0,5"
                               Text="{I18N {x:Static r:LangKeys.PrintResolution}}" />
                    <mah:NumericUpDown x:Name="DpiInput"
                                       MinHeight="32"
                                       Minimum="72"
                                       Maximum="1200"
                                       Interval="50"
                                       StringFormat="F0"
                                       Value="300"
                                       AutomationProperties.AutomationId="PrintPreviewDpiInput" />

                    <TextBlock Margin="0,20,0,0"
                               Opacity="0.68"
                               Text="{I18N {x:Static r:LangKeys.PrintPreviewPrinterNote}}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="24"
                    Background="#FF25272B"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Foreground}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Viewbox Stretch="Uniform">
                    <Border x:Name="PreviewPageBorder"
                            Width="600"
                            Height="424"
                            Padding="6"
                            Background="White"
                            BorderBrush="#FF9A9A9A"
                            BorderThickness="1">
                        <Image x:Name="PreviewImage"
                               AutomationProperties.AutomationId="PrintPreviewImage"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               Stretch="Uniform" />
                    </Border>
                </Viewbox>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="88"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="CancelPrintPreviewButton"
                    Click="Cancel_Click"
                    Content="{I18N {x:Static r:LangKeys.Cancel}}"
                    IsCancel="True" />
            <Button MinWidth="112"
                    AutomationProperties.AutomationId="PrintFromPreviewButton"
                    Click="Print_Click"
                    Content="{I18N {x:Static r:LangKeys.Print}}"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
