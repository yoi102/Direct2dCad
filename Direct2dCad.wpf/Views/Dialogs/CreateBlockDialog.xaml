<UserControl x:Class="Direct2dCad.wpf.Views.Dialogs.CreateBlockDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:svc="clr-namespace:Direct2dCad.ViewModels.Services.Platform;assembly=Direct2dCad.ViewModels.Services"
             xmlns:blocks="clr-namespace:Direct2dCad.ViewModels.Blocks;assembly=Direct2dCad.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=blocks:CreateBlockDialogViewModel}"
             mc:Ignorable="d"
             MinWidth="420"
             MaxWidth="520">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="126" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   Margin="0,0,0,18"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{Binding Title}" />

        <TextBlock Grid.Row="1"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="{I18N {x:Static r:LangKeys.Name}}" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 MaxLength="80"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="{I18N {x:Static r:LangKeys.SelectedEntities}}" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Margin="0,0,0,12"
                   VerticalAlignment="Center"
                   Text="{Binding SelectedEntityCount}" />

        <TextBlock Grid.Row="3"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="{I18N {x:Static r:LangKeys.BasePoint}}" />
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="X" />
            <mah:NumericUpDown Grid.Column="1"
                               Speedup="True"
                               StringFormat="F3"
                               Value="{Binding BasePointX}" />
            <TextBlock Grid.Column="2"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="Y" />
            <mah:NumericUpDown Grid.Column="3"
                               Speedup="True"
                               StringFormat="F3"
                               Value="{Binding BasePointY}" />
        </Grid>

        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <TextBlock Margin="0,4,190,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                       Text="{Binding ValidationError}"
                       TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="82"
                        Margin="0,0,8,0"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static svc:CreateBlockDialogAction.Confirm}"
                        Content="{I18N {x:Static r:LangKeys.Ok}}"
                        IsDefault="True"
                        IsEnabled="{Binding IsValid}" />
                <Button MinWidth="82"
                        IsCancel="True"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static svc:CreateBlockDialogAction.Cancel}"
                        Content="{I18N {x:Static r:LangKeys.Cancel}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
