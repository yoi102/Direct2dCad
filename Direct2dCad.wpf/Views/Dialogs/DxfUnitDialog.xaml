<mah:MetroWindow x:Class="Direct2dCad.wpf.Views.Dialogs.DxfUnitDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
 Title="{I18N {x:Static r:LangKeys.DxfSourceUnit}}" Width="440" Height="250" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" TitleCharacterCasing="Normal">
 <StackPanel Margin="22"><TextBlock Text="{I18N {x:Static r:LangKeys.DxfUnitDescription}}" TextWrapping="Wrap" Margin="0,0,0,16"/>
 <ComboBox x:Name="UnitCombo" ItemsSource="{Binding Units}" SelectedValuePath="Unit" DisplayMemberPath="Symbol" SelectedIndex="-1" AutomationProperties.AutomationId="DxfSourceUnitCombo"/>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
  <Button Content="{I18N {x:Static r:LangKeys.Cancel}}" IsCancel="True" Margin="0,0,8,0"/>
  <Button Content="{I18N {x:Static r:LangKeys.OpenFile}}" Click="Confirm" IsDefault="True"/>
 </StackPanel></StackPanel>
</mah:MetroWindow>
