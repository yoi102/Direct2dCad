<UserControl x:Class="Direct2dCad.wpf.Views.Dialogs.UnsavedDocumentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:svc="clr-namespace:Direct2dCad.ViewModels.Services.Platform;assembly=Direct2dCad.ViewModels.Services"
             Width="440">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <md:PackIcon Width="26"
                         Height="26"
                         Margin="0,0,12,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                         Kind="ContentSave" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{I18N {x:Static r:LangKeys.UnsavedDocumentTitle}}" />
        </StackPanel>

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="1"
                   Margin="38,18,0,24"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static svc:UnsavedDocumentDialogResult.Save}"
                    Content="{I18N {x:Static r:LangKeys.Save}}"
                    IsDefault="True"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button Margin="0,0,8,0"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static svc:UnsavedDocumentDialogResult.Discard}"
                    Content="{I18N {x:Static r:LangKeys.DontSave}}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static svc:UnsavedDocumentDialogResult.Cancel}"
                    Content="{I18N {x:Static r:LangKeys.Cancel}}"
                    IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}" />
        </StackPanel>
    </Grid>
</UserControl>
