<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.DrawingRecoveryToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             AutomationProperties.AutomationId="DrawingAssistantToolbox"
             MinWidth="210">
    <UserControl.Resources>
        <Style x:Key="RecoveryEntryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverLayer" Background="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    CornerRadius="4" Opacity="0" IsHitTestVisible="False" />
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid DataContext="{Binding Workspace}" Margin="8,6,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button AutomationProperties.AutomationId="ClearAllRecoveryButton"
                AutomationProperties.Name="{I18N {x:Static r:LangKeys.ClearAllRecovery}}"
                Style="{StaticResource RecoveryEntryButton}" HorizontalAlignment="Right" Padding="6,4" Margin="0,0,0,5"
                ToolTip="{I18N {x:Static r:LangKeys.ClearAllRecovery}}" Command="{Binding ClearAllRecoveryCommand}"
                Visibility="{Binding HasRecoveryEntries, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                <md:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="{I18N {x:Static r:LangKeys.ClearAllRecovery}}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <ScrollViewer Grid.Row="1" AutomationProperties.AutomationId="RecoveryEntriesScrollViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ListBox AutomationProperties.AutomationId="RecoveryEntriesList" ItemsSource="{Binding RecoveryEntries}"
                     Background="Transparent" BorderThickness="0" Padding="0" KeyboardNavigation.TabNavigation="Continue">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ToolboxListItem}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
                        <Setter Property="AutomationProperties.AutomationId" Value="RecoveryEntryItem" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        <EventSetter Event="PreviewMouseDown" Handler="RecoveryEntryPreviewMouseDown" />
                        <EventSetter Event="GotKeyboardFocus" Handler="RecoveryEntryGotKeyboardFocus" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent"
                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem AutomationProperties.AutomationId="OpenRecoveryCopyMenuItem"
                                              Header="{I18N {x:Static r:LangKeys.OpenRecoveryCopy}}"
                                              Command="{Binding PlacementTarget.Tag.OpenRecoveryCopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon><md:PackIcon Kind="OpenInApp" Width="16" Height="16" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem AutomationProperties.AutomationId="OpenRecoveryFolderMenuItem"
                                              Header="{I18N {x:Static r:LangKeys.OpenContainingFolder}}"
                                              Command="{Binding PlacementTarget.Tag.OpenRecoveryFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon><md:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem AutomationProperties.AutomationId="OpenRecoverySourceFolderMenuItem"
                                              Header="{I18N {x:Static r:LangKeys.OpenSourceFolder}}"
                                              Command="{Binding PlacementTarget.Tag.OpenFileFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding SourcePath}" />
                                    <Separator />
                                    <MenuItem AutomationProperties.AutomationId="ClearRecoveryEntryMenuItem"
                                              Header="{I18N {x:Static r:LangKeys.ClearRecoveryEntry}}"
                                              Command="{Binding PlacementTarget.Tag.ClearRecoveryEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon><md:PackIcon Kind="Close" Width="16" Height="16" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem AutomationProperties.AutomationId="ClearAllRecoveryMenuItem"
                                              Header="{I18N {x:Static r:LangKeys.ClearAllRecovery}}"
                                              Command="{Binding PlacementTarget.Tag.ClearAllRecoveryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="14,8,0,8" Background="Transparent">
                                <Grid.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding SourcePath}" />
                                        <TextBlock Text="{I18N {x:Static r:LangKeys.OpenRecoveryCopy}}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid.ToolTip>
                                <Grid IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="FileRestoreOutline" Width="16" Height="16" Margin="0,0,6,0"
                                                 VerticalAlignment="Center" Opacity="0.7" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LocalSavedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="11" Opacity="0.6" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <Button Grid.Column="1" AutomationProperties.AutomationId="OpenRecoveryEntryIconButton"
                                    AutomationProperties.Name="{I18N {x:Static r:LangKeys.OpenRecoveryCopy}}"
                                    Style="{StaticResource RecoveryEntryButton}" Padding="5" Margin="0" Height="32" VerticalAlignment="Center"
                                    ToolTip="{I18N {x:Static r:LangKeys.OpenRecoveryCopy}}"
                                    Command="{Binding DataContext.OpenRecoveryCopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <md:PackIcon Kind="OpenInApp" Width="16" Height="16" IsHitTestVisible="False" />
                            </Button>
                            <Button Grid.Column="2" AutomationProperties.AutomationId="ClearRecoveryEntryButton"
                                    AutomationProperties.Name="{I18N {x:Static r:LangKeys.ClearRecoveryEntry}}"
                                    Style="{StaticResource RecoveryEntryButton}" Padding="5" Margin="0" Height="32" VerticalAlignment="Center"
                                    ToolTip="{I18N {x:Static r:LangKeys.ClearRecoveryEntry}}"
                                    Command="{Binding DataContext.ClearRecoveryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <md:PackIcon Kind="Close" Width="16" Height="16" IsHitTestVisible="False" Opacity="0.65" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        <TextBlock Grid.Row="1" AutomationProperties.AutomationId="RecoveryEmptyHint" Margin="8,8" TextWrapping="Wrap" Opacity="0.6" IsHitTestVisible="False"
                   VerticalAlignment="Top" Text="{I18N {x:Static r:LangKeys.NoRecoveryDrawings}}"
                   Visibility="{Binding RecoveryEntries.Count, Converter={x:Static cv:DefaultToVisibilityConverter.CollapsedInstance}}" />
    </Grid>
</UserControl>
