<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.SplinePropertyView" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm_ep:SplinePropertyViewModel}" d:DesignHeight="760" d:DesignWidth="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10" IsEnabled="{Binding IsEditable, Mode=OneWay}">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{I18N {x:Static r:LangKeys.Spline}}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ep:EntityHeaderPropertySection ViewModel="{Binding}" />
        <CheckBox Style="{DynamicResource PropertyCheckBox}" FontSize="12" MinHeight="24" Content="{I18N {x:Static r:LangKeys.Closed}}" IsChecked="{Binding IsClosed}" Margin="0,2,0,8" />
        <StackPanel>
            <Grid Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid FontSize="12" RowHeight="30" ColumnHeaderHeight="26" BorderThickness="0" GridLinesVisibility="None" Grid.Row="0" ItemsSource="{Binding FitPoints, Mode=OneWay}" SelectedItem="{Binding SelectedFitPoint, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="180" Margin="0,0,0,4" Grid.ColumnSpan="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" IsReadOnly="True" Width="36" />
                        <DataGridTemplateColumn Header="{I18N {x:Static r:LangKeys.X}}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.X}}" Value="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{I18N {x:Static r:LangKeys.Y}}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Y}}" Value="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4" Grid.ColumnSpan="2">
                    <Button Style="{DynamicResource PropertyAction}" Content="{I18N {x:Static r:LangKeys.AddAfter}}" Command="{Binding AddFitPointAfterSelectedCommand}" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource PropertyAction}" Content="{I18N {x:Static r:LangKeys.Remove}}" Command="{Binding RemoveSelectedFitPointCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <ep:EntitySettingsPropertySection ViewModel="{Binding}" EntityIdText="{Binding EntityIdText, Mode=OneWay}">
            <ep:EntitySettingsPropertySection.Details>
                <StackPanel>
                    <TextBlock Style="{StaticResource PropertyTitle}" FontSize="12" Margin="0,8,0,4" Text="{I18N {x:Static r:LangKeys.Information}}" />
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.PointCount}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="0" Grid.Column="1" Text="{Binding FitPointCount, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Length}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="1" Grid.Column="1" Text="{Binding Length, Mode=OneWay, StringFormat=F3}" IsReadOnly="True" />
                    </Grid>
                </StackPanel>
            </ep:EntitySettingsPropertySection.Details>
        </ep:EntitySettingsPropertySection>
        <ep:StrokeAppearancePropertySection ViewModel="{Binding}">
            <ep:StrokeAppearancePropertySection.AdditionalContent>
                <ep:StrokeStylePropertySection ViewModel="{Binding}" />
            </ep:StrokeAppearancePropertySection.AdditionalContent>
        </ep:StrokeAppearancePropertySection>
        <ep:FillPropertySection ViewModel="{Binding}" />
    </StackPanel>
</UserControl>