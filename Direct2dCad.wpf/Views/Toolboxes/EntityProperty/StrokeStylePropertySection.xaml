<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.StrokeStylePropertySection"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Expander Header="{I18N {x:Static r:LangKeys.StrokeStyle}}"
              IsExpanded="True"
              Margin="0,8,0,0">
        <Grid Margin="8,6,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.StartCap}}" VerticalAlignment="Center" Visibility="{Binding ViewModel.SupportsStartEndCaps, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ViewModel.StrokeCapOptions, ElementName=Root, Mode=OneWay}" SelectedItem="{Binding ViewModel.SelectedStartCapOption, ElementName=Root, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,4" Visibility="{Binding ViewModel.SupportsStartEndCaps, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.EndCap}}" VerticalAlignment="Center" Visibility="{Binding ViewModel.SupportsStartEndCaps, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ViewModel.StrokeCapOptions, ElementName=Root, Mode=OneWay}" SelectedItem="{Binding ViewModel.SelectedEndCapOption, ElementName=Root, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,4" Visibility="{Binding ViewModel.SupportsStartEndCaps, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.DashCap}}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ViewModel.StrokeCapOptions, ElementName=Root, Mode=OneWay}" SelectedItem="{Binding ViewModel.SelectedDashCapOption, ElementName=Root, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,4" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.DashStyle}}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ViewModel.StrokeDashStyleOptions, ElementName=Root, Mode=OneWay}" SelectedItem="{Binding ViewModel.SelectedDashStyleOption, ElementName=Root, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,4" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.LineJoin}}" VerticalAlignment="Center" Visibility="{Binding ViewModel.SupportsLineJoin, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ViewModel.StrokeLineJoinOptions, ElementName=Root, Mode=OneWay}" SelectedItem="{Binding ViewModel.SelectedLineJoinOption, ElementName=Root, Mode=TwoWay}" DisplayMemberPath="Name" Visibility="{Binding ViewModel.SupportsLineJoin, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Expander>
</UserControl>
