<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.BlockDefinitionPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BlockDefinitionPropertyViewModel}"
             d:DesignWidth="320"
             d:DesignHeight="480">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

            <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="8,6,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding NameLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=OneWay}"
                             IsReadOnly="True" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ID" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BlockIdText, Mode=OneWay}"
                             IsReadOnly="True" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding EntitiesLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EntityCount, Mode=OneWay}"
                             IsReadOnly="True" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ReferencesLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ReferenceCount, Mode=OneWay}"
                             IsReadOnly="True" />
                </Grid>
            </Expander>

            <Expander Header="{Binding BasePointLabel}" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="8,6,8,8" IsEnabled="{Binding IsEditable, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" />
                    <mah:NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding BasePointX, Mode=TwoWay}"
                                       StringFormat="F3" Margin="0,0,4,8" />
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                            Width="28" Height="28" Padding="0"
                            Command="{Binding ApplyBasePointCommand}"
                            ToolTip="{Binding BasePointLabel}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <md:PackIcon Kind="Check" Width="16" Height="16" />
                    </Button>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" />
                    <mah:NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding BasePointY, Mode=TwoWay}"
                                       StringFormat="F3" Margin="0,0,4,0" />
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
