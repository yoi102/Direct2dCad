<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.BlockDefinitionPropertyView" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:BlockDefinitionPropertyViewModel}" d:DesignWidth="320" d:DesignHeight="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Expander Style="{DynamicResource PropertySection}" Header="{Binding BasePointLabel}" IsExpanded="True" Margin="0,0,0,4">
            <Grid Margin="0,4,0,6" IsEnabled="{Binding IsEditable, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="X" Grid.Row="0" Grid.Column="1" Value="{Binding BasePointX, Mode=TwoWay}" StringFormat="F3" Margin="0,0,4,8" />
                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Width="28" Height="28" Padding="0" Command="{Binding ApplyBasePointCommand}" ToolTip="{Binding BasePointLabel}" Style="{StaticResource MaterialDesignFlatButton}">
                    <md:PackIcon Kind="Check" Width="16" Height="16" />
                </Button>
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="Y" Grid.Row="1" Grid.Column="1" Value="{Binding BasePointY, Mode=TwoWay}" StringFormat="F3" Margin="0,0,4,0" />
            </Grid>
        </Expander>
        <Expander Style="{DynamicResource PropertySection}" Header="{I18N {x:Static r:LangKeys.Information}}" IsExpanded="False" Margin="0,0,0,4">
            <Grid Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{Binding NameLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="ID" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="1" Grid.Column="1" Text="{Binding BlockIdText, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="2" Grid.Column="0" Text="{Binding EntitiesLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="2" Grid.Column="1" Text="{Binding EntityCount, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="3" Grid.Column="0" Text="{Binding ReferencesLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="3" Grid.Column="1" Text="{Binding ReferenceCount, Mode=OneWay}" IsReadOnly="True" />
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>