<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.FillPropertySection" x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Expander Style="{DynamicResource PropertySection}" Header="{I18N {x:Static r:LangKeys.Fill}}" IsExpanded="False" Margin="0,0,0,4" AutomationProperties.AutomationId="EntityFillSettings">
        <Grid Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Fill}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox Style="{DynamicResource PropertyChoiceEditor}" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ViewModel.FillStyleOptions, ElementName=Root, Mode=OneWay}" SelectedItem="{Binding ViewModel.SelectedFillStyleOption, ElementName=Root, Mode=TwoWay}" IsEnabled="{Binding ViewModel.FillControlsEnabled, ElementName=Root, Mode=OneWay}" DisplayMemberPath="Name" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.FillColor}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:ColorPicker Style="{StaticResource PropertyColorEditor}" Grid.Row="1" Grid.Column="1" mah:TextBoxHelper.AutoWatermark="True" mah:TextBoxHelper.ClearTextButton="True" AdvancedTabHeader="{I18N {x:Static r:LangKeys.ColorPickerAdvanced}}" ColorPalettesTabHeader="{I18N {x:Static r:LangKeys.ColorPickerPalettes}}" AvailableColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerAvailableColors}}" RecentColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerRecentColors}}" StandardColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerStandardColors}}" AddToRecentColorsTrigger="SelectedColorChanged" IsEnabled="{Binding ViewModel.FillColorControlsEnabled, ElementName=Root, Mode=OneWay}" SelectedColor="{Binding ViewModel.FillColor, ElementName=Root, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
        </Grid>
    </Expander>
</UserControl>