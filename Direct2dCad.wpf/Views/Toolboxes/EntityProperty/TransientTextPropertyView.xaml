<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.TransientTextPropertyView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{I18N {x:Static r:LangKeys.TextDrawing}}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ep:DrawingLayerPropertySection ViewModel="{Binding}" />
        <Expander Style="{DynamicResource PropertySection}" Header="{I18N {x:Static r:LangKeys.Text}}" IsExpanded="True" Margin="0,0,0,4">
            <Grid Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Content}}" VerticalAlignment="Top" Margin="0,4,0,0" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="0" Grid.Column="1" Text="{Binding TextContent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Font}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Style="{DynamicResource PropertyChoiceEditor}" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FontFamilyOptions, Mode=OneWay}" SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="2" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Rotation}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Rotation}}" Grid.Row="2" Grid.Column="1" Value="{Binding RotationDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F2" Interval="5" Margin="0,0,0,4" />
                <CheckBox Style="{DynamicResource PropertyCheckBox}" FontSize="12" MinHeight="24" Grid.Row="3" Grid.ColumnSpan="2" Content="{I18N {x:Static r:LangKeys.Inverted}}" IsChecked="{Binding IsInverted}" Margin="0,2,0,8" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="4" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Margin}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Margin}}" Grid.Row="4" Grid.Column="1" Value="{Binding InvertedMarginFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" StringFormat="F3" Interval="0.01" />
            </Grid>
        </Expander>
        <ep:EntitySettingsPropertySection ViewModel="{Binding}" />
        <ep:StrokeAppearancePropertySection ViewModel="{Binding}" />
    </StackPanel>
</UserControl>