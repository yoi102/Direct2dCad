<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.TextPropertyView" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm_ep:TextPropertyViewModel}" d:DesignHeight="760" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10" IsEnabled="{Binding IsEditable, Mode=OneWay}">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{I18N {x:Static r:LangKeys.Text}}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ep:EntityHeaderPropertySection ViewModel="{Binding}" />
        <Grid Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Content}}" VerticalAlignment="Top" Margin="0,4,0,0" />
            <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="0" Grid.Column="1" Text="{Binding TextContent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Font}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox Style="{DynamicResource PropertyChoiceEditor}" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FontFamilyOptions, Mode=OneWay}" SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,0,4" />
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,8">
                <CheckBox Style="{DynamicResource PropertyCheckBox}" FontSize="12" MinHeight="24" Content="{I18N {x:Static r:LangKeys.Inverted}}" IsChecked="{Binding IsInverted}" />
            </StackPanel>
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="3" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Margin}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Margin}}" Grid.Row="3" Grid.Column="1" Value="{Binding InvertedMarginFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" StringFormat="F3" Interval="0.01" />
        </Grid>
        <StackPanel>
            <Grid Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Height}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Height}}" Grid.Row="0" Grid.Column="1" Value="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding MinimumPositiveLength}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Rotation}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Rotation}}" Grid.Row="1" Grid.Column="1" Value="{Binding RotationDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F2" Interval="5" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="2" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.PositionX}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.PositionX}}" Grid.Row="2" Grid.Column="1" Value="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="3" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.PositionY}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.PositionY}}" Grid.Row="3" Grid.Column="1" Value="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
            </Grid>
        </StackPanel>
        <ep:EntitySettingsPropertySection ViewModel="{Binding}" EntityIdText="{Binding EntityIdText, Mode=OneWay}">
            <ep:EntitySettingsPropertySection.Details>
                <StackPanel>
                    <TextBlock Style="{StaticResource PropertyTitle}" FontSize="12" Margin="0,8,0,4" Text="{I18N {x:Static r:LangKeys.Information}}" />
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Bounds}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="0" Grid.Column="1" Text="{Binding BoundsSizeText, Mode=OneWay}" IsReadOnly="True" />
                    </Grid>
                </StackPanel>
            </ep:EntitySettingsPropertySection.Details>
        </ep:EntitySettingsPropertySection>
        <ep:StrokeAppearancePropertySection ViewModel="{Binding}" />
    </StackPanel>
</UserControl>