<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.BlockReferencePropertyView" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:BlockReferencePropertyViewModel}" d:DesignWidth="320" d:DesignHeight="620">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10" IsEnabled="{Binding IsEditable, Mode=OneWay}">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ep:EntityHeaderPropertySection ViewModel="{Binding}" />
        <Expander Style="{DynamicResource PropertySection}" Header="{Binding DefinitionLabel}" IsExpanded="True" Margin="0,0,0,4">
            <Grid Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{Binding DefinitionLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Style="{DynamicResource PropertyChoiceEditor}" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DefinitionOptions, Mode=OneWay}" SelectedItem="{Binding SelectedDefinition, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{Binding EntitiesLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="1" Grid.Column="1" Text="{Binding DefinitionEntityCount, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="2" Grid.Column="0" Text="{Binding ReferencesLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Row="2" Grid.Column="1" Text="{Binding ReferenceCount, Mode=OneWay}" IsReadOnly="True" />
            </Grid>
        </Expander>
        <Grid Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="X" Grid.Row="0" Grid.Column="1" Value="{Binding PositionX, Mode=TwoWay}" StringFormat="F3" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="Y" Grid.Row="1" Grid.Column="1" Value="{Binding PositionY, Mode=TwoWay}" StringFormat="F3" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="2" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Rotation}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Rotation}}" Grid.Row="2" Grid.Column="1" Value="{Binding RotationDegrees, Mode=TwoWay}" StringFormat="F2" Interval="1" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="3" Grid.Column="0" Text="{Binding ScaleXLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{Binding ScaleXLabel}" Grid.Row="3" Grid.Column="1" Value="{Binding ScaleX, Mode=TwoWay}" Minimum="-100000" Maximum="100000" StringFormat="F3" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="4" Grid.Column="0" Text="{Binding ScaleYLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{Binding ScaleYLabel}" Grid.Row="4" Grid.Column="1" Value="{Binding ScaleY, Mode=TwoWay}" Minimum="-100000" Maximum="100000" StringFormat="F3" />
        </Grid>
        <ep:EntitySettingsPropertySection ViewModel="{Binding}" EntityIdText="{Binding EntityIdText, Mode=OneWay}" />
        <ep:StrokeAppearancePropertySection ViewModel="{Binding}" />
    </StackPanel>
</UserControl>