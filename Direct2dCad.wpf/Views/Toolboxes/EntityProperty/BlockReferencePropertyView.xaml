<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.BlockReferencePropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty"
             xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BlockReferencePropertyViewModel}"
             d:DesignWidth="320" d:DesignHeight="620">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" IsEnabled="{Binding IsEditable, Mode=OneWay}">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ep:EntityHeaderPropertySection ViewModel="{Binding}" />
            <ep:EntitySettingsPropertySection ViewModel="{Binding}" />
            <ep:StrokeAppearancePropertySection ViewModel="{Binding}" />

            <Expander Header="{Binding DefinitionLabel}" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="8,6,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DefinitionLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding DefinitionOptions, Mode=OneWay}"
                              SelectedItem="{Binding SelectedDefinition, Mode=TwoWay}"
                              DisplayMemberPath="Name" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding EntitiesLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefinitionEntityCount, Mode=OneWay}"
                             IsReadOnly="True" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ReferencesLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReferenceCount, Mode=OneWay}" IsReadOnly="True" />
                </Grid>
            </Expander>

            <Expander Header="{I18N {x:Static r:LangKeys.Coordinates}}" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="8,6,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" />
                    <mah:NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding PositionX, Mode=TwoWay}" StringFormat="F3" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" />
                    <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding PositionY, Mode=TwoWay}" StringFormat="F3" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Rotation}}" VerticalAlignment="Center" />
                    <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding RotationDegrees, Mode=TwoWay}" StringFormat="F2" Interval="1" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ScaleXLabel}" VerticalAlignment="Center" />
                    <mah:NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ScaleX, Mode=TwoWay}" Minimum="-100000" Maximum="100000" StringFormat="F3" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding ScaleYLabel}" VerticalAlignment="Center" />
                    <mah:NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding ScaleY, Mode=TwoWay}" Minimum="-100000" Maximum="100000" StringFormat="F3" />
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
