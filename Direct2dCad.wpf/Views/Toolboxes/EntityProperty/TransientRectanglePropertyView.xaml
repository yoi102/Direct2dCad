<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.TransientRectanglePropertyView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{I18N {x:Static r:LangKeys.RectangleDrawing}}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ep:DrawingLayerPropertySection ViewModel="{Binding}" />
        <Grid Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.CornerX}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.CornerX}}" Grid.Row="0" Grid.Column="1" Value="{Binding CornerRadiusX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.CornerY}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.CornerY}}" Grid.Row="1" Grid.Column="1" Value="{Binding CornerRadiusY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" StringFormat="F3" Interval="1" />
        </Grid>
        <ep:EntitySettingsPropertySection ViewModel="{Binding}" />
        <ep:StrokeAppearancePropertySection ViewModel="{Binding}">
            <ep:StrokeAppearancePropertySection.AdditionalContent>
                <ep:StrokeStylePropertySection ViewModel="{Binding}" />
            </ep:StrokeAppearancePropertySection.AdditionalContent>
        </ep:StrokeAppearancePropertySection>
        <ep:FillPropertySection ViewModel="{Binding}" />
    </StackPanel>
</UserControl>