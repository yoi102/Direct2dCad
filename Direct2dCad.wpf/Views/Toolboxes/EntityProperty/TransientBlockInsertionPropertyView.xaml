<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.TransientBlockInsertionPropertyView" d:DataContext="{d:DesignInstance Type=vm_ep:TransientBlockInsertionPropertyViewModel}" mc:Ignorable="d" d:DesignHeight="260" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10">
        <TextBlock Style="{StaticResource PropertyTitle}" Margin="0,0,0,12" FontWeight="SemiBold" Text="{I18N {x:Static r:LangKeys.InsertBlock}}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PropertyLabel}" Margin="0,0,12,8" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.BlockDefinition}}" TextWrapping="Wrap" />
            <TextBox Style="{DynamicResource PropertyTextEditor}" Grid.Column="1" Margin="0,0,0,4" IsReadOnly="True" Text="{Binding DefinitionName, Mode=OneWay}" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.TargetLayer}}" TextWrapping="Wrap" />
            <ComboBox Style="{DynamicResource PropertyChoiceEditor}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" DisplayMemberPath="Name" ItemsSource="{Binding LayerOptions, Mode=OneWay}" SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.Rotation}}" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Rotation}}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Interval="1" Speedup="True" StringFormat="F2" Value="{Binding RotationDegrees, Mode=TwoWay}" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="3" Margin="0,0,12,8" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.ScaleX}}" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.ScaleX}}" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Minimum="-100000" Maximum="100000" Speedup="True" StringFormat="F3" Value="{Binding ScaleX, Mode=TwoWay}" />
            <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="4" Margin="0,0,12,0" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.ScaleY}}" TextWrapping="Wrap" />
            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.ScaleY}}" Grid.Row="4" Grid.Column="1" Minimum="-100000" Maximum="100000" Speedup="True" StringFormat="F3" Value="{Binding ScaleY, Mode=TwoWay}" />
        </Grid>
    </StackPanel>
</UserControl>