<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.TransientBlockInsertionPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm_ep:TransientBlockInsertionPropertyViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="260"
             d:DesignWidth="320">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Margin="0,0,0,12"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{I18N {x:Static r:LangKeys.InsertBlock}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           Text="{I18N {x:Static r:LangKeys.BlockDefinition}}" />
                <TextBox Grid.Column="1"
                         Margin="0,0,0,8"
                         IsReadOnly="True"
                         Text="{Binding DefinitionName, Mode=OneWay}" />

                <TextBlock Grid.Row="1"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           Text="{I18N {x:Static r:LangKeys.TargetLayer}}" />
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,0,8"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding LayerOptions, Mode=OneWay}"
                          SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}" />

                <TextBlock Grid.Row="2"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           Text="{I18N {x:Static r:LangKeys.Rotation}}" />
                <mah:NumericUpDown Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   Interval="1"
                                   Speedup="True"
                                   StringFormat="F2"
                                   Value="{Binding RotationDegrees, Mode=TwoWay}" />

                <TextBlock Grid.Row="3"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           Text="{I18N {x:Static r:LangKeys.ScaleX}}" />
                <mah:NumericUpDown Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   Minimum="0.001"
                                   Maximum="100000"
                                   Speedup="True"
                                   StringFormat="F3"
                                   Value="{Binding ScaleX, Mode=TwoWay}" />

                <TextBlock Grid.Row="4"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="{I18N {x:Static r:LangKeys.ScaleY}}" />
                <mah:NumericUpDown Grid.Row="4"
                                   Grid.Column="1"
                                   Minimum="0.001"
                                   Maximum="100000"
                                   Speedup="True"
                                   StringFormat="F3"
                                   Value="{Binding ScaleY, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
