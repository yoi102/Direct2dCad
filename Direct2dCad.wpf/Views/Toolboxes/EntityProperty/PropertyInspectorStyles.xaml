<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PropertyInspectorCommonStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Loaded once, after MD and its MahApps compatibility dictionary.
         Keep the library templates, visual states, popup and input behavior. -->
    <Style x:Key="PropertyTextEditor" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="md:HintAssist.IsFloating" Value="False" />
    </Style>
    <Style x:Key="PropertyNumericEditor" TargetType="mah:NumericUpDown" BasedOn="{StaticResource MaterialDesignOutlinedNumericUpDown}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.TextBox.OutlineBorder}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="UpDownButtonsWidth" Value="18" />
    </Style>
    <Style x:Key="PropertyChoiceEditor" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="md:HintAssist.IsFloating" Value="False" />
    </Style>
    <Style x:Key="PropertySection" TargetType="Expander" BasedOn="{StaticResource MaterialDesignExpander}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.TextBox.OutlineBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="md:ExpanderAssist.HeaderBackground" Value="Transparent" />
        <Setter Property="md:ExpanderAssist.HeaderFontSize" Value="12" />
        <Setter Property="md:ExpanderAssist.HorizontalHeaderPadding" Value="0,3" />
        <Setter Property="HeaderTemplate">
            <Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" /></DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PropertyAction" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style x:Key="PropertyCheckBox" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
