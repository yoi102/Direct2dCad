<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.RectanglePropertyView" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm_ep:RectanglePropertyViewModel}" d:DesignHeight="720" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10" IsEnabled="{Binding IsEditable, Mode=OneWay}">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{I18N {x:Static r:LangKeys.Rectangle}}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ep:EntityHeaderPropertySection ViewModel="{Binding}" />
        <StackPanel>
            <Grid Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Width}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Width}}" Grid.Row="0" Grid.Column="1" Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding MinimumPositiveLength}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Height}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Height}}" Grid.Row="1" Grid.Column="1" Value="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding MinimumPositiveLength}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="2" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.CenterX}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.CenterX}}" Grid.Row="2" Grid.Column="1" Value="{Binding CenterX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="3" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.CenterY}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.CenterY}}" Grid.Row="3" Grid.Column="1" Value="{Binding CenterY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
            </Grid>
        </StackPanel>
        <ep:EntitySettingsPropertySection ViewModel="{Binding}" EntityIdText="{Binding EntityIdText, Mode=OneWay}">
            <ep:EntitySettingsPropertySection.Details>
                <StackPanel>
                    <TextBlock Style="{StaticResource PropertyTitle}" FontSize="12" Margin="0,8,0,4" Text="{I18N {x:Static r:LangKeys.Bounds}}" />
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Left}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Left}}" Grid.Row="0" Grid.Column="1" Value="{Binding Left, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Bottom}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Bottom}}" Grid.Row="1" Grid.Column="1" Value="{Binding Bottom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="2" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Right}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Right}}" Grid.Row="2" Grid.Column="1" Value="{Binding Right, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="3" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.Top}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Top}}" Grid.Row="3" Grid.Column="1" Value="{Binding Top, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="4" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.CornerX}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.CornerX}}" Grid.Row="4" Grid.Column="1" Value="{Binding CornerRadiusX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" StringFormat="F3" Interval="1" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="5" Grid.Column="0" Text="{I18N {x:Static r:LangKeys.CornerY}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.CornerY}}" Grid.Row="5" Grid.Column="1" Value="{Binding CornerRadiusY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" StringFormat="F3" Interval="1" />
                    </Grid>
                </StackPanel>
            </ep:EntitySettingsPropertySection.Details>
        </ep:EntitySettingsPropertySection>
        <ep:StrokeAppearancePropertySection ViewModel="{Binding}">
            <ep:StrokeAppearancePropertySection.AdditionalContent>
                <ep:StrokeStylePropertySection ViewModel="{Binding}" />
            </ep:StrokeAppearancePropertySection.AdditionalContent>
        </ep:StrokeAppearancePropertySection>
        <ep:FillPropertySection ViewModel="{Binding}" />
    </StackPanel>
</UserControl>