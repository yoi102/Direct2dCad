<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.TransientEllipsePropertyView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10">
        <TextBlock Style="{StaticResource PropertyTitle}" Text="{I18N {x:Static r:LangKeys.EllipseDrawing}}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ep:DrawingLayerPropertySection ViewModel="{Binding}" />
        <ep:EntitySettingsPropertySection ViewModel="{Binding}" />
        <ep:StrokeAppearancePropertySection ViewModel="{Binding}">
            <ep:StrokeAppearancePropertySection.AdditionalContent>
                <ep:StrokeStylePropertySection ViewModel="{Binding}" />
            </ep:StrokeAppearancePropertySection.AdditionalContent>
        </ep:StrokeAppearancePropertySection>
        <ep:FillPropertySection ViewModel="{Binding}" />
    </StackPanel>
</UserControl>