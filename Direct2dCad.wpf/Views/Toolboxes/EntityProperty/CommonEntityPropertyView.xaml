<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.CommonEntityPropertyView" d:DataContext="{d:DesignInstance Type=vm:CommonEntityPropertyViewModel}" d:DesignHeight="520" d:DesignWidth="320" mc:Ignorable="d" AutomationProperties.AutomationId="CommonEntityProperties">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10" IsEnabled="{Binding IsEditable, Mode=OneWay}">
        <TextBlock Style="{StaticResource PropertyTitle}" Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
        <ep:EntityHeaderPropertySection ViewModel="{Binding}" />
        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding RegionSummary}" Visibility="{Binding IsRegion, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ep:EntitySettingsPropertySection ViewModel="{Binding}" EntityIdText="{Binding EntityIdText, Mode=OneWay}" />
        <ep:StrokeAppearancePropertySection ViewModel="{Binding}" Visibility="{Binding SupportsStrokeAppearance, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ep:StrokeAppearancePropertySection.AdditionalContent>
                <ep:StrokeStylePropertySection ViewModel="{Binding}" Visibility="{Binding SupportsStrokeStyle, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </ep:StrokeAppearancePropertySection.AdditionalContent>
        </ep:StrokeAppearancePropertySection>
        <ep:FillPropertySection ViewModel="{Binding}" Visibility="{Binding IsRegion, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>