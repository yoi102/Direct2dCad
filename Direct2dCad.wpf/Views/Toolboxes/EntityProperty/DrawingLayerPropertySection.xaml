<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.DrawingLayerPropertySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang">
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{I18N {x:Static r:LangKeys.Layers}}"
                   VerticalAlignment="Center" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding LayerOptions, Mode=OneWay}"
                  SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}"
                  DisplayMemberPath="Name" />
    </Grid>
</UserControl>
