<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang" xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters" xmlns:property="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.MultiEntityPropertyView" d:DataContext="{d:DesignInstance Type=vm:MultiEntityPropertyViewModel}" d:DesignHeight="520" d:DesignWidth="300" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Direct2dCad;component/Views/Toolboxes/EntityProperty/PropertyInspectorCommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12,10">
        <TextBlock Style="{StaticResource PropertyTitle}" AutomationProperties.AutomationId="MultiEntitySelectionCount" FontWeight="SemiBold" Text="{Binding SelectionCountText}" />
        <TextBlock Margin="0,3,0,10" Opacity="0.7" Text="{Binding EntityTypeName}" />
        <StackPanel IsEnabled="{Binding IsEditable, Mode=OneWay}">
            <StackPanel>
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.Layers}}" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                        <TextBlock Margin="0,0,0,3" FontStyle="Italic" Opacity="0.7" Text="{I18N {x:Static r:LangKeys.MultipleValues}}" Visibility="{Binding HasMixedLayer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ComboBox Style="{DynamicResource PropertyChoiceEditor}" AutomationProperties.AutomationId="MultiEntityLayerSelector" DisplayMemberPath="Name" ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Expander Style="{DynamicResource PropertySection}" Margin="0,0,0,4" Header="{I18N {x:Static r:LangKeys.Appearance}}" IsExpanded="True" Visibility="{Binding SupportsStrokeAppearance, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.Color}}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                            <TextBlock Margin="0,0,0,3" FontStyle="Italic" Opacity="0.7" Text="{I18N {x:Static r:LangKeys.MultipleValues}}" Visibility="{Binding HasMixedStrokeColor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <mah:ColorPicker Style="{StaticResource PropertyColorEditor}" IsEnabled="{Binding ColorControlsEnabled}" SelectedColor="{Binding StrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                            <TextBlock Margin="0,4,0,3" FontStyle="Italic" Opacity="0.7" Text="{I18N {x:Static r:LangKeys.MultipleValues}}" Visibility="{Binding HasMixedColorSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox Style="{DynamicResource PropertyChoiceEditor}" ItemsSource="{Binding ColorSourceOptions, Mode=OneWay}" SelectedItem="{Binding SelectedColorSourceOption, Mode=TwoWay}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.LineWeight}}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
                            <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.LineWeight}}" IsEnabled="{Binding LineWeightControlsEnabled}" Minimum="0.01" Interval="0.05" StringFormat="F3" Value="{Binding LineWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Visibility="{Binding LineWeightControlsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Style="{DynamicResource PropertyTextEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.LineWeight}}" IsReadOnly="True"
                         Text="{Binding LineWeight, Mode=OneWay, StringFormat=F3}"
                         Visibility="{Binding LineWeightControlsEnabled, Converter={x:Static cv:DefaultToVisibilityConverter.CollapsedInstance}}" />
                            <CheckBox Style="{DynamicResource PropertyCheckBox}" FontSize="12" MinHeight="24" VerticalAlignment="Center" Content="{I18N {x:Static r:LangKeys.ByLayer}}" IsChecked="{Binding UseByLayerLineWeight, Mode=TwoWay}" IsThreeState="True" />
                        </StackPanel>
                    </Grid>
                    <property:StrokeStylePropertySection ViewModel="{Binding}" Visibility="{Binding SupportsStrokeStyle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Expander>
            <Expander Style="{DynamicResource PropertySection}" Margin="0,0,0,4" Header="{I18N {x:Static r:LangKeys.Fill}}" IsExpanded="False" Visibility="{Binding SupportsFill, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.Fill}}" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                        <TextBlock Margin="0,0,0,3" FontStyle="Italic" Opacity="0.7" Text="{I18N {x:Static r:LangKeys.MultipleValues}}" Visibility="{Binding HasMixedFillStyle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ComboBox Style="{DynamicResource PropertyChoiceEditor}" DisplayMemberPath="Name" ItemsSource="{Binding FillStyleOptions, Mode=OneWay}" SelectedItem="{Binding SelectedFillStyleOption, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="1" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.FillColor}}" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Margin="0,0,0,3" FontStyle="Italic" Opacity="0.7" Text="{I18N {x:Static r:LangKeys.MultipleValues}}" Visibility="{Binding HasMixedFillColor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <mah:ColorPicker Style="{StaticResource PropertyColorEditor}" mah:TextBoxHelper.AutoWatermark="True" mah:TextBoxHelper.ClearTextButton="True" AdvancedTabHeader="{I18N {x:Static r:LangKeys.ColorPickerAdvanced}}" ColorPalettesTabHeader="{I18N {x:Static r:LangKeys.ColorPickerPalettes}}" AvailableColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerAvailableColors}}" RecentColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerRecentColors}}" StandardColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerStandardColors}}" AddToRecentColorsTrigger="SelectedColorChanged" IsEnabled="{Binding FillColorControlsEnabled}" SelectedColor="{Binding FillColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                    </StackPanel>
                </Grid>
            </Expander>
            <Expander Style="{DynamicResource PropertySection}" Header="{I18N {x:Static r:LangKeys.Appearance}}" IsExpanded="True" Visibility="{Binding SupportsOpacity, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource PropertyLabel}" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.Opacity}}" TextWrapping="Wrap" />
                    <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.Opacity}}" Grid.Column="1" Minimum="0" Maximum="1" Interval="0.05" StringFormat="F2" Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Expander>
            <Expander Style="{DynamicResource PropertySection}" Header="{I18N {x:Static r:LangKeys.Advanced}}" IsExpanded="False" Margin="0,2,0,4">
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PropertyLabel}" Grid.Row="0" VerticalAlignment="Center" Text="{I18N {x:Static r:LangKeys.DrawOrder}}" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                        <TextBlock Margin="0,0,0,3" FontStyle="Italic" Opacity="0.7" Text="{I18N {x:Static r:LangKeys.MultipleValues}}" Visibility="{Binding HasMixedZIndex, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <mah:NumericUpDown Style="{DynamicResource PropertyNumericEditor}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DrawOrder}}" Interval="1" StringFormat="F0" Value="{Binding ZIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                        <TextBlock Margin="0,0,0,3" FontStyle="Italic" Opacity="0.7" Text="{I18N {x:Static r:LangKeys.MultipleValues}}" Visibility="{Binding HasMixedVisibility, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <CheckBox Style="{DynamicResource PropertyCheckBox}" FontSize="12" MinHeight="24" Content="{I18N {x:Static r:LangKeys.Visible}}" IsChecked="{Binding IsVisible, Mode=TwoWay}" IsThreeState="True" />
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>
    </StackPanel>
</UserControl>