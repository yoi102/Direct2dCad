<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:mahCv="clr-namespace:MahApps.Metro.Converters;assembly=MahApps.Metro">
    <Style x:Key="PropertyLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,4" />
    </Style>
    <Style x:Key="PropertyTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <!-- MahApps supplies the ColorPicker template and popup. The MD/MahApps
         theme supplies its brushes; only density and selected-color content
         are adjusted here. This also supports independently hosted sections. -->
    <Style x:Key="PropertyColorEditor" TargetType="mah:ColorPicker">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ComboBox.OutlineBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="SelectedColorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Rectangle Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   RadiusX="2" RadiusY="2" Fill="{Binding Converter={x:Static mahCv:ColorToSolidColorBrushConverter.DefaultInstance}}" />
                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource MahApps.Brushes.Text}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
