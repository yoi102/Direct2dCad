<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.BlocksToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:yr="https://github.com/yoi102/xaml/controls"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BlocksToolboxViewModel}"
             d:DesignWidth="320"
             d:DesignHeight="640">
    <Grid Background="Transparent"
          IsEnabled="{Binding HasDocument}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0"
                 ItemsSource="{Binding Blocks}"
                 SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem"
                       BasedOn="{StaticResource MaterialDesignNavigationListBoxItem}">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="Padding"
                            Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BlockItemViewModel}">
                    <Border Padding="8,6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            CornerRadius="3">
                        <Grid ColumnDefinitions="auto *">
                            <Border  x:Name="SelectedBorder"
                                     Visibility="Hidden"
                                     HorizontalAlignment="Stretch"
                                     Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                     CornerRadius="2"
                                     Width="2" />
                            <Grid Grid.Column="1"
                                  Margin="5,2"
                                  RowDefinitions="auto auto">
                                <yr:EditableTextBlock Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                      FontWeight="SemiBold" />
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Margin="0,4,0,0"
                                            Opacity="0.65">
                                    <TextBlock Text="ID "
                                               FontSize="11" />
                                    <TextBlock Text="{Binding IdText}"
                                               FontSize="11"
                                               Margin="0,0,10,0" />
                                    <TextBlock Text="E "
                                               FontSize="11" />
                                    <TextBlock Text="{Binding EntityCount}"
                                               FontSize="11"
                                               Margin="0,0,10,0" />
                                    <TextBlock Text="R "
                                               FontSize="11" />
                                    <TextBlock Text="{Binding ReferenceCount}"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                     Value="True">
                            <Setter TargetName="SelectedBorder"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1"
                    Margin="10,8,10,10">
            <UniformGrid Columns="4">
                <Button Command="{Binding InsertCommand}"
                        ToolTip="{Binding InsertLabel}"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <md:PackIcon Kind="Import"
                                 Width="18"
                                 Height="18" />
                </Button>
                <Button Command="{Binding EditCommand}"
                        ToolTip="{Binding EditLabel}"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <md:PackIcon Kind="Pencil"
                                 Width="18"
                                 Height="18" />
                </Button>
                <Button Command="{Binding ExitEditCommand}"
                        ToolTip="{Binding ExitEditLabel}"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <md:PackIcon Kind="ExitToApp"
                                 Width="18"
                                 Height="18" />
                </Button>
                <Button Command="{Binding DeleteCommand}"
                        ToolTip="{Binding DeleteLabel}"
                        Style="{StaticResource MaterialDesignFlatButton}">
                    <md:PackIcon Kind="Delete"
                                 Width="18"
                                 Height="18" />
                </Button>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
