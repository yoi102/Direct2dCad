<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityPropertiesToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Direct2dCad.wpf.Views.Toolboxes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels"
             xmlns:toolboxes="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
             xmlns:v_ep="clr-namespace:Direct2dCad.wpf.Views.Toolboxes.EntityProperty"
             d:DataContext="{d:DesignInstance Type=toolboxes:EntityPropertiesToolboxViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>

        <Grid.Resources>           
            <DataTemplate DataType="{x:Type vm_ep:ArcPropertyViewModel}">
                <v_ep:ArcPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientArcPropertyViewModel}">
                <v_ep:TransientArcPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:LinePropertyViewModel}">
                <v_ep:LinePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientLinePropertyViewModel}">
                <v_ep:TransientLinePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:CirclePropertyViewModel}">
                <v_ep:CirclePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientCirclePropertyViewModel}">
                <v_ep:TransientCirclePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:EllipsePropertyViewModel}">
                <v_ep:EllipsePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientEllipsePropertyViewModel}">
                <v_ep:TransientEllipsePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:RectanglePropertyViewModel}">
                <v_ep:RectanglePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientRectanglePropertyViewModel}">
                <v_ep:TransientRectanglePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:PolylinePropertyViewModel}">
                <v_ep:PolylinePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientPolylinePropertyViewModel}">
                <v_ep:TransientPolylinePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientPolygonPropertyViewModel}">
                <v_ep:TransientPolygonPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:SplinePropertyViewModel}">
                <v_ep:SplinePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientSplinePropertyViewModel}">
                <v_ep:TransientSplinePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TextPropertyViewModel}">
                <v_ep:TextPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:ImagePropertyViewModel}">
                <v_ep:ImagePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:BlockReferencePropertyViewModel}">
                <v_ep:BlockReferencePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:BlockDefinitionPropertyViewModel}">
                <v_ep:BlockDefinitionPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:OleObjectPropertyViewModel}">
                <v_ep:ImagePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:CommonEntityPropertyViewModel}">
                <v_ep:CommonEntityPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientTextPropertyViewModel}">
                <v_ep:TransientTextPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientPastePropertyViewModel}">
                <v_ep:TransientPastePropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientBlockInsertionPropertyViewModel}">
                <v_ep:TransientBlockInsertionPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:MultiEntityPropertyViewModel}">
                <v_ep:MultiEntityPropertyView />
            </DataTemplate>
        </Grid.Resources>
        <ContentControl Content="{Binding Entity}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
