<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntitySearchToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:toolboxes="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=toolboxes:EntitySearchToolboxViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="320">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="10,8,10,6"
                   LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="Search"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Button DockPanel.Dock="Right"
                    Width="26"
                    Height="26"
                    Padding="0"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="Refresh">
                <md:PackIcon Kind="Refresh"
                             Width="16"
                             Height="16" />
            </Button>
        </DockPanel>

        <Grid Grid.Row="1"
              Margin="10,0,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Row="0"
                     Grid.ColumnSpan="3"
                     Margin="0,0,0,8"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Entity name, id, layer, type" />

            <ComboBox Grid.Row="1"
                      Grid.Column="0"
                      ItemsSource="{Binding LayerFilters}"
                      SelectedItem="{Binding SelectedLayerFilter, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText"
                      md:HintAssist.Hint="Layer" />

            <ComboBox Grid.Row="1"
                      Grid.Column="2"
                      ItemsSource="{Binding TypeFilters}"
                      SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText"
                      md:HintAssist.Hint="Type" />
        </Grid>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Style="{StaticResource MaterialDesignNavigationListBox}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding PanToResultCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}"
                       BasedOn="{StaticResource MaterialDesignNavigationListBoxItem}">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="Padding"
                            Value="0" />
                    <Setter Property="Margin"
                            Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type toolboxes:EntitySearchResultItemViewModel}">
                    <Border Margin="0,2"
                            Padding="0"
                            BorderThickness="1"
                            CornerRadius="3"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            ToolTip="{Binding ToolTipText}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border x:Name="SelectedBorder"
                                    Width="2"
                                    CornerRadius="2"
                                    Visibility="Hidden"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Grid Grid.Column="1"
                                  Margin="8,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding EntityType}"
                                           FontSize="11"
                                           Opacity="0.72"
                                           Margin="8,0,0,0" />

                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding LayerName}"
                                           FontSize="11"
                                           Opacity="0.72"
                                           TextTrimming="CharacterEllipsis" />

                                <DockPanel Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding EntityIdText, StringFormat=Id {0}}"
                                               FontSize="10"
                                               Opacity="0.56" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding StatusText}"
                                               FontSize="10"
                                               Opacity="0.56"
                                               Margin="8,0,0,0" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                     Value="True">
                            <Setter TargetName="SelectedBorder"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3"
                   Text="{Binding ResultSummary}"
                   Margin="10,6,10,8"
                   FontSize="11"
                   Opacity="0.62" />
    </Grid>
</UserControl>
