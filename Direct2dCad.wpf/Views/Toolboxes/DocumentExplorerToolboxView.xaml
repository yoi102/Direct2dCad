<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.DocumentExplorerToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:yr="https://github.com/yoi102/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:toolboxes="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=toolboxes:DocumentExplorerToolboxViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="320">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="10,8,10,6"
                   LastChildFill="False">
            <TextBlock Text="{I18N {x:Static r:LangKeys.Documents}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />

            <Button Width="26"
                    Height="26"
                    Padding="0"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="{I18N {x:Static r:LangKeys.Refresh}}"
                    DockPanel.Dock="Right">
                <md:PackIcon Kind="Refresh"
                             Width="16"
                             Height="16" />
            </Button>
        </DockPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Documents}"
                 SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Style="{StaticResource MaterialDesignNavigationListBox}">

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type toolboxes:DocumentExplorerItemViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <Border  x:Name="SelectedBorder"
                                 Visibility="Hidden"
                                 Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                 CornerRadius="2"
                                 Width="2" />

                        <Grid     Margin="4,0"
                                  ToolTip="{Binding ToolTipText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <md:PackIcon Grid.Column="0"
                                         Kind="FileDocumentOutline"
                                         Width="16"
                                         Height="16"
                                         VerticalAlignment="Top"
                                         Margin="0,2,6,0" />

                            <StackPanel Grid.Column="1"
                                        ToolTip="{Binding DisplayPath}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <yr:EditableTextBlock Grid.Column="0"
                                                          Text="{Binding DocumentName, Mode=TwoWay}"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          TextTrimming="CharacterEllipsis"
                                                          EmptyTextErrorMessage="{I18N {x:Static r:LangKeys.DocumentNameCannotBeEmpty}}"
                                                          ToolTip="{Binding ToolTipText}" />

                                    <TextBlock x:Name="ModifiedMarker"
                                               Grid.Column="1"
                                               Text="*"
                                               Foreground="#FFE53935"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="4,-2,0,0"
                                               Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                     Value="True">
                            <Setter TargetName="SelectedBorder"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsModified}"
                                     Value="True">
                            <Setter TargetName="ModifiedMarker"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
