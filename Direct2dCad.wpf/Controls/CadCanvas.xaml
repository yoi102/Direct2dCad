<Image x:Class="Direct2dCad.wpf.Controls.CadCanvas"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:local="clr-namespace:Direct2dCad.wpf.Controls"
       x:Name="imageHost"
       Focusable="True"
       mc:Ignorable="d"
       d:DesignHeight="450"
       d:DesignWidth="800">
    <Image.Source>
        <local:D3D11ImageSource  x:Name="d3d11ImageSource" />
    </Image.Source>
</Image>
