<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" x:Class="Direct2dCad.Avalonia.Views.Toolboxes.DocumentsView" x:DataType="vm:DocumentExplorerToolboxViewModel" x:CompileBindings="True">
 <DockPanel Margin="8"><Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,6"><TextBlock Text="{local:Loc Documents}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="toolIcon" Command="{Binding RefreshCommand}" ToolTip.Tip="{local:Loc Refresh}"><controls:CadIcon Kind="Refresh" /></Button></Grid>
 <ListBox x:Name="Documents" Classes="cadList" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}" AutomationProperties.AutomationId="DocumentExplorerList">
 <ListBox.ItemTemplate><DataTemplate x:DataType="vm:DocumentExplorerItemViewModel">
  <Grid ColumnDefinitions="22,*,Auto" Margin="2" Background="Transparent" ToolTip.Tip="{Binding ToolTipText}">
   <controls:CadIcon Kind="FileDocumentOutline" VerticalAlignment="Center" />
   <controls:CadEditableText Grid.Column="1" Text="{Binding DocumentName, Mode=TwoWay}" FontSize="13" FontWeight="SemiBold" MinHeight="22" ToolTip.Tip="{Binding DisplayPath}" />
   <TextBlock Grid.Column="2" Text="*" IsVisible="{Binding IsModified}" Foreground="#E53935" FontWeight="Bold" FontSize="16" />
  </Grid>
 </DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
</UserControl>

