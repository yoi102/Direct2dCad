<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" x:Class="Direct2dCad.Avalonia.Views.Toolboxes.LayersView" x:DataType="vm:LayersToolboxViewModel" x:CompileBindings="True">
<Grid Background="Transparent"><TextBlock AutomationProperties.AutomationId="LayersToolboxViewEmptyHint" IsVisible="{Binding !HasDocument}" Text="{local:Loc DrawingAssistantEmpty}" Margin="12,8" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Top" /><Border IsVisible="{Binding HasDocument}">
 <DockPanel Margin="8">
 <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,6"><TextBlock Text="{local:Loc Layers}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="toolIcon" Command="{Binding AddLayerCommand}" ToolTip.Tip="{local:Loc AddLayer}" AutomationProperties.AutomationId="AddLayerButton"><controls:CadIcon Kind="Plus" /></Button><Button Classes="toolIcon" Command="{Binding DeleteSelectedLayerCommand}" ToolTip.Tip="{local:Loc DeleteLayer}"><controls:CadIcon Kind="Delete" /></Button><Button Classes="toolIcon" Command="{Binding RefreshCommand}" ToolTip.Tip="{local:Loc Refresh}"><controls:CadIcon Kind="Refresh" /></Button></StackPanel></Grid>
 <ListBox Classes="cadList" x:Name="LayersList" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}" BorderThickness="0">
  <ListBox.ItemTemplate><DataTemplate x:DataType="vm:LayerItemViewModel">
   <Border BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="3" Padding="3,4" ToolTip.Tip="{Binding ToolTipText}"><StackPanel Spacing="3">
    <Grid ColumnDefinitions="18,40,*,Auto"><TextBlock Text="::" Opacity="0.45" Cursor="SizeAll" VerticalAlignment="Center" PointerPressed="HandlePressed" PointerReleased="HandleReleased" PointerMoved="HandleMoved" /><controls:CadColorSwatch Grid.Column="1" Width="33" Color="{Binding Color, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /><controls:CadEditableText Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" FontWeight="SemiBold" FontSize="14" MinHeight="24" /><StackPanel Grid.Column="3" Orientation="Horizontal"><ToggleButton Classes="layerState" IsChecked="{Binding IsVisible, Mode=TwoWay}" ToolTip.Tip="{local:Loc Visible}" AutomationProperties.AutomationId="LayerVisibilityToggle"><controls:CadIcon Kind="EyeOff" OnKind="Eye" IsOn="{Binding IsVisible}" /></ToggleButton><ToggleButton Classes="layerState" IsChecked="{Binding IsLocked, Mode=TwoWay}" ToolTip.Tip="{local:Loc Locked}" AutomationProperties.AutomationId="LayerLockToggle"><controls:CadIcon Kind="Unlocked" OnKind="Lock" IsOn="{Binding IsLocked}" /></ToggleButton><ToggleButton Classes="layerState" IsChecked="{Binding IsFrozen, Mode=TwoWay}" ToolTip.Tip="{local:Loc Frozen}" AutomationProperties.AutomationId="LayerFreezeToggle"><controls:CadIcon Kind="SnowflakeOff" OnKind="Snowflake" IsOn="{Binding IsFrozen}" /></ToggleButton></StackPanel></Grid>
    <WrapPanel Margin="58,0,0,0"><TextBlock Text="{local:Loc Priority}" VerticalAlignment="Center" FontSize="11" Opacity="0.65" /><controls:CadPropertyNumberBox Classes="compactNumber" Value="{Binding Priority, Mode=TwoWay}" FormatString="F0" Width="30" ToolTip.Tip="{local:Loc Priority}" /><TextBlock Text="{local:Loc Entities}" VerticalAlignment="Center" FontSize="11" Opacity="0.65" /><TextBlock Text="{Binding EntityCount}" VerticalAlignment="Center" FontSize="11" Margin="3,0,10,0" Opacity="0.65" /><TextBlock Text="{local:Loc Weight}" VerticalAlignment="Center" FontSize="11" Opacity="0.65" /><controls:CadPropertyNumberBox Classes="compactNumber" Value="{Binding LineWeight, Mode=TwoWay}" FormatString="0.##" Minimum="0.01" Width="45" ToolTip.Tip="{local:Loc LineWeight}" /></WrapPanel>
   </StackPanel></Border>
  </DataTemplate></ListBox.ItemTemplate>
 </ListBox></DockPanel>
</Border></Grid>
</UserControl>


