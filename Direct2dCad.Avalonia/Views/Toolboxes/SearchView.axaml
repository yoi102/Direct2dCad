<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:local="clr-namespace:Direct2dCad.Avalonia" x:Class="Direct2dCad.Avalonia.Views.Toolboxes.SearchView" x:DataType="vm:EntitySearchToolboxViewModel" x:CompileBindings="True">
<Grid><TextBlock AutomationProperties.AutomationId="EntitySearchToolboxViewEmptyHint" IsVisible="{Binding !HasDocument}" Text="{local:Loc DrawingAssistantEmpty}" Margin="12,8" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Top" /><Border IsVisible="{Binding HasDocument}">
 <DockPanel Margin="8">
  <StackPanel DockPanel.Dock="Top" Spacing="6">
   <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{local:Loc EntitySearch}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Command="{Binding RefreshCommand}" ToolTip.Tip="{local:Loc Refresh}" Classes="toolIcon"><controls:CadIcon Kind="Refresh" /></Button></Grid>
   <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding ScopeText}" VerticalAlignment="Center" /><RadioButton Content="{Binding CurrentSpaceText}" GroupName="SearchScope" IsChecked="{Binding SearchScope, Mode=TwoWay, Converter={x:Static local:CadSearchScopeConverter.Instance}, ConverterParameter=CurrentSpace}" /><RadioButton Content="{Binding EntireDocumentText}" GroupName="SearchScope" IsChecked="{Binding SearchScope, Mode=TwoWay, Converter={x:Static local:CadSearchScopeConverter.Instance}, ConverterParameter=EntireDocument}" /></StackPanel>
   <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{Binding SearchHintText}" />
   <Grid ColumnDefinitions="*,8,*"><ComboBox ItemsSource="{Binding LayerFilters}" SelectedItem="{Binding SelectedLayerFilter, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:EntitySearchLayerFilterOption"><TextBlock Text="{Binding DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <ComboBox Grid.Column="2" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:EntitySearchTypeFilterOption"><TextBlock Text="{Binding DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResultSummary}" Margin="2,6" FontSize="11" Opacity="0.65" />
  <ListBox Classes="cadList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" DoubleTapped="PanResult"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:EntitySearchResultItemViewModel"><Border BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="3" Margin="0,2" Padding="8,6" ToolTip.Tip="{Binding ToolTipText}"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding EntityType}" FontSize="11" Opacity="0.7" /><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LayerName}" FontSize="11" Opacity="0.7" /><TextBlock Grid.Row="2" Text="{Binding EntityIdText, StringFormat='ID {0}'}" FontSize="10" Opacity="0.6" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" FontSize="10" Opacity="0.6" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
 </DockPanel>
</Border></Grid>
</UserControl>
