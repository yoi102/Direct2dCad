<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" x:Class="Direct2dCad.Avalonia.Views.Toolboxes.AiView" x:DataType="vm:AiAssistantToolboxViewModel" x:CompileBindings="True">
 <Grid Margin="8" RowDefinitions="Auto,*,Auto,Auto,Auto">
  <Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{Binding ConnectionStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="toolIcon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{local:Loc Settings}"><controls:CadIcon Kind="Cog" /></Button><Button Grid.Column="2" Classes="toolIcon" Command="{Binding ClearConversationCommand}" ToolTip.Tip="{local:Loc ClearConversation}"><controls:CadIcon Kind="Delete" /></Button></Grid>
  <ListBox Grid.Row="1" x:Name="Messages" Classes="cadList" ItemsSource="{Binding Messages}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AiChatItemViewModel"><Border Margin="4,3" Padding="9,7" CornerRadius="6" Background="{Binding Kind, Converter={x:Static local:CadChatBrushConverter.Instance}}"><StackPanel Spacing="4"><TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource CadRibbonAccentBrush}" /><SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AiImageAttachmentViewModel"><StackPanel Margin="0,4,8,0"><Image Width="120" Height="80" Stretch="Uniform" IsVisible="{Binding IsImage}" Source="{Binding DataUrl, Converter={x:Static local:CadAttachmentPreviewConverter.Instance}}" /><TextBlock Text="{Binding SourceName}" FontSize="10" Opacity="0.7" MaxWidth="120" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
  <ListBox Grid.Row="2" ItemsSource="{Binding Attachments}" MaxHeight="110"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AiImageAttachmentViewModel"><Grid ColumnDefinitions="38,*,Auto"><Image Width="32" Height="32" Stretch="Uniform" IsVisible="{Binding IsImage}" Source="{Binding DataUrl, Converter={x:Static local:CadAttachmentPreviewConverter.Instance}}" /><TextBlock Grid.Column="1" Text="{Binding SourceName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Classes="toolIcon" Click="RemoveAttachment"><controls:CadIcon Kind="Close" /></Button></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Grid Grid.Row="3" ColumnDefinitions="*,40"><TextBox x:Name="Prompt" Text="{Binding UserInput, Mode=TwoWay}" PlaceholderText="{local:Loc AiPromptHint}" AcceptsReturn="True" MinHeight="54" MaxHeight="120" TextWrapping="Wrap" AutomationProperties.AutomationId="AiPrompt" /><StackPanel Grid.Column="1" VerticalAlignment="Bottom"><Button Classes="toolIcon" Command="{Binding AddFileFromFileCommand}" ToolTip.Tip="{local:Loc AiAttachImage}"><controls:CadIcon Kind="Paperclip" /></Button><Button Classes="toolIcon" Command="{Binding SendCommand}" ToolTip.Tip="{local:Loc Send}" IsVisible="{Binding !IsBusy}"><controls:CadIcon Kind="Send" /></Button><ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Width="26" Height="4" /><Button Classes="toolIcon" Command="{Binding StopCommand}" ToolTip.Tip="{local:Loc Stop}"><controls:CadIcon Kind="Stop" /></Button></StackPanel></Grid>
 </Grid>
</UserControl>

