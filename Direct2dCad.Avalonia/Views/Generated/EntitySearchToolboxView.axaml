<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.EntitySearchToolboxView" x:DataType="vm:EntitySearchToolboxViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><TextBlock Text="{local:Loc EntitySearch}" FontWeight="SemiBold" Margin="0,4,0,8" />
<Button Command="{Binding RefreshCommand}" Content="{local:Loc Refresh}" ToolTip.Tip="{local:Loc Refresh}" />
<Border IsVisible="{Binding HasDocument}"><TextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" />
</Border><Border IsVisible="{Binding HasDocument}"><Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Search Scope" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{x:Static local:EnumValues.CadEntitySearchScope}" SelectedItem="{Binding SearchScope, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t4:CadEntitySearchScope"><controls:CadEnumText Value="{Binding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border><Border IsVisible="{Binding HasDocument}"><Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Search Text" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding SearchText, Mode=TwoWay}" IsReadOnly="False" /></Border></Grid>
</Border><Border IsVisible="{Binding HasDocument}"><Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Selected Layer Filter" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding LayerFilters}" SelectedItem="{Binding SelectedLayerFilter, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t4:EntitySearchLayerFilterOption"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border><Border IsVisible="{Binding HasDocument}"><Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Selected Type Filter" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}"></ComboBox></Border></Grid>
</Border><Border IsVisible="{Binding HasDocument}"><StackPanel Spacing="3" Margin="0,3"><TextBlock Text="Results" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t4:EntitySearchResultItemViewModel"><StackPanel Spacing="4"><TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Name" /><TextBox Text="{Binding EntityType, Mode=TwoWay}" PlaceholderText="EntityType" /><TextBox Text="{Binding LayerName, Mode=TwoWay}" PlaceholderText="LayerName" /><TextBox Text="{Binding ZIndex, Mode=TwoWay}" PlaceholderText="ZIndex" /><CheckBox Content="IsVisible" IsChecked="{Binding IsVisible, Mode=TwoWay}" /><CheckBox Content="IsLocked" IsChecked="{Binding IsLocked, Mode=TwoWay}" /><TextBlock Text="{Binding EntityIdText}" TextWrapping="Wrap" /><TextBlock Text="{Binding BoundsText}" TextWrapping="Wrap" /><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" /><TextBlock Text="{Binding ToolTipText}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
</Border><Button Command="{Binding PanToResultCommand}" Content="Pan To Result " ToolTip.Tip="Pan To Result " />
<Border IsVisible="{Binding HasDocument}"><TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" />
</Border></StackPanel></ScrollViewer>
</UserControl>