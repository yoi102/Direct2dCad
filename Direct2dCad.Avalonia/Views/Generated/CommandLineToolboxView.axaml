<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.CommandLineToolboxView" x:DataType="vm:CommandLineToolboxViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><StackPanel Spacing="3" Margin="0,3"><TextBlock Text="Entries" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Entries}" AutomationProperties.AutomationId="CommandLineOutput" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t4:CadCommandLineEntryViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
<TextBlock Text="&gt;" FontWeight="SemiBold" Margin="0,4,0,8" />
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc ShortcutTerminalScope}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding CommandText, Mode=TwoWay}" IsReadOnly="False" AutomationProperties.AutomationId="CommandLineInput" /></Border></Grid>
<TextBlock Text="{Binding InputHint}" TextWrapping="Wrap" AutomationProperties.AutomationId="CommandLineInputHint" />
<StackPanel Spacing="3" Margin="0,3"><TextBlock Text="Suggestions" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}" MaxHeight="260"></ListBox></StackPanel>
</StackPanel></ScrollViewer>
</UserControl>