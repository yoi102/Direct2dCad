<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" x:Class="Direct2dCad.Avalonia.Views.Generated.SelectionFilterToolboxView" x:DataType="vm:SelectionFilterToolboxViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><Border IsVisible="{Binding HasDocument}"><StackPanel Spacing="3" Margin="0,3"><TextBlock Text="Types" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Types}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t4:SelectionFilterTypeItemViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /><CheckBox Content="IsEnabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
</Border></StackPanel></ScrollViewer>
</UserControl>