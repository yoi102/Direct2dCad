<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:t8="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" xmlns:t9="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" Classes="cadProperties" x:Class="Direct2dCad.Avalonia.Views.Generated.BlockReferencePropertyView" x:DataType="vm:BlockReferencePropertyViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="2" Margin="12,8" IsEnabled="{Binding IsEditable}"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Name}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding EntityName, Mode=TwoWay}" IsReadOnly="False" AutomationProperties.AutomationId="EntityNameInput" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Layers}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}" AutomationProperties.AutomationId="EntityLayerSelector"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:EntityLayerOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Expander Header="" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="2"><TextBlock Text="{Binding DefinitionLabel}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="Selected Definition" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding DefinitionOptions}" SelectedItem="{Binding SelectedDefinition, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:BlockDefinitionOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<TextBlock Text="{Binding EntitiesLabel}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="Definition Entity Count" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding DefinitionEntityCount, Mode=OneWay}" ShowStepper="False" IsReadOnly="True" /></Border></Grid>
<TextBlock Text="{Binding ReferencesLabel}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="Reference Count" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ReferenceCount, Mode=OneWay}" ShowStepper="False" IsReadOnly="True" /></Border></Grid>
</StackPanel></Expander>
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="X" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding PositionX, Mode=TwoWay}" FormatString="F3" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="Y" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding PositionY, Mode=TwoWay}" FormatString="F3" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Rotation}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding RotationDegrees, Mode=TwoWay}" Interval="1" FormatString="F2" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<TextBlock Text="{Binding ScaleXLabel}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc ScaleX}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ScaleX, Mode=TwoWay}" Minimum="-100000" Maximum="100000" FormatString="F3" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<TextBlock Text="{Binding ScaleYLabel}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc ScaleY}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ScaleY, Mode=TwoWay}" Minimum="-100000" Maximum="100000" FormatString="F3" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Border IsVisible="{Binding SupportsGeometryOrientation}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc RotationDegrees}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding GeometryRotationDegrees, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" AutomationProperties.AutomationId="EntityRotationInput" /></Border></Grid>
</Border><Expander Header="{local:Loc Advanced}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4" AutomationProperties.AutomationId="EntityAdvancedSettings"><StackPanel Spacing="2"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Id}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding EntityIdText, Mode=OneWay}" IsReadOnly="True" AutomationProperties.AutomationId="EntityIdDisplay" /></Border></Grid>
<CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Content="{local:Loc Visible}" /><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc DrawOrder}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ZIndex, Mode=TwoWay}" Interval="1" FormatString="F0" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Border IsVisible="{Binding HasCurveMeasurement}"><TextBlock ToolTip.Tip="{Binding CurveMeasurementDetail}" Text="{Binding CurveMeasurementDisplay}" TextWrapping="Wrap" />
</Border></StackPanel></Expander>
<Expander Header="{local:Loc Appearance}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="2"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc StrokeColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><Border><Border.IsEnabled><MultiBinding Converter="{x:Static local:CadColorEditorEnabledConverter.Instance}"><Binding Path="SupportsColorSourceSelection" /><Binding Path="IsExplicitColorSource" /><Binding Path="ColorControlsEnabled" /></MultiBinding></Border.IsEnabled><ColorPicker IsEnabled="{Binding ColorControlsEnabled}" Color="{Binding StrokeColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Border></Grid>
<Border IsVisible="{Binding SupportsColorSourceSelection}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc ColorSource}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding ColorSourceOptions}" SelectedItem="{Binding SelectedColorSourceOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:EntityColorSourceOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border><Border IsVisible="{Binding !SupportsColorSourceSelection}"><CheckBox IsChecked="{Binding UseByLayerColor, Mode=TwoWay}" Content="{local:Loc ByLayer}" /></Border><Border IsVisible="{Binding LineWeightControlsEnabled}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc LineWeight}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox IsEnabled="{Binding LineWeightControlsEnabled}" Value="{Binding LineWeight, Mode=TwoWay}" Minimum="0.01" Interval="0.05" FormatString="F3" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</Border><Border IsVisible="{Binding !LineWeightControlsEnabled}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc LineWeight}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding LineWeight, Mode=OneWay}" FormatString="F3" ShowStepper="False" IsReadOnly="True" /></Border></Grid>
</Border><CheckBox IsChecked="{Binding UseByLayerLineWeight, Mode=TwoWay}" Content="{local:Loc ByLayer}" /></StackPanel></Expander>
</StackPanel></ScrollViewer>
</UserControl>