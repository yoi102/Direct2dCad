<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.BlocksToolboxView" x:DataType="vm:BlocksToolboxViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><Border IsVisible="{Binding HasDocument}"><StackPanel Spacing="3" Margin="0,3"><TextBlock Text="{local:Loc Blocks}" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock, Mode=TwoWay}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t4:BlockItemViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding EntityCount}" TextWrapping="Wrap" /><TextBlock Text="{Binding ReferenceCount}" TextWrapping="Wrap" /><CheckBox Content="IsReadOnly" IsChecked="{Binding IsReadOnly, Mode=OneWay}" /><CheckBox Content="IsSystem" IsChecked="{Binding IsSystem, Mode=OneWay}" /><TextBlock Text="{Binding IdText}" TextWrapping="Wrap" /><TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Name" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
</Border><Button Command="{Binding InsertCommand}" Content="Insert " ToolTip.Tip="Insert " />
<Button Command="{Binding EditCommand}" Content="Edit " ToolTip.Tip="Edit " />
<Button Command="{Binding ExitEditCommand}" Content="Exit Edit " ToolTip.Tip="Exit Edit " />
<Button Command="{Binding DeleteCommand}" Content="Delete " ToolTip.Tip="Delete " />
</StackPanel></ScrollViewer>
</UserControl>