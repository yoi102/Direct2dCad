<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:t8="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" xmlns:t9="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:t10="clr-namespace:Direct2dCad.Application.Tools;assembly=Direct2dCad.Application" Classes="cadProperties" x:Class="Direct2dCad.Avalonia.Views.Generated.TransientPastePropertyView" x:DataType="vm:TransientPastePropertyViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="2" Margin="12,8" IsEnabled="{Binding IsEditable}"><TextBlock Text="{local:Loc Paste}" FontWeight="SemiBold" Margin="0,0,0,6" />
<TextBlock Text="{Binding EntityCount}" TextWrapping="Wrap" />
<Border IsVisible="{Binding HasBlockReferences}"><TextBlock Text="{Binding BlockReferenceCount}" TextWrapping="Wrap" />
</Border><Border IsVisible="{Binding HasBlockDefinitions}"><TextBlock Text="{Binding BlockDefinitionCount}" TextWrapping="Wrap" />
</Border><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc TargetLayer}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:EntityLayerOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</StackPanel></ScrollViewer>
</UserControl>