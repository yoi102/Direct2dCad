<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:t8="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.RenderingUserSettingsView" x:DataType="vm:RenderingUserSettingsViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc GraphicsDeviceMode}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding GraphicsDeviceModeOptions}" SelectedItem="{Binding SelectedGraphicsDeviceMode, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t8:GraphicsDeviceModeOption"><StackPanel Spacing="4"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc Antialiasing}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding IsAntialiasingEnabled, Mode=TwoWay}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc TextAntialiasing}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding IsTextAntialiasingEnabled, Mode=TwoWay}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ShowFramesPerSecond}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding ShowFramesPerSecond, Mode=TwoWay}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ZoomSnapshotPreview}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding IsZoomSnapshotPreviewEnabled, Mode=TwoWay}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ApproximateTileScaleFallback}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding AllowApproximateTileScaleFallback, Mode=TwoWay}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc LevelOfDetailOptimization}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding IsLevelOfDetailEnabled, Mode=TwoWay}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc BackgroundChunkRecording}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding IsBackgroundChunkRecordingEnabled, Mode=TwoWay}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ParallelRendering}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding IsParallelRenderingEnabled, Mode=TwoWay}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ParallelRenderingMode}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding ParallelRenderingModeOptions}" SelectedItem="{Binding SelectedParallelRenderingMode, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t8:ParallelRenderingModeOption"><StackPanel Spacing="4"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ParallelRenderingWorkerCount}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ParallelRenderingWorkerCount, Mode=TwoWay}" Minimum="2" Maximum="4" Interval="1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</StackPanel></ScrollViewer>
</UserControl>