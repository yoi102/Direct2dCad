<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.AiAssistantToolboxView" x:DataType="vm:AiAssistantToolboxViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" />
<Button Command="{Binding OpenSettingsCommand}" Content="{local:Loc Settings}" ToolTip.Tip="{local:Loc Settings}" />
<Button Command="{Binding ClearConversationCommand}" Content="{local:Loc ClearConversation}" ToolTip.Tip="{local:Loc ClearConversation}" />
<StackPanel Spacing="3" Margin="0,3"><TextBlock Text="{local:Loc Messages}" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Messages}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t4:AiChatItemViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding Content}" TextWrapping="Wrap" /><TextBlock Text="{Binding Role}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
<StackPanel Spacing="3" Margin="0,3"><TextBlock Text="Attachments" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Attachments}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t4:AiImageAttachmentViewModel"><StackPanel Spacing="4"><TextBox Text="{Binding SourceName, Mode=TwoWay}" PlaceholderText="SourceName" /><TextBox Text="{Binding DataUrl, Mode=TwoWay}" PlaceholderText="DataUrl" /><TextBox Text="{Binding TextContent, Mode=TwoWay}" PlaceholderText="TextContent" /><TextBox Text="{Binding ContentType, Mode=TwoWay}" PlaceholderText="ContentType" /><CheckBox Content="IsImage" IsChecked="{Binding IsImage, Mode=OneWay}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc ShortcutAiPromptScope}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding UserInput, Mode=TwoWay}" IsReadOnly="False" AutomationProperties.AutomationId="AiPromptInput" /></Border></Grid>
<Button Command="{Binding AddFileFromFileCommand}" Content="{local:Loc AiAttachImage}" ToolTip.Tip="{local:Loc AiAttachImage}" />
<Button Command="{Binding SendCommand}" Content="{local:Loc Send}" ToolTip.Tip="{local:Loc Send}" />
<Button Command="{Binding StopCommand}" Content="{local:Loc Stop}" ToolTip.Tip="{local:Loc Stop}" />
</StackPanel></ScrollViewer>
</UserControl>