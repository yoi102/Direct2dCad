<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:t8="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.InteractionUserSettingsView" x:DataType="vm:InteractionUserSettingsViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding SelectedEntityStrokeColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding SelectedEntityStrokeWidth, Mode=TwoWay}" Minimum="0.001" Interval="0.1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding GripStrokeColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc FillColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding GripFillColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc Size}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding GripSize, Mode=TwoWay}" Minimum="0.001" Interval="0.5" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding GripStrokeWidth, Mode=TwoWay}" Minimum="0.001" Interval="0.1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding GripPreviewStrokeColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc FillColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding GripPreviewFillColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding GripPreviewStrokeWidth, Mode=TwoWay}" Minimum="0.001" Interval="0.1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding SelectionWindowStrokeColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc FillColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding SelectionWindowFillColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding SelectionWindowStrokeWidth, Mode=TwoWay}" Minimum="0.001" Interval="0.1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding SelectionCrossingStrokeColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc FillColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding SelectionCrossingFillColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc StrokeWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding SelectionCrossingStrokeWidth, Mode=TwoWay}" Minimum="0.001" Interval="0.1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Expander Header="{local:Loc RadialMenu}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="4"></StackPanel></Expander>
</StackPanel></ScrollViewer>
</UserControl>