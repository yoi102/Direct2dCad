<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" x:Class="Direct2dCad.Avalonia.Views.Generated.AiAssistantSettingsDialog" x:DataType="vm:AiAssistantSettingsDialogViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><TextBlock Text="{local:Loc AiSettings}" FontWeight="SemiBold" Margin="0,4,0,8" />
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc AiProvider}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{x:Static local:EnumValues.AiAssistantProvider}" SelectedItem="{Binding Provider, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t3:AiAssistantProvider"><controls:CadEnumText Value="{Binding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Border IsVisible="{Binding IsLmStudio}"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc Endpoint}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding Endpoint, Mode=TwoWay}" IsReadOnly="False" /></Border></Grid>
</Border><Border IsVisible="{Binding IsLmStudio}"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc Model}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding LmStudioModels}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"></ComboBox></Border></Grid>
</Border><Button Command="{Binding RefreshModelsCommand}" Content="{local:Loc RefreshModels}" ToolTip.Tip="{local:Loc RefreshModels}" />
<Expander Header="{local:Loc Advanced}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="4"><Border IsVisible="{Binding IsLmStudio}"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc Temperature}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding Temperature, Mode=TwoWay}" Minimum="0" Maximum="2" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
</Border><Border IsVisible="{Binding IsLmStudio}"><TextBlock Text="{Binding Temperature}" TextWrapping="Wrap" />
</Border><Border IsVisible="{Binding IsLmStudio}"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ContextWindowTokens}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ContextWindowTokens, Mode=TwoWay}" Minimum="4096" Maximum="262144" Interval="4096" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</Border></StackPanel></Expander>
<Border IsVisible="{Binding IsCodex}"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc CodexExecutable}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding CodexExecutablePath, Mode=TwoWay}" IsReadOnly="False" /></Border></Grid>
</Border><Border IsVisible="{Binding IsCodex}"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc Model}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding CodexModels}" SelectedItem="{Binding SelectedCodexModel, Mode=TwoWay}"></ComboBox></Border></Grid>
</Border><Border IsVisible="{Binding IsCodex}"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ReasoningEffort}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding ReasoningEffortOptions}" SelectedItem="{Binding CodexReasoningEffort, Mode=TwoWay}"></ComboBox></Border></Grid>
</Border><Border IsVisible="{Binding IsCodex}"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc ServiceTier}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding ServiceTierOptions}" SelectedItem="{Binding CodexServiceTier, Mode=TwoWay}"></ComboBox></Border></Grid>
</Border><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc EnableCadAiTools}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><CheckBox IsChecked="{Binding EnableCadTools, Mode=TwoWay}" /></Border></Grid>
<Border IsVisible="{Binding HasConnectionStatus}"><TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" />
</Border></StackPanel></ScrollViewer>
</UserControl>