<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.DocumentOriginSettingsView" x:DataType="vm:DocumentOriginSettingsViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc OriginDisplayType}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{x:Static local:EnumValues.ViewModelCadOriginDisplayType}" SelectedItem="{Binding OriginDisplayType, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t6:ViewModelCadOriginDisplayType"><controls:CadEnumText Value="{Binding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc OriginMarkerType}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{x:Static local:EnumValues.ViewModelCadOriginMarkerType}" SelectedItem="{Binding OriginMarkerType, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t6:ViewModelCadOriginMarkerType"><controls:CadEnumText Value="{Binding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc OriginLinePattern}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{x:Static local:EnumValues.ViewModelCadOriginLinePattern}" SelectedItem="{Binding OriginLinePattern, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t6:ViewModelCadOriginLinePattern"><controls:CadEnumText Value="{Binding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc OriginColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding OriginColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc PositionX}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding OriginX, Mode=TwoWay}" Interval="1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc PositionY}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding OriginY, Mode=TwoWay}" Interval="1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc OriginSize}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding OriginSize, Mode=TwoWay}" Minimum="0.001" Interval="1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc OriginStrokeWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding OriginStrokeWidth, Mode=TwoWay}" Minimum="0.001" Interval="0.1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</StackPanel></ScrollViewer>
</UserControl>