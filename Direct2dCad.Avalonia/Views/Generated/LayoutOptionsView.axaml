<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Layouts;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:t8="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" xmlns:t9="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:t10="clr-namespace:Direct2dCad.Application.Tools;assembly=Direct2dCad.Application" xmlns:t11="clr-namespace:Direct2dCad.ViewModels.Layouts;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.LayoutOptionsView" x:DataType="vm:LayoutWorkspaceViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><CheckBox IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}" Content="Is Settings Open" /><Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc PaperWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding PaperWidth, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc PaperHeight}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding PaperHeight, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc MarginLeft}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding MarginLeft, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc MarginTop}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding MarginTop, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc MarginRight}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding MarginRight, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc MarginBottom}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding MarginBottom, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc PaperColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding PaperColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Viewport Left" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ViewportLeft, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Viewport Bottom" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ViewportBottom, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Viewport Width" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ViewportWidth, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Viewport Height" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ViewportHeight, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc ModelCenterX}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ModelCenterX, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc ModelCenterY}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ModelCenterY, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc ViewportScale}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ViewportScale, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Viewport Rotation Degrees" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ViewportRotationDegrees, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" /></Border></Grid>
<CheckBox IsChecked="{Binding IsViewportVisible, Mode=TwoWay}" Content="Is Viewport Visible" /><CheckBox IsChecked="{Binding IsViewportLocked, Mode=TwoWay}" Content="Is Viewport Locked" /><Button Command="{Binding AddLayoutCommand}" Content="{local:Loc AddLayout}" ToolTip.Tip="{local:Loc AddLayout}" />
<Button Command="{Binding DeleteLayoutCommand}" Content="{local:Loc DeleteLayout}" ToolTip.Tip="{local:Loc DeleteLayout}" />
<Button Command="{Binding ToggleSettingsCommand}" Content="Toggle Settings " ToolTip.Tip="Toggle Settings " />
<Button Command="{Binding SwapPaperOrientationCommand}" Content="Swap Paper Orientation " ToolTip.Tip="Swap Paper Orientation " />
<Button Command="{Binding AddViewportCommand}" Content="{local:Loc AddViewport}" ToolTip.Tip="{local:Loc AddViewport}" />
<Button Command="{Binding RemoveViewportCommand}" Content="Remove Viewport " ToolTip.Tip="Remove Viewport " />
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Current Viewport" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding CurrentViewportOptions}" SelectedItem="{Binding CurrentViewport, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t11:LayoutViewportItemViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="Selected Viewport" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding Viewports}" SelectedItem="{Binding SelectedViewport, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t11:LayoutViewportItemViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" />
</StackPanel></ScrollViewer>
</UserControl>