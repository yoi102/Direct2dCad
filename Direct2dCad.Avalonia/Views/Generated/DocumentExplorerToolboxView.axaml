<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.DocumentExplorerToolboxView" x:DataType="vm:DocumentExplorerToolboxViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><TextBlock Text="{local:Loc Documents}" FontWeight="SemiBold" Margin="0,4,0,8" />
<Button Command="{Binding RefreshCommand}" Content="{local:Loc Refresh}" ToolTip.Tip="{local:Loc Refresh}" />
<StackPanel Spacing="3" Margin="0,3"><TextBlock Text="{local:Loc Documents}" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}" AutomationProperties.AutomationId="DocumentExplorerList" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t4:DocumentExplorerItemViewModel"><StackPanel Spacing="4"><TextBox Text="{Binding DocumentName, Mode=TwoWay}" PlaceholderText="DocumentName" /><TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" /><CheckBox Content="IsModified" IsChecked="{Binding IsModified, Mode=OneWay}" /><TextBlock Text="{Binding DisplayPath}" TextWrapping="Wrap" /><TextBlock Text="{Binding ToolTipText}" TextWrapping="Wrap" /><TextBlock Text="{Binding IconKind}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
</StackPanel></ScrollViewer>
</UserControl>