<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.LayersToolboxView" x:DataType="vm:LayersToolboxViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><TextBlock Text="{local:Loc Layers}" FontWeight="SemiBold" Margin="0,4,0,8" />
<Button Command="{Binding AddLayerCommand}" Content="{local:Loc AddLayer}" ToolTip.Tip="{local:Loc AddLayer}" />
<Button Command="{Binding DeleteSelectedLayerCommand}" Content="{local:Loc DeleteLayer}" ToolTip.Tip="{local:Loc DeleteLayer}" />
<Button Command="{Binding RefreshCommand}" Content="{local:Loc Refresh}" ToolTip.Tip="{local:Loc Refresh}" />
<Border IsVisible="{Binding HasDocument}"><StackPanel Spacing="3" Margin="0,3"><TextBlock Text="{local:Loc Layers}" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}" AutomationProperties.AutomationId="LayersList" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t4:LayerItemViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding LayerIdText}" TextWrapping="Wrap" /><CheckBox Content="IsDefaultLayer" IsChecked="{Binding IsDefaultLayer, Mode=OneWay}" /><TextBlock Text="{Binding ToolTipText}" TextWrapping="Wrap" /><TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Name" /><CheckBox Content="IsVisible" IsChecked="{Binding IsVisible, Mode=TwoWay}" /><CheckBox Content="IsLocked" IsChecked="{Binding IsLocked, Mode=TwoWay}" /><CheckBox Content="IsFrozen" IsChecked="{Binding IsFrozen, Mode=TwoWay}" /><TextBox Text="{Binding LineWeight, Mode=TwoWay}" PlaceholderText="LineWeight" /><TextBox Text="{Binding Priority, Mode=TwoWay}" PlaceholderText="Priority" /><TextBlock Text="{Binding EntityCount}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
</Border></StackPanel></ScrollViewer>
</UserControl>