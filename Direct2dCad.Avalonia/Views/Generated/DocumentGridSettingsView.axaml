<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" x:Class="Direct2dCad.Avalonia.Views.Generated.DocumentGridSettingsView" x:DataType="vm:DocumentGridSettingsViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc GridType}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{x:Static local:EnumValues.ViewModelCadGridType}" SelectedItem="{Binding GridType, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t6:ViewModelCadGridType"><controls:CadEnumText Value="{Binding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Expander Header="{local:Loc GridDensity}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="4"><TextBlock Text="{local:Loc GridSpacingOptions}" FontWeight="SemiBold" Margin="0,4,0,8" />
<StackPanel Spacing="3" Margin="0,3"><TextBlock Text="Grid Spacing Presets" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding GridSpacingPresets}" SelectedItem="{Binding SelectedGridSpacingPreset, Mode=TwoWay}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t7:GridSpacingPresetItemViewModel"><StackPanel Spacing="4"><TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Name" /><TextBox Text="{Binding SpacingX, Mode=TwoWay}" PlaceholderText="SpacingX" /><TextBox Text="{Binding SpacingY, Mode=TwoWay}" PlaceholderText="SpacingY" /><CheckBox Content="LinkAxes" IsChecked="{Binding LinkAxes, Mode=TwoWay}" /><CheckBox Content="OpensGridSettings" IsChecked="{Binding OpensGridSettings, Mode=TwoWay}" /><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
<Button Command="{Binding AddGridSpacingPresetCommand}" Content="{local:Loc AddGridSpacingPreset}" ToolTip.Tip="{local:Loc AddGridSpacingPreset}" />
<Button Command="{Binding EditGridSpacingPresetCommand}" Content="{local:Loc EditGridSpacingPreset}" ToolTip.Tip="{local:Loc EditGridSpacingPreset}" />
<Button Command="{Binding MoveGridSpacingPresetUpCommand}" Content="{local:Loc MoveUp}" ToolTip.Tip="{local:Loc MoveUp}" />
<Button Command="{Binding MoveGridSpacingPresetDownCommand}" Content="{local:Loc MoveDown}" ToolTip.Tip="{local:Loc MoveDown}" />
<Button Command="{Binding DeleteGridSpacingPresetCommand}" Content="{local:Loc DeleteGridSpacingPreset}" ToolTip.Tip="{local:Loc DeleteGridSpacingPreset}" />
<TextBlock Text="{local:Loc GridSpacingSelection}" FontWeight="SemiBold" Margin="0,4,0,8" />
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc MajorGridSpacing}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding GridSpacingPresets}" SelectedItem="{Binding SelectedMajorGridPreset, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t7:GridSpacingPresetItemViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc MinorGridSpacing}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding GridSpacingPresets}" SelectedItem="{Binding SelectedMinorGridPreset, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t7:GridSpacingPresetItemViewModel"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc MinimumScreenSpacing}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding GridMinimumScreenSpacing, Mode=TwoWay}" Minimum="4" Maximum="200" Interval="1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</StackPanel></Expander>
<Expander Header="{local:Loc GridAppearance}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="4"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc MinorGridColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding GridMinorLineColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc MinorGridLineWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding GridMinorLineWidth, Mode=TwoWay}" Minimum="0.05" Maximum="10" Interval="0.05" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc MajorGridColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding GridMajorLineColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc MajorGridLineWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding GridMajorLineWidth, Mode=TwoWay}" Minimum="0.05" Maximum="10" Interval="0.05" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</StackPanel></Expander>
<Expander Header="{local:Loc SnapMarker}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="4"><Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc SnapMarkerType}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{x:Static local:EnumValues.ViewModelCadSnapMarkerType}" SelectedItem="{Binding SnapMarkerType, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t6:ViewModelCadSnapMarkerType"><controls:CadEnumText Value="{Binding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc SnapMarkerColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker Color="{Binding SnapMarkerColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc SnapMarkerLength}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding SnapMarkerLength, Mode=TwoWay}" Minimum="2" Maximum="200" Interval="1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="190,*" Margin="0,3"><TextBlock Text="{local:Loc SnapMarkerStrokeWidth}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding SnapMarkerStrokeWidth, Mode=TwoWay}" Minimum="0.1" Maximum="10" Interval="0.1" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</StackPanel></Expander>
</StackPanel></ScrollViewer>
</UserControl>