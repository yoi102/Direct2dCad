lignment="Center" MaxWidth="72" HorizontalAlignment="Center" /></StackPanel></StackPanel></Button>
<controls:CadRibbonDropDownButton AutomationProperties.AutomationId="NewDocumentButton" Width="80" Height="80" Padding="3" Margin="2" ToolTip.Tip="{local:Loc New}" AutomationProperties.Name="{local:Loc New}"><Button.Flyout><MenuFlyout Placement="Bottom"><MenuItem Header="{local:Loc BlankDrawing}" InputGesture="Ctrl+N" Command="{Binding NewCommand}" AutomationProperties.AutomationId="NewBlankDocumentMenuItem"></MenuItem>
