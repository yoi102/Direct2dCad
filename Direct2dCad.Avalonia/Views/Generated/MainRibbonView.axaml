<ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="DimDiameter" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=DimDiameter}" AutomationProperties.AutomationId="DimDiameterToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc DimDiameter}" AutomationProperties.Name="{local:Loc DimDiameter}"><Viewbox Width="26" Height="26"><Canvas Width="24" Height="24"><Path Data="M12,2A10,10 0 1,1 12,22A10,10 0 1,1 12,2" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeThickness="1.65" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" Opacity="0.4" /><Path Data="M4.7273,19.2727L19.2727,4.7273M13.8182,6.5455L19.2727,4.7273L17.4545,10.1818M6.5455,13.8182L4.7273,19.2727L10.1818,17.4545" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeThickness="1.2375" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /></Canvas></Viewbox></ToggleButton></WrapPanel>
<Border Width="1" Margin="10,2" Background="{DynamicResource MaterialBodyLightBrush}" Opacity="0.3" />
<WrapPanel Orientation="Horizontal" Width="43" Margin="2"><ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="DimAngular" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=DimAngular}" AutomationProperties.AutomationId="DimAngularToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc DimAngular}" AutomationProperties.Name="{local:Loc DimAngular}"><Viewbox Width="26" Height="26"><Canvas Width="24" Height="24"><Path Data="M2.4348,2L2.4348,22L21.5652,10.6957" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeThickness="1.65" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" Opacity="0.4" /><Path Data="M2.4348,8.9565A13.0435,13.0435 0 0,1 13.7391,15.4783M5.913,6.3478L2.4348,8.9565L5.913,11.5652M12.8696,10.6957L13.7391,15.4783L8.9565,16.3478" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeThickness="1.2375" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /></Canvas></Viewbox></ToggleButton>
<ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="Leader" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=Leader}" AutomationProperties.AutomationId="LeaderToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc Leader}" AutomationProperties.Name="{local:Loc Leader}"><Viewbox Width="26" Height="26"><Canvas Width="24" Height="24"><Path Data="M2,21.1304L12.4348,8.087L22,8.087M2.8696,15.0435L2,21.1304L8.087,18.5217M15.0435,2.8696L22,2.8696" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeThickness="1.65" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /></Canvas></Viewbox></ToggleButton></WrapPanel></StackPanel></ScrollViewer></TabItem></TabControl>
</UserControl>