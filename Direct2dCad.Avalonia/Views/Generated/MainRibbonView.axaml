<ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="PolarArray" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=PolarArray}" AutomationProperties.AutomationId="PolarArrayToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc PolarArray}" AutomationProperties.Name="{local:Loc PolarArray}"><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path StrokeThickness="1.3" Opacity="0.4" Data="M 16,5 A 11,11 0 1 1 16,27 A 11,11 0 1 1 16,5" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /><Path Data="M 13,16 H 19 M 16,13 V 19" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><Ellipse Width="5" Height="5" Canvas.Left="13.5" Canvas.Top="2.5" Fill="{DynamicResource CadRibbonAccentBrush}" /><Ellipse Width="5" Height="5" Canvas.Left="24.5" Canvas.Top="13.5" Fill="{DynamicResource CadRibbonAccentBrush}" /><Ellipse Width="5" Height="5" Canvas.Left="13.5" Canvas.Top="24.5" Fill="{DynamicResource CadRibbonAccentBrush}" /><Ellipse Width="5" Height="5" Canvas.Left="2.5" Canvas.Top="13.5" Fill="{DynamicResource CadRibbonAccentBrush}" /></Canvas></Viewbox></ToggleButton></WrapPanel>
<Border Width="1" Margin="10,2" Background="{DynamicResource MaterialBodyLightBrush}" Opacity="0.3" />
<WrapPanel Orientation="Horizontal" Width="86" Margin="2"><Button Command="{Binding CurrentEditorTabViewModel.BooleanUnionCommand}" AutomationProperties.AutomationId="BooleanUnionToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc BooleanUnion}" AutomationProperties.Name="{local:Loc BooleanUnion}"><Viewbox Width="26" Height="26"><Canvas Width="28" Height="28"><Path Data="M 3,3 H 19 V 19 H 3 Z M 9,9 H 25 V 25 H 9 Z" StrokeThickness="1.2" Opacity="0.45" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /><Path Data="M 3,3 H 19 V 9 H 25 V 25 H 9 V 19 H 3 Z" Opacity="0.75" Fill="{DynamicResource CadRibbonAccentBrush}" /></Canvas></Viewbox></Button>
<Button Command="{Binding CurrentEditorTabViewModel.BooleanIntersectionCommand}" AutomationProperties.AutomationId="BooleanIntersectionToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc BooleanIntersection}" AutomationProperties.Name="{local:Loc BooleanIntersection}"><Viewbox Width="26" Height="26"><Canvas Width="28" Height="28"><Path Data="M 3,3 H 19 V 19 H 3 Z M 9,9 H 25 V 25 H 9 Z" StrokeThickness="1.2" Opacity="0.45" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /><Path Data="M 9,9 H 19 V 19 H 9 Z" Opacity="0.75" Fill="{DynamicResource CadRibbonAccentBrush}" /></Canvas></Viewbox></Button>
<Button Command="{Binding CurrentEditorTabViewModel.BooleanDifferenceCommand}" AutomationProperties.AutomationId="BooleanDifferenceToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc BooleanDifference}" AutomationProperties.Name="{local:Loc BooleanDifference}"><Viewbox Width="26" Height="26"><Canvas Width="28" Height="28"><Path Data="M 3,3 H 19 V 19 H 3 Z M 9,9 H 25 V 25 H 9 Z" StrokeThickness="1.2" Opacity="0.45" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /><Path Data="M 3,3 H 19 V 9 H 9 V 19 H 3 Z" Opacity="0.75" Fill="{DynamicResource CadRibbonAccentBrush}" /></Canvas></Viewbox></Button></WrapPanel></StackPanel></ScrollViewer></TabItem>
<TabItem Header="{local:Loc Dimension}"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False"><StackPanel Orientation="Horizontal" Margin="2"><WrapPanel Orientation="Horizontal" Width="86" Margin="2"><ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="DimLinearX" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=DimLinearX}" AutomationProperties.AutomationId="DimLinearXToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc DimLinearX}" AutomationProperties.Name="{local:Loc DimLinearX}"><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path Data="M 5,8 H 27" Opacity="0.4" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><Path StrokeThickness="1.5" Data="M 5,13 V 29 M 27,13 V 29 M 5,23 H 27 M 10,19 L 5,23 L 10,27 M 22,19 L 27,23 L 22,27" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /></Canvas></Viewbox></ToggleButton>
<ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="DimLinearY" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=DimLinearY}" AutomationProperties.AutomationId="DimLinearYToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc DimLinearY}" AutomationProperties.Name="{local:Loc DimLinearY}"><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path Data="M 24,5 V 27" Opacity="0.4" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><Path StrokeThickness="1.5" Data="M 3,5 H 19 M 3,27 H 19 M 9,5 V 27 M 5,10 L 9,5 L 13,10 M 5,22 L 9,27 L 13,22" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /></Canvas></Viewbox></ToggleButton>
<ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="DimAligned" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=DimAligned}" AutomationProperties.AutomationId="DimAlignedToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc DimAligned}" AutomationProperties.Name="{local:Loc DimAligned}"><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path StrokeThickness="1.5" Data="M 2,21 L 10,29 M 21,3 L 29,11 M 6,25 L 25,6 M 8,18 L 6,25 L 13,23 M 18,8 L 25,6 L 23,13" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /></Canvas></Viewbox></ToggleButton></WrapPanel>
<Border Width="1" Margin="10,2" Background="{DynamicResource MaterialBodyLightBrush}" Opacity="0.3" />
<WrapPanel Orientation="Horizontal" Width="43" Margin="2"><ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="DimRadius" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=DimRadius}" AutomationProperties.AutomationId="DimRadiusToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc DimRadius}" AutomationProperties.Name="{local:Loc DimRadius}"><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path Opacity="0.4" Data="M 16,5 A 11,11 0 1 1 16,27 A 11,11 0 1 1 16,5" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><Path StrokeThickness="1.5" Data="M 16,16 L 24,8 M 18,10 L 24,8 L 22,14" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /><Ellipse Width="4" Height="4" Canvas.Left="14" Canvas.Top="14" Fill="{DynamicResource CadRibbonAccentBrush}" /></Canvas></Viewbox></ToggleButton>
<ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="DimDiameter" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=DimDiameter}" AutomationProperties.AutomationId="DimDiameterToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc DimDiameter}" AutomationProperties.Name="{local:Loc DimDiameter}"><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path Opacity="0.4" Data="M 16,5 A 11,11 0 1 1 16,27 A 11,11 0 1 1 16,5" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><Path StrokeThickness="1.5" Data="M 8,24 L 24,8 M 18,10 L 24,8 L 22,14 M 10,18 L 8,24 L 14,22" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /></Canvas></Viewbox></ToggleButton></WrapPanel>
<Border Width="1" Margin="10,2" Background="{DynamicResource MaterialBodyLightBrush}" Opacity="0.3" />
<WrapPanel Orientation="Horizontal" Width="43" Margin="2"><ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="DimAngular" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=DimAngular}" AutomationProperties.AutomationId="DimAngularToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc DimAngular}" AutomationProperties.Name="{local:Loc DimAngular}"><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path Data="M 6,4 V 27 L 28,14" Opacity="0.4" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><Path StrokeThickness="1.5" Data="M 6,12 A 15,15 0 0 1 19,19.5 M 10,9 L 6,12 L 10,15 M 18,14 L 19,19.5 L 13.5,20.5" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" /></Canvas></Viewbox></ToggleButton>
<ToggleButton Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}" CommandParameter="Leader" IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static local:CadToolSelectionConverter.Instance}, ConverterParameter=Leader}" AutomationProperties.AutomationId="LeaderToolButton" Width="34" Height="34" Padding="3" Margin="2" ToolTip.Tip="{local:Loc Leader}" AutomationProperties.Name="{local:Loc Leader}"><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path Data="M 5,27 L 17,12 H 28 M 6,20 L 5,27 L 12,24 M 20,6 H 28" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /></Canvas></Viewbox></ToggleButton></WrapPanel></StackPanel></ScrollViewer></TabItem></TabControl>
</UserControl>