<MenuItem Header="A3 · mm · 1:100" Command="{Binding NewTemplateCommand}" CommandParameter="A3-100" AutomationProperties.AutomationId="NewA3TemplateButton"><MenuItem.Icon><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path Data="M 3,7 H 23 L 29,13 V 26 H 3 Z M 23,7 V 13 H 29" Stroke="{DynamicResource MaterialBodyBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><TextBlock Canvas.Left="8" Canvas.Top="15" Text="A3" FontSize="10" FontWeight="SemiBold" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
<MenuItem Header="Letter · in · 1:1" Command="{Binding NewTemplateCommand}" CommandParameter="Letter" AutomationProperties.AutomationId="NewLetterTemplateButton"><MenuItem.Icon><Viewbox Width="26" Height="26"><Canvas Width="32" Height="32"><Path Data="M 6,4 H 21 L 27,10 V 28 H 6 Z M 21,4 V 10 H 27" Stroke="{DynamicResource MaterialBodyBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><TextBlock Canvas.Left="11" Canvas.Top="15" Text="LT" FontSize="10" FontWeight="SemiBold" /></Canvas></Viewbox></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout><StackPanel Spacing="5" HorizontalAlignment="Center"><Viewbox Width="50" Height="50"><Canvas Width="32" Height="32"><Path Data="M 7,3 H 21 L 26,8 V 29 H 7 Z M 21,3 V 8 H 26" Stroke="{DynamicResource CadRibbonAccentBrush}" StrokeJoin="Round" StrokeLineCap="Round" StrokeThickness="2" Fill="Transparent" /><TextBlock Canvas.Left="10" Canvas.Top="14" Text="A4" FontSize="10" FontWeight="SemiBold" /></Canvas></Viewbox><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2"><TextBlock Text="{local:Loc New}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="72" HorizontalAlignment="Center" /><TextBlock Text="▾" /></StackPanel></StackPanel></controls:CadRibbonDropDownButton>
