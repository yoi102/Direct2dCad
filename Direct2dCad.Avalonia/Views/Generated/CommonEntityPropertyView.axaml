<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:t8="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" xmlns:t9="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:t10="clr-namespace:Direct2dCad.Application.Tools;assembly=Direct2dCad.Application" Classes="cadProperties" x:Class="Direct2dCad.Avalonia.Views.Generated.CommonEntityPropertyView" x:DataType="vm:CommonEntityPropertyViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="2" Margin="12,8" IsEnabled="{Binding IsEditable}"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Name}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding EntityName, Mode=TwoWay}" IsReadOnly="False" AutomationProperties.AutomationId="EntityNameInput" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Layers}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}" AutomationProperties.AutomationId="EntityLayerSelector"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:EntityLayerOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Border IsVisible="{Binding IsRegion}"><TextBlock Text="{Binding RegionSummary}" TextWrapping="Wrap" />
</Border><Border IsVisible="{Binding SupportsGeometryOrientation}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc RotationDegrees}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding GeometryRotationDegrees, Mode=TwoWay}" ShowStepper="False" IsReadOnly="False" AutomationProperties.AutomationId="EntityRotationInput" /></Border></Grid>
</Border><Expander Header="{local:Loc Advanced}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4" AutomationProperties.AutomationId="EntityAdvancedSettings"><StackPanel Spacing="2"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Id}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding EntityIdText, Mode=OneWay}" IsReadOnly="True" AutomationProperties.AutomationId="EntityIdDisplay" /></Border></Grid>
<CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Content="{local:Loc Visible}" /><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc DrawOrder}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ZIndex, Mode=TwoWay}" Interval="1" FormatString="F0" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Border IsVisible="{Binding HasCurveMeasurement}"><TextBlock ToolTip.Tip="{Binding CurveMeasurementDetail}" Text="{Binding CurveMeasurementDisplay}" TextWrapping="Wrap" />
</Border></StackPanel></Expander>
<Expander Header="{local:Loc Appearance}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="2"><Border IsVisible="{Binding SupportsStrokeAppearance}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc StrokeColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><Border><Border.IsEnabled><MultiBinding Converter="{x:Static local:CadColorEditorEnabledConverter.Instance}"><Binding Path="SupportsColorSourceSelection" /><Binding Path="IsExplicitColorSource" /><Binding Path="ColorControlsEnabled" /></MultiBinding></Border.IsEnabled><ColorPicker IsEnabled="{Binding ColorControlsEnabled}" Color="{Binding StrokeColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Border></Grid>
</Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding SupportsColorSourceSelection}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc ColorSource}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding ColorSourceOptions}" SelectedItem="{Binding SelectedColorSourceOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:EntityColorSourceOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border></Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding !SupportsColorSourceSelection}"><CheckBox IsChecked="{Binding UseByLayerColor, Mode=TwoWay}" Content="{local:Loc ByLayer}" /></Border></Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding LineWeightControlsEnabled}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc LineWeight}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox IsEnabled="{Binding LineWeightControlsEnabled}" Value="{Binding LineWeight, Mode=TwoWay}" Minimum="0.01" Interval="0.05" FormatString="F3" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</Border></Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding !LineWeightControlsEnabled}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc LineWeight}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding LineWeight, Mode=OneWay}" FormatString="F3" ShowStepper="False" IsReadOnly="True" /></Border></Grid>
</Border></Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><CheckBox IsChecked="{Binding UseByLayerLineWeight, Mode=TwoWay}" Content="{local:Loc ByLayer}" /></Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding SupportsStrokeStyle}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc DashStyle}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding StrokeDashStyleOptions}" SelectedItem="{Binding SelectedDashStyleOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:StrokeDashStyleOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border></Border><Expander Header="{local:Loc AdvancedStroke}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="2"><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding SupportsStrokeStyle}"><Border IsVisible="{Binding SupportsStartEndCaps}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc StartCap}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding StrokeCapOptions}" SelectedItem="{Binding SelectedStartCapOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:StrokeCapOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border></Border></Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding SupportsStrokeStyle}"><Border IsVisible="{Binding SupportsStartEndCaps}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc EndCap}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding StrokeCapOptions}" SelectedItem="{Binding SelectedEndCapOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:StrokeCapOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border></Border></Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding SupportsStrokeStyle}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc DashCap}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding StrokeCapOptions}" SelectedItem="{Binding SelectedDashCapOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:StrokeCapOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border></Border><Border IsVisible="{Binding SupportsStrokeAppearance}"><Border IsVisible="{Binding SupportsStrokeStyle}"><Border IsVisible="{Binding SupportsLineJoin}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc LineJoin}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding StrokeLineJoinOptions}" SelectedItem="{Binding SelectedLineJoinOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t9:StrokeLineJoinOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border></Border></Border></StackPanel></Expander>
</StackPanel></Expander>
<Expander Header="{local:Loc Fill}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4" AutomationProperties.AutomationId="EntityFillSettings"><StackPanel Spacing="2"><Border IsVisible="{Binding IsRegion}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Fill}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox IsEnabled="{Binding FillControlsEnabled}" ItemsSource="{Binding FillStyleOptions}" SelectedItem="{Binding SelectedFillStyleOption, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t10:FillStyleOption"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
</Border><Border IsVisible="{Binding IsRegion}"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc FillColor}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ColorPicker IsEnabled="{Binding FillColorControlsEnabled}" Color="{Binding FillColor, Mode=TwoWay, Converter={x:Static local:CadColorConverter.Instance}}" /></Border></Grid>
</Border></StackPanel></Expander>
</StackPanel></ScrollViewer>
</UserControl>