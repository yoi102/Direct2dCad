<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" x:Class="Direct2dCad.Avalonia.Views.Generated.CadEditParametersView" x:DataType="vm:CadDocumentViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><TextBlock ToolTip.Tip="{Binding EditKeyboardHint}" Text="{Binding CurrentToolNameDisplay}" TextWrapping="Wrap" />
<Border IsVisible="{Binding HasCornerParameters}"><CheckBox IsChecked="{Binding EditWholePolyline, Mode=TwoWay}" Content="{local:Loc EditWholePolyline}" AutomationProperties.AutomationId="EditWholePolylineToggle" /></Border><Border IsVisible="{Binding HasCornerParameters}"><CheckBox IsEnabled="{Binding CanChangeCornerTrim}" IsChecked="{Binding TrimCornerLines, Mode=TwoWay}" Content="{local:Loc TrimCornerLines}" AutomationProperties.AutomationId="EditTrimCornerToggle" /></Border><TextBlock Text="{Binding EditInstruction}" TextWrapping="Wrap" AutomationProperties.AutomationId="EditStepPrompt" />
<TextBlock ToolTip.Tip="{Binding EditErrorDetail}" Text="{Binding EditFeedback}" TextWrapping="Wrap" AutomationProperties.AutomationId="EditFeedback" />
</StackPanel></ScrollViewer>
</UserControl>