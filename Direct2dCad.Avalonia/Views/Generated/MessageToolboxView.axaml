<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" x:Class="Direct2dCad.Avalonia.Views.Generated.MessageToolboxView" x:DataType="vm:MessageToolboxViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="4" Margin="12,8"><Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc SearchMessages}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding SearchText, Mode=TwoWay}" IsReadOnly="False" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,3"><TextBlock Text="{local:Loc MessageLevel}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><ComboBox ItemsSource="{x:Static local:EnumValues.CadMessageLevel}" SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="t5:CadMessageLevel"><controls:CadEnumText Value="{Binding .}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Border></Grid>
<Button Command="{Binding ClearMessagesCommand}" Content="{local:Loc ClearMessages}" ToolTip.Tip="{local:Loc ClearMessages}" />
<StackPanel Spacing="3" Margin="0,3"><TextBlock Text="Visible Entries" Opacity="0.7" FontSize="12" /><ListBox ItemsSource="{Binding VisibleEntries}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="t5:CadMessageEntry"><StackPanel Spacing="4"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /><TextBox Text="{Binding Source, Mode=TwoWay}" PlaceholderText="Source" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
</StackPanel></ScrollViewer>
</UserControl>