<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" xmlns:local="clr-namespace:Direct2dCad.Avalonia" xmlns:controls="clr-namespace:Direct2dCad.Avalonia.Controls" xmlns:t0="clr-namespace:Direct2dCad.Db.Cad.Settings;assembly=Direct2dCad.Db" xmlns:t1="clr-namespace:Direct2dCad.Db.Data.Text;assembly=Direct2dCad.Db" xmlns:t2="clr-namespace:Direct2dCad.Db.Data.Entities;assembly=Direct2dCad.Db" xmlns:t3="clr-namespace:Direct2dCad.AI.Contracts;assembly=Direct2dCad.AI.Contracts" xmlns:t4="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels" xmlns:t5="clr-namespace:Direct2dCad.ViewModels.Services.Platform.Notifications;assembly=Direct2dCad.ViewModels.Services" xmlns:t6="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels.Abstractions" xmlns:t7="clr-namespace:Direct2dCad.ViewModels.Settings;assembly=Direct2dCad.ViewModels" xmlns:t8="clr-namespace:Direct2dCad.ViewModels.Settings.UserSettings;assembly=Direct2dCad.ViewModels" xmlns:t9="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels" Classes="cadProperties" x:Class="Direct2dCad.Avalonia.Views.Generated.BlockDefinitionPropertyView" x:DataType="vm:BlockDefinitionPropertyViewModel" x:CompileBindings="True">
<ScrollViewer><StackPanel Spacing="2" Margin="12,8" IsEnabled="{Binding IsEditable}"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
<Expander Header="" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="2"><Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="X" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding BasePointX, Mode=TwoWay}" FormatString="F3" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
<Button Command="{Binding ApplyBasePointCommand}" Content="Apply Base Point " ToolTip.Tip="Apply Base Point " />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="Y" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding BasePointY, Mode=TwoWay}" FormatString="F3" ShowStepper="True" IsReadOnly="False" /></Border></Grid>
</StackPanel></Expander>
<Expander Header="{local:Loc Information}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2,0,4"><StackPanel Spacing="2"><TextBlock Text="{Binding NameLabel}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="{local:Loc Name}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding Name, Mode=OneWay}" IsReadOnly="True" /></Border></Grid>
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="ID" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><TextBox Text="{Binding BlockIdText, Mode=OneWay}" IsReadOnly="True" /></Border></Grid>
<TextBlock Text="{Binding EntitiesLabel}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="Entity Count" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding EntityCount, Mode=OneWay}" ShowStepper="False" IsReadOnly="True" /></Border></Grid>
<TextBlock Text="{Binding ReferencesLabel}" TextWrapping="Wrap" />
<Grid ColumnDefinitions="84,*" Margin="0,1"><TextBlock Text="Reference Count" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" /><Border Grid.Column="1"><controls:CadPropertyNumberBox Value="{Binding ReferenceCount, Mode=OneWay}" ShowStepper="False" IsReadOnly="True" /></Border></Grid>
</StackPanel></Expander>
</StackPanel></ScrollViewer>
</UserControl>