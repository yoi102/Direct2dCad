  <assembly fullname="Direct2dCad.Commands" preserve="all" />
  <assembly fullname="Direct2dCad.Editor" preserve="all" />
  <assembly fullname="SharpGen.Runtime" preserve="all" />
  <!-- Explicit compiled columns handle values. DataGrid additionally queries this
       single row type's property metadata for read-only detection and sorting. -->
  <assembly fullname="Direct2dCad.ViewModels">
    <type fullname="Direct2dCad.ViewModels.Toolboxes.EntityProperty.PolylineVertexPropertyViewModel" preserve="all" />
  </assembly>
</linker>
