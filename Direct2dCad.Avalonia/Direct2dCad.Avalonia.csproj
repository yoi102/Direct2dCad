<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Direct2dCad.wpf/Direct2dCad.ico</ApplicationIcon>
    <AssemblyName>Direct2dCad.Avalonia</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Win32" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Material.Avalonia" Version="3.19.0" />
    <PackageReference Include="Material.Avalonia.DataGrid" Version="3.19.0" />
    <PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <ProjectReference Include="../Direct2dCad.ViewModels/Direct2dCad.ViewModels.csproj" />
    <ProjectReference Include="../Direct2dCad.AI.LmStudio/Direct2dCad.AI.LmStudio.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.6.26359.118" />
    <ProjectReference Include="../Direct2dCad.Rendering.Direct2D/Direct2dCad.Rendering.Direct2D.csproj" />
    <ProjectReference Include="../Direct2dCad.Windows.Interop/Direct2dCad.Windows.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="NativeRoots.xml" />
  </ItemGroup>
</Project>

