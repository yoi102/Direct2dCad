<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Direct2dCad.wpf/Direct2dCad.ico</ApplicationIcon>
    <AssemblyName>Direct2dCad.Avalonia</AssemblyName>
    <Version>0.1.9</Version>
    <AssemblyVersion>0.1.9</AssemblyVersion>
    <FileVersion>0.1.9</FileVersion>
    <InformationalVersion>0.1.9</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Direct2dCad.Mcp/Direct2dCad.Mcp.csproj" />
    <AvaloniaResource Include="Assets/**" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Material.Avalonia" Version="3.21.0" />
    <PackageReference Include="Material.Avalonia.DataGrid" Version="3.21.0" />
    <PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.5" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.5" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <ProjectReference Include="../Direct2dCad.ViewModels/Direct2dCad.ViewModels.csproj" />
    <ProjectReference Include="../Direct2dCad.AI.LmStudio/Direct2dCad.AI.LmStudio.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <ProjectReference Include="../Direct2dCad.Rendering.Direct2D/Direct2dCad.Rendering.Direct2D.csproj" />
    <ProjectReference Include="../Direct2dCad.Windows.Interop/Direct2dCad.Windows.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="NativeRoots.xml" />
  </ItemGroup>
  <Target Name="IncludeProjectSatelliteAssembliesInNativeAot"
          AfterTargets="_ComputeIlcCompileInputs" Condition="'$(PublishAot)' == 'true'">
    <!-- .NET 11 omits AssetType on project-reference satellites. Include their localized resources in ILC. -->
    <ItemGroup>
      <IlcSatelliteAssembly Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.ReferenceSourceTarget)' == 'ProjectReference' and
                     '%(ResolvedFileToPublish.Extension)' == '.dll' and
                     $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').EndsWith('.resources')) and
                     '%(ResolvedFileToPublish.AssetType)' != 'resources'" />
    </ItemGroup>
  </Target>
</Project>

