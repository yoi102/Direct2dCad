<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Direct2dCad.wpf/Direct2dCad.ico</ApplicationIcon>
    <AssemblyName>Direct2dCad.Avalonia</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Direct2dCad.Desktop/Direct2dCad.Desktop.csproj" />
    <ProjectReference Include="../Direct2dCad.Mcp/Direct2dCad.Mcp.csproj" />
    <AvaloniaResource Include="Assets/**" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Material.Avalonia" />
    <PackageReference Include="Material.Avalonia.DataGrid" />
    <PackageReference Include="DialogHost.Avalonia" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Headless" />
    <ProjectReference Include="../Direct2dCad.ViewModels/Direct2dCad.ViewModels.csproj" />
    <ProjectReference Include="../Direct2dCad.AI.LmStudio/Direct2dCad.AI.LmStudio.csproj" />
    <ProjectReference Include="../Direct2dCad.Agent.Codex/Direct2dCad.Agent.Codex.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../Direct2dCad.Rendering.Direct2D/Direct2dCad.Rendering.Direct2D.csproj" />
    <ProjectReference Include="../Direct2dCad.Windows.Interop/Direct2dCad.Windows.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="NativeRoots.xml" />
  </ItemGroup>
  <Target Name="IncludeProjectSatelliteAssembliesInNativeAot"
          AfterTargets="_ComputeIlcCompileInputs" Condition="'$(PublishAot)' == 'true'">
    <!-- .NET 11 omits AssetType on project-reference satellites. Include their localized resources in ILC. -->
    <ItemGroup>
      <IlcSatelliteAssembly Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.ReferenceSourceTarget)' == 'ProjectReference' and
                     '%(ResolvedFileToPublish.Extension)' == '.dll' and
                     $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').EndsWith('.resources')) and
                     '%(ResolvedFileToPublish.AssetType)' != 'resources'" />
    </ItemGroup>
  </Target>
</Project>

