<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Direct2dCad.Avalonia" xmlns:assists="using:Material.Styles.Assists">
  <!-- Library templates own popup, focus, keyboard and color editing behavior. -->
  <Style Selector="ComboBox">
    <Setter Property="Theme"><ControlTheme TargetType="ComboBox" BasedOn="{StaticResource MaterialOutlineComboBox}" /></Setter>
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource MaterialSelectionBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="6,2" /><Setter Property="ContextFlyout" Value="{x:Null}" />
  </Style>
  <Style Selector="ComboBox:not(:disabled) /template/ Grid#PART_RootBorder, ComboBox:disabled /template/ Grid#PART_RootBorder"><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="28" /></Style>
  <Style Selector="ComboBox:not(:disabled) /template/ ContentPresenter#contentPresenter, ComboBox:disabled /template/ ContentPresenter#contentPresenter"><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="6,2" /></Style>
  <Style Selector="ComboBox:not(:disabled) /template/ Border#splitBorder, ComboBox:disabled /template/ Border#splitBorder"><Setter Property="Margin" Value="6,2" /></Style>
  <Style Selector="StackPanel.statusControls ComboBox:not(:disabled) /template/ Grid#PART_RootBorder, StackPanel.statusControls ComboBox:disabled /template/ Grid#PART_RootBorder"><Setter Property="Height" Value="24" /></Style>
  <Style Selector="ComboBox /template/ Border#watermarkRoot"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="ComboBoxItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="6,4" /><Setter Property="MinHeight" Value="32" /><Setter Property="Height" Value="32" /></Style>
  <Style Selector="MenuItem"><Setter Property="FontSize" Value="12" /><Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,0" /></Style>
  <Style Selector="Menu Separator, ContextMenu Separator, MenuFlyoutPresenter Separator"><Setter Property="Height" Value="1" /><Setter Property="Margin" Value="0,4" /></Style>
  <Style Selector="ColorPicker">
    <Setter Property="Height" Value="28" /><Setter Property="Width" Value="NaN" /><Setter Property="MinWidth" Value="100" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="3" />
    <Setter Property="Content"><Template>
      <Grid ColumnDefinitions="20,*" Margin="6,0">
        <Border Classes="cadColorSwatch" Width="14" Height="14" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{TemplateBinding Color, Converter={x:Static local:CadColorPreviewBrushConverter.Instance}}" />
        <TextBlock Classes="cadColorLabel" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MaterialBodyBrush}" Text="{TemplateBinding Color, Converter={x:Static local:CadColorPreviewTextConverter.Instance}}" />
      </Grid>
    </Template></Setter>
  </Style>
  <Style Selector="ColorPicker /template/ DropDownButton">
    <Setter Property="Theme"><ControlTheme TargetType="DropDownButton" BasedOn="{StaticResource MaterialOutlineDropDownButton}" /></Setter>
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource MaterialSelectionBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" /><Setter Property="MinHeight" Value="28" /><Setter Property="Margin" Value="0" /><Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
  </Style>
  <Style Selector="ColorPicker /template/ DropDownButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Padding" Value="0,2" /></Style>
</Styles>
