<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:assists="using:Material.Styles.Assists">
  <!-- Preserve Material templates, input behavior and dynamic theme brushes. -->
  <Style Selector=".cadProperties TextBox">
    <Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="6,2" /><Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=".cadProperties TextBox /template/ Panel#PART_TextContainer"><Setter Property="Margin" Value="2,1" /></Style>
  <Style Selector=".cadProperties ComboBox"><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="6,2" /></Style>
  <Style Selector=".cadProperties ComboBox /template/ Panel#PART_RootPanel"><Setter Property="Height" Value="28" /></Style>
  <Style Selector=".cadProperties ComboBox /template/ Border#splitBorder"><Setter Property="Margin" Value="6,2" /></Style>
  <Style Selector=".cadProperties Expander"><Setter Property="FontSize" Value="12" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource MaterialSelectionBrush}" /><Setter Property="BorderThickness" Value="0,1,0,0" /><Setter Property="Padding" Value="0,3" /><Setter Property="CornerRadius" Value="0" /><Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" /></Style>
  <Style Selector=".cadProperties Expander /template/ ToggleButton#PART_ToggleButton">
    <Setter Property="Theme"><ControlTheme TargetType="ToggleButton" BasedOn="{StaticResource DownExpanderToggleButtonPart}" /></Setter>
    <Setter Property="MinHeight" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="0,2" /><Setter Property="Background" Value="Transparent" /><Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
  </Style>
  <Style Selector=".cadProperties Expander /template/ ToggleButton#PART_ToggleButton /template/ Path#PART_ExpandIcon"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /></Style>
  <Style Selector=".cadProperties Expander /template/ ToggleButton#PART_ToggleButton /template/ Border#PART_RootBorder"><Setter Property="Padding" Value="0,2" /></Style>
  <Style Selector=".cadProperties Expander /template/ ToggleButton#PART_ToggleButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="TextBlock.FontSize" Value="12" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector=".cadProperties CheckBox"><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="0,2" /></Style>
</Styles>
