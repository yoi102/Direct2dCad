<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:material="clr-namespace:Material.Styles.Themes;assembly=Material.Styles" xmlns:grid="clr-namespace:Material.Avalonia.DataGrid;assembly=Material.Avalonia.DataGrid" xmlns:dialog="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia" xmlns:dock="using:Dock.Avalonia.Controls" xmlns:local="using:Direct2dCad.Avalonia" xmlns:dmc="using:Dock.Model.Controls" x:Class="Direct2dCad.Avalonia.App">
  <Application.Resources>
    <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="#3879B8" />
    <x:Double x:Key="DockTargetSelectorSize">34</x:Double>
    <x:Double x:Key="DockTargetSelectorGridMaxSize">122</x:Double>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml" />
    <Style Selector="dock|DockTarget /template/ Image#PART_LeftSelector"><Setter Property="Source" Value="{x:Static local:CadDockGuideImages.Left}" /></Style>
    <Style Selector="dock|DockTarget /template/ Image#PART_RightSelector"><Setter Property="Source" Value="{x:Static local:CadDockGuideImages.Right}" /></Style>
    <Style Selector="dock|DockTarget /template/ Image#PART_TopSelector"><Setter Property="Source" Value="{x:Static local:CadDockGuideImages.Top}" /></Style>
    <Style Selector="dock|DockTarget /template/ Image#PART_BottomSelector"><Setter Property="Source" Value="{x:Static local:CadDockGuideImages.Bottom}" /></Style>
    <Style Selector="dock|DockTarget /template/ Image#PART_CenterSelector"><Setter Property="Source" Value="{x:Static local:CadDockGuideImages.Tabs}" /></Style>
    <!-- Fluent provides ColorPicker and icon fallbacks; Material owns the core control themes. -->
    <material:CustomMaterialTheme BaseTheme="Inherit" PrimaryColor="#673AB7" SecondaryColor="#9C27B0" />
    <dialog:DialogHostStyles />
    <Style Selector="dialog|DialogHost"><Setter Property="Background" Value="{DynamicResource MaterialPaperBrush}" /><Setter Property="OverlayBackground" Value="Black" /></Style>
    <Style Selector="dialog|DialogHost[IsOpen=True] /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="IsEnabled" Value="False" /></Style>
    <Style Selector="Window"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="6,3" /><Setter Property="MinHeight" Value="28" /></Style>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <grid:MaterialDataGridStyles />
    <Style Selector="Button"><Setter Property="Padding" Value="8,5" /><Setter Property="Margin" Value="2" /></Style>
    <Style Selector="Button"><Setter Property="Theme" Value="{StaticResource MaterialFlatButton}" /></Style>
    <Style Selector="ToggleButton"><Setter Property="Theme" Value="{StaticResource MaterialFlatToggleButton}" /></Style>
    <Style Selector="RepeatButton.numericStep"><Setter Property="Theme" Value="{StaticResource MaterialFlatRepeatButton}" /></Style>
    <!-- Keep library scroll templates and reserve a bounded cross-axis hit area. -->
    <Style Selector="ScrollBar"><Setter Property="Theme"><ControlTheme TargetType="ScrollBar" BasedOn="{StaticResource MaterialModernScrollBar}"><Style Selector="^:vertical"><Setter Property="Width" Value="12" /><Setter Property="MinWidth" Value="12" /><Setter Property="MaxWidth" Value="12" /></Style><Style Selector="^:horizontal"><Setter Property="Height" Value="12" /><Setter Property="MinHeight" Value="12" /><Setter Property="MaxHeight" Value="12" /></Style></ControlTheme></Setter></Style>
    <Style Selector="TabControl"><Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" /></ItemsPanelTemplate></Setter></Style>
    <Style Selector="Button, ToggleButton, RepeatButton"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TabItem"><Setter Property="MinWidth" Value="0" /></Style>
    <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Margin" Value="{CompiledBinding Padding, RelativeSource={RelativeSource TemplatedParent}, DataType={x:Type TabItem}}" /></Style>
    <Style Selector="StackPanel.titleActions Button"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,0" /><Setter Property="Margin" Value="0" /></Style>
    <Style Selector="StackPanel.titleActions ToggleButton"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="10,0" /></Style>
    <Style Selector="Menu.titleMenu"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" /><Setter Property="ItemContainerTheme"><ControlTheme TargetType="MenuItem" BasedOn="{StaticResource MaterialTopLevelMenuItem}"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" /></ControlTheme></Setter></Style>
    <Style Selector="Menu.titleMenu /template/ ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Disabled" /><Setter Property="HorizontalScrollBarVisibility" Value="Disabled" /></Style>
    <Style Selector="Menu.titleMenu MenuItem"><Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" /></Style>
    <Style Selector="ContextMenu.cadCanvasMenu"><Setter Property="MaxHeight" Value="560" /></Style>
    <Style Selector="ContextMenu.cadCanvasMenu MenuItem"><Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,0" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="ContextMenu.cadCanvasMenu /template/ ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto" /><Setter Property="HorizontalScrollBarVisibility" Value="Disabled" /></Style>
    <Style Selector="Button.toolIcon"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="4" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource CadRibbonAccentBrush}" /></Style>
    <Style Selector="Button.toolIcon:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ToggleButton.layerState"><Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="4" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ToggleButton.layerState:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="TextBox.compactNumber"><Setter Property="FontSize" Value="11" /><Setter Property="MinHeight" Value="18" /><Setter Property="Padding" Value="3,0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Opacity" Value="0.65" /></Style>
    <Style Selector="ListBox.cadList"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox.cadList ListBoxItem"><Setter Property="Padding" Value="5,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ListBox.terminalOutput ListBoxItem"><Setter Property="Padding" Value="2,1" /></Style>
    <Style Selector="ListBox.cadList ListBoxItem:selected /template/ Border#PART_RootBorder"><Setter Property="Background" Value="{DynamicResource CadSelectionBrush}" /><Setter Property="TextBlock.Foreground" Value="{DynamicResource MaterialBodyBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CadRibbonAccentBrush}" /><Setter Property="BorderThickness" Value="2,0,0,0" /></Style>
    <Style Selector="ListBox.cadList ListBoxItem:selected:pointerover /template/ Border#PART_RootBorder"><Setter Property="Background" Value="{DynamicResource CadSelectionBrush}" /></Style>
    <Style Selector="TabControl.singleDockItem /template/ Panel#PART_TabsPanel"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="TabControl.dockRegion"><Setter Property="Background" Value="{DynamicResource CadPanelBrush}" /></Style>
    <Style Selector="TabControl.dockRegion TabItem"><Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" /><Setter Property="Padding" Value="3,0" /></Style>
    <Style Selector="TabControl.dockRegion TabItem:selected /template/ Rectangle#PART_Separator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="TabControl.documentTabs TabItem"><Setter Property="Padding" Value="8,1" /></Style>
    <Style Selector="TabControl.documentTabs TabItem:selected /template/ Border#PART_RootBorder"><Setter Property="Background" Value="{DynamicResource CadSelectionBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CadRibbonAccentBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="TabControl.documentTabs TabItem:selected /template/ Rectangle#PART_Separator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="RepeatButton.numericStep"><Setter Property="Margin" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Expander"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="4,2" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="6,3" /></Style>
    <Style Selector="TextBox /template/ Panel#PART_TextFieldPanel"><Setter Property="MinHeight" Value="{CompiledBinding MinHeight, RelativeSource={RelativeSource TemplatedParent}, DataType={x:Type TextBox}}" /></Style>
    <Style Selector="TextBox /template/ Panel#PART_TextContainer"><Setter Property="Margin" Value="4,2" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="TextBox.compactNumber /template/ Panel#PART_TextContainer"><Setter Property="Margin" Value="2,0" /></Style>
    <Style Selector="ComboBox /template/ Border#splitBorder"><Setter Property="Margin" Value="6,4" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="28" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="TabControl.ribbon Button"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="TabControl.ribbon Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="TabControl.ribbon PathIcon"><Setter Property="Foreground" Value="{DynamicResource CadRibbonAccentBrush}" /></Style>
    <Style Selector="TabControl.ribbon TextBlock"><Setter Property="Foreground" Value="{DynamicResource CadRibbonAccentBrush}" /></Style>
    <Style Selector="TabControl.ribbon ToggleButton"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="TabControl.ribbon ToggleButton:checked"><Setter Property="Background" Value="{DynamicResource CadSelectionBrush}" /></Style>
    <Style Selector="StackPanel.statusControls ToggleButton"><Setter Property="Padding" Value="5,3" /><Setter Property="MinHeight" Value="26" /></Style>
    <Style Selector="StackPanel.statusControls ComboBox"><Setter Property="MinHeight" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="3,0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ToggleButton.statusIcon"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="26" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ToggleButton.statusIcon:checked"><Setter Property="Foreground" Value="{DynamicResource CadRibbonAccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CadRibbonAccentBrush}" /><Setter Property="BorderThickness" Value="1,1,1,3" /></Style>
    <Style Selector="TabControl"><Setter Property="Background" Value="{DynamicResource MaterialBackgroundBrush}" /></Style>
    <!-- The native center hosts our existing CAD document tabs. -->
    <Style Selector="dock|DocumentControl /template/ dock|DocumentTabStrip#PART_TabStrip">
      <Setter Property="IsVisible">
        <MultiBinding Converter="{x:Static local:CadDockTabsVisibleConverter.Instance}" x:DataType="dmc:IDocumentDock" x:CompileBindings="True">
          <Binding Path="VisibleDockables.Count" />
          <Binding Path="ActiveDockable" />
        </MultiBinding>
      </Setter>
    </Style>
    <Style Selector="dock|ToolChromeControl /template/ Button"><Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="3" /><Setter Property="Margin" Value="0" /></Style>
    <StyleInclude Source="avares://Direct2dCad.Avalonia/Styles/CadChoiceStyles.axaml" />
    <StyleInclude Source="avares://Direct2dCad.Avalonia/Styles/CadInspectorStyles.axaml" />
  </Application.Styles>
</Application>

