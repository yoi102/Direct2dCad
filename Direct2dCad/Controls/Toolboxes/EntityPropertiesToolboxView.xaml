<UserControl x:Class="Direct2dCad.wpf.Controls.Toolboxes.EntityPropertiesToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Direct2dCad.wpf.Controls.Toolboxes"
             xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels"
             xmlns:toolboxes="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
             xmlns:v_ep="clr-namespace:Direct2dCad.wpf.Controls.Toolboxes.EntityProperty"
             d:DataContext="{d:DesignInstance Type=toolboxes:EntityPropertiesToolboxViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.Resources>
            <DataTemplate DataType="{x:Type vm_ep:ArcPropertyViewModel}">
                <v_ep:ArcPropertyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm_ep:TransientArcPropertyViewModel}">
                <v_ep:TransientArcPropertyView />
            </DataTemplate>
        </Grid.Resources>
        <ContentControl Content="{Binding Entity}" />
    </Grid>
</UserControl>
