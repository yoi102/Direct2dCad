<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.LayerToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:yr="https://github.com/yoi102/xaml/controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:toolboxes="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=toolboxes:LayerToolboxViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="320">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="10,8,10,6"
                   LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{I18N {x:Static r:LangKeys.Layers}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button Width="26"
                        Height="26"
                        Padding="0"
                        Command="{Binding AddLayerCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="{I18N {x:Static r:LangKeys.AddLayer}}">
                    <md:PackIcon Kind="Plus"
                                 Width="16"
                                 Height="16" />
                </Button>
                <Button Width="26"
                        Height="26"
                        Padding="0"
                        Command="{Binding DeleteSelectedLayerCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="{I18N {x:Static r:LangKeys.DeleteLayer}}">
                    <md:PackIcon Kind="Delete"
                                 Width="16"
                                 Height="16" />
                </Button>
                <Button Width="26"
                        Height="26"
                        Padding="0"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="{I18N {x:Static r:LangKeys.Refresh}}">
                    <md:PackIcon Kind="Refresh"
                                 Width="16"
                                 Height="16" />
                </Button>
            </StackPanel>
        </DockPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Layers}"
                 SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 dd:DragDrop.IsDragSource="True"
                 dd:DragDrop.IsDropTarget="True"
                 dd:DragDrop.UseDefaultDragAdorner="True"
                 dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <Setter Property="Padding"
                            Value="0" />
                    <Setter Property="Margin"
                            Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type toolboxes:LayerItemViewModel}">
                    <Border Margin="0,2"
                            Padding="0,0"
                            CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            ToolTip="{Binding ToolTipText}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.RowSpan="2"
                                       Grid.Column="0"
                                       Text="::"
                                       Opacity="0.45"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />


                            <mah:ColorPicker Grid.Row="0"
                                             Grid.RowSpan="2"
                                             Grid.Column="1"
                                             Width="33"
                                             Height="14"
                                             Margin="0,0,7,0"                                             
                                             AdvancedTabHeader="{I18N {x:Static r:LangKeys.ColorPickerAdvanced}}"
                                             ColorPalettesTabHeader="{I18N {x:Static r:LangKeys.ColorPickerPalettes}}"
                                             AvailableColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerAvailableColors}}"
                                             RecentColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerRecentColors}}"
                                             StandardColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerStandardColors}}"
                                             mah:TextBoxHelper.AutoWatermark="True"
                                             mah:TextBoxHelper.ClearTextButton="False"
                                             AddToRecentColorsTrigger="SelectedColorChanged"
                                             SelectedColor="{Binding Color, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />


                            <yr:EditableTextBlock Grid.Row="0"
                                                  Grid.Column="2"
                                                  Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                  FontSize="15"
                                                  VerticalAlignment="Center"
                                                  FontWeight="SemiBold" />

                            <StackPanel Grid.Row="0"
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <ToggleButton Style="{StaticResource MaterialDesignActionSecondaryToggleButton}"
                                              Content="{md:PackIcon Kind=EyeOff}"
                                              md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=Eye}"
                                              Background="Transparent"
                                              Foreground="White"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              ToolTip="{I18N {x:Static r:LangKeys.Visible}}"
                                              VerticalAlignment="Center" />
                                <ToggleButton Style="{StaticResource MaterialDesignActionSecondaryToggleButton}"
                                              Content="{md:PackIcon Kind=Unlocked}"
                                              Background="Transparent"
                                              Foreground="White"
                                              md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=Lock}"
                                              IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                              ToolTip="{I18N {x:Static r:LangKeys.Locked}}"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center" />
                                <ToggleButton Style="{StaticResource MaterialDesignActionSecondaryToggleButton}"
                                              Content="{md:PackIcon Kind=SnowflakeOff}"
                                              Background="Transparent"
                                              Foreground="White"
                                              md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=Snowflake}"
                                              IsChecked="{Binding IsFrozen, Mode=TwoWay}"
                                              ToolTip="{I18N {x:Static r:LangKeys.Frozen}}"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,4,0,0">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Priority}}"
                                           VerticalAlignment="Center"
                                           Opacity="0.62"
                                           Margin="10,0,3,0"
                                           FontSize="11" />
                                <TextBlock Text="{Binding Priority}"
                                           VerticalAlignment="Center"
                                           Opacity="0.62"
                                           FontSize="11" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Entities}}"
                                           VerticalAlignment="Center"
                                           Opacity="0.62"
                                           Margin="10,0,3,0"
                                           FontSize="11" />
                                <TextBlock Text="{Binding EntityCount}"
                                           VerticalAlignment="Center"
                                           Opacity="0.62"
                                           FontSize="11" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Weight}}"
                                           VerticalAlignment="Center"
                                           Opacity="0.62"
                                           Margin="10,0,3,0"
                                           FontSize="11" />
                                <yr:EditableTextBlock Text="{Binding LineWeight, StringFormat={}{0:0.##}}"
                                                      Opacity="0.62"
                                                      FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
