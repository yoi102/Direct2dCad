<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.LinePropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm_ep:LinePropertyViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="320">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock Text="{I18N {x:Static r:LangKeys.Line}}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.Id}}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding EntityIdText, Mode=OneWay}"
                         IsReadOnly="True"
                         Margin="0,0,0,8" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.StartX}}"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="1"
                                   Grid.Column="1"
                                   Value="{Binding StartX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F3"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.StartY}}"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="2"
                                   Grid.Column="1"
                                   Value="{Binding StartY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F3"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.EndX}}"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="3"
                                   Grid.Column="1"
                                   Value="{Binding EndX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F3"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.EndY}}"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="4"
                                   Grid.Column="1"
                                   Value="{Binding EndY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F3"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.Length}}"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="5"
                                   Grid.Column="1"
                                   Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.001"
                                   StringFormat="F3"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.Angle}}"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="6"
                                   Grid.Column="1"
                                   Value="{Binding AngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F2"
                                   Interval="5"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.Color}}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="7"
                            Grid.Column="1"
                            Margin="0,0,0,8">
                    <mah:ColorPicker mah:TextBoxHelper.AutoWatermark="True"
                                     mah:TextBoxHelper.ClearTextButton="True"
                                     AdvancedTabHeader="{I18N {x:Static r:LangKeys.ColorPickerAdvanced}}"
                                     ColorPalettesTabHeader="{I18N {x:Static r:LangKeys.ColorPickerPalettes}}"
                                     AvailableColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerAvailableColors}}"
                                     RecentColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerRecentColors}}"
                                     StandardColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerStandardColors}}"
                                     AddToRecentColorsTrigger="SelectedColorChanged"
                                     IsEnabled="{Binding ColorControlsEnabled}"
                                     SelectedColor="{Binding StrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                    <CheckBox Content="{I18N {x:Static r:LangKeys.ByLayer}}"
                              IsChecked="{Binding UseByLayerColor}"
                              Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.LineWeight}}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="8"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <mah:NumericUpDown Width="112"
                                       Value="{Binding LineWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       IsEnabled="{Binding LineWeightControlsEnabled}"
                                       Minimum="0.01"
                                       StringFormat="F3"
                                       Interval="0.05" />
                    <CheckBox Content="{I18N {x:Static r:LangKeys.ByLayer}}"
                              IsChecked="{Binding UseByLayerLineWeight}"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="9"
                           Grid.Column="0"
                           Text="{I18N {x:Static r:LangKeys.DrawOrder}}"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="9"
                                   Grid.Column="1"
                                   Value="{Binding ZIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F0"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                    <CheckBox Grid.Row="10"
                              Grid.ColumnSpan="2"
                              Content="{I18N {x:Static r:LangKeys.Visible}}"
                          IsChecked="{Binding IsVisible}"
                          Margin="0,2,0,0" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
