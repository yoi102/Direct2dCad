<UserControl x:Class="Direct2dCad.wpf.Views.Toolboxes.EntityProperty.ArcPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
             xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
             xmlns:vm_ep="clr-namespace:Direct2dCad.ViewModels.Toolboxes.EntityProperty;assembly=Direct2dCad.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm_ep:ArcPropertyViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="320">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock Text="Arc"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Id"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding EntityIdText, Mode=OneWay}"
                         IsReadOnly="True"
                         Margin="0,0,0,8" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Center X"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="1"
                                   Grid.Column="1"
                                   Value="{Binding CenterX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F3"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Center Y"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="2"
                                   Grid.Column="1"
                                   Value="{Binding CenterY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F3"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Radius"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="3"
                                   Grid.Column="1"
                                   Value="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.001"
                                   StringFormat="F3"
                                   Interval="1"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Start"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="4"
                                   Grid.Column="1"
                                   Value="{Binding StartAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   StringFormat="F2"
                                   Interval="5"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Sweep"
                           VerticalAlignment="Center" />
                <mah:NumericUpDown Grid.Row="5"
                                   Grid.Column="1"
                                   Value="{Binding SweepAngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="-360"
                                   Maximum="360"
                                   StringFormat="F2"
                                   Interval="5"
                                   Margin="0,0,0,8" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="End"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Text="{Binding EndAngleDegrees, StringFormat=F2}"
                         IsReadOnly="True"
                         Margin="0,0,0,8" />

                <CheckBox Grid.Row="7"
                          Grid.ColumnSpan="2"
                          Content="Counter clockwise"
                          IsChecked="{Binding IsCounterClockwise}"
                          Margin="0,2,0,10" />

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Color"
                           VerticalAlignment="Center" />
                <mah:ColorPicker Grid.Row="8"
                                 Grid.Column="1"
                                 mah:TextBoxHelper.AutoWatermark="True"
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 AdvancedTabHeader="{I18N {x:Static r:LangKeys.ColorPickerAdvanced}}"
                                 ColorPalettesTabHeader="{I18N {x:Static r:LangKeys.ColorPickerPalettes}}"
                                 AvailableColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerAvailableColors}}"
                                 RecentColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerRecentColors}}"
                                 StandardColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerStandardColors}}"
                                 AddToRecentColorsTrigger="SelectedColorChanged"
                                 SelectedColor="{Binding StrokeColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}"
                                 Margin="0,0,0,8" />

                <TextBlock Grid.Row="9"
                           Grid.Column="0"
                           Text="Line weight"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="9"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <mah:NumericUpDown Width="112"
                                       Value="{Binding LineWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Minimum="0.01"
                                       StringFormat="F3"
                                       Interval="0.05" />
                    <CheckBox Content="By layer"
                              IsChecked="{Binding UseByLayerLineWeight}"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           Text="Draw order"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="10"
                            Grid.Column="1">
                    <mah:NumericUpDown Value="{Binding ZIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       StringFormat="F0"
                                       Interval="1"
                                       Margin="0,0,0,8" />
                    <CheckBox Content="Visible"
                              IsChecked="{Binding IsVisible}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
