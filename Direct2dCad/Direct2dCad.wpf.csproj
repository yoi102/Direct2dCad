<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Direct2dCad.ico</ApplicationIcon>
  </PropertyGroup>
  
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  
  <ItemGroup>
    <None Remove="Direct2dCad.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antelcat.I18N.WPF" Version="2.0.0-preview-1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.0-preview.94" />
    <PackageReference Include="Dirkster.AvalonDock.DependencyInjection" Version="5.0.0-preview.94" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.Arc" Version="5.0.0-preview.94" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="MahApps.Metro" Version="3.0.0-rc0529" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="5.3.3-ci1412" />
    <PackageReference Include="MessagePipe" Version="1.8.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Direct2dCad.Control\Direct2dCad.wpf.Control.csproj" />
    <ProjectReference Include="..\Direct2dCad.Editor\Direct2dCad.Editor.csproj" />
    <ProjectReference Include="..\Direct2dCad.ViewModels\Direct2dCad.ViewModels.csproj" />
    <ProjectReference Include="..\Direct2dCad.ViewModels.Services\Direct2dCad.ViewModels.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Direct2dCad.ico" />
  </ItemGroup>

</Project>
