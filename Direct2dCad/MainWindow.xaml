                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>

                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.Polygon}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.Polygon}}"
                                                  Width="20"
                                                  Height="20"
                                                  Margin="5"
                                                  Padding="0"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="Polygon">
                                        <Viewbox Width="16"
                                                 Height="16"
                                                 Stretch="Uniform">
                                            <Canvas Width="512"
                                                    Height="512">
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="42"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Fill="Transparent"
                                                      d:Stroke="#616161"
                                                      Data="M 96,360
                                                            L 180,170
                                                            L 320,140
                                                            L 420,260
                                                            L 300,390
                                                            Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>

                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.Spline}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.Spline}}"
                                                  Width="20"
                                                  Height="20"
                                                  Margin="5"
                                                  Padding="0"
                                                  x:Name="SplineToggleButton"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="Spline">
                                        <Viewbox Width="16"
                                                 Height="16"
                                                 Stretch="Uniform">
                                            <Path Stroke="{Binding ElementName=SplineToggleButton, Path=Foreground}"
                                                  StrokeThickness="77"
                                                  d:Stroke="#616161"
                                                  Fill="Transparent"
                                                  Data="M 50,200 
                                                        C 100,50 180,50 230,200
                                                        C 280,350 360,350 410,200" />
                                        </Viewbox>

                                    </ToggleButton>

                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.Text}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.Text}}"
                                                  Width="20"
                                                  Margin="5"
                                                  Height="20"
                                                  Padding="0"
                                                  Content="{md:PackIcon Kind=TextShadow,Size=20}"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="Text" />

                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.SetOrigin}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.SetOrigin}}"
                                                  Width="20"
                                                  Height="20"
                                                  Margin="5"
                                                  Padding="0"
                                                  Content="{md:PackIcon Kind=Target,Size=20}"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="SetOrigin" />

                                </WrapPanel>
                            </WrapPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.Resources>

                        <!--侧边栏工具箱的DataTemplate-->
                        <!-- DataTemplate: how to render each toolbox VM's content -->
                        <DataTemplate DataType="{x:Type vm_tb:EntityPropertiesToolboxViewModel}">
                            <v_tb:EntityPropertiesToolboxView />
                        </DataTemplate>
                        <!-- DataTemplate: how to render each toolbox VM's content -->
                        <DataTemplate DataType="{x:Type vm_tb:FolderExplorerToolboxViewModel}">
                            <v_tb:FolderExplorerToolboxView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm_tb:LayerToolboxViewModel}">
                            <v_tb:LayerToolboxView />
                        </DataTemplate>
                        <!-- DataTemplate: how to render each toolbox VM's content -->
                        <DataTemplate DataType="{x:Type vm:EditorTabViewModel}">
                            <views:EditorView />
                        </DataTemplate>



                        <!-- Document header template (tab header with icon + title) -->
                        <DataTemplate x:Key="DocumentTabHeaderTemplate">
                            <StackPanel Orientation="Horizontal">

                                <md:PackIcon Kind="{Binding ., Converter={x:Static cv:DocumentViewModelTypeToIconType.Instance}}"
                                             Width="14"
                                             Height="14"
                                             Margin="0,0,5,0" />

                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>

                        <!-- LayoutItem style selector: different styles for toolboxes vs documents -->
                        <selectors:PanesStyleSelector x:Key="PanesStyleSelector">
                            <selectors:PanesStyleSelector.ToolboxStyle>
                                <Style TargetType="{x:Type avalonDockControls:LayoutAnchorableItem}">
                                    <Setter Property="Title"
                                            Value="{Binding Model.Title}" />
                                    <Setter Property="ContentId"
                                            Value="{Binding Model.ContentId}" />
                                    <Setter Property="ClipToBounds"
                                            Value="True" />
                                </Style>
                            </selectors:PanesStyleSelector.ToolboxStyle>
                            <selectors:PanesStyleSelector.DocumentStyle>
                                <Style TargetType="{x:Type avalonDockControls:LayoutDocumentItem}">
                                    <Setter Property="Title"
                                            Value="{Binding Model.Title}" />
                                    <Setter Property="ToolTip"
                                            Value="{Binding Model.ToolTip}" />
                                    <Setter Property="IconSource"
                                            Value="{Binding Model.IconSource}" />
                                    <Setter Property="ContentId"
                                            Value="{Binding Model.ContentId}" />
                                </Style>
                            </selectors:PanesStyleSelector.DocumentStyle>
                        </selectors:PanesStyleSelector>
                    </Grid.Resources>

                    <avalonDock:ToggleDockingManager x:Name="dockManager"
                                                     Grid.Row="1"
                                                     BorderThickness="0"
                                                     DockLayout="{Binding DockLayout}"
                                                     DocumentHeaderTemplate="{StaticResource DocumentTabHeaderTemplate}"
                                                     LayoutItemContainerStyleSelector="{StaticResource PanesStyleSelector}">
                        <i:Interaction.Triggers>

                            <!-- 文档关闭前 -->
                            <i:EventTrigger EventName="DocumentClosed">
                                <i:InvokeCommandAction Command="{Binding DocumentClosedCommand}"
                                                       EventArgsParameterPath="Document.Content"
                                                       PassEventArgsToCommand="True" />
                            </i:EventTrigger>

                            <!-- Active 文档切换 -->
                            <i:EventTrigger EventName="ActiveContentChanged">
                                <i:InvokeCommandAction Command="{Binding ActiveContentChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <avalonDock:ToggleDockingManager.Theme>
                            <avalonDockThemes:ArcDarkTheme />
                        </avalonDock:ToggleDockingManager.Theme>
                        <avalonDock:LayoutRoot>
                            <avalonDock:LayoutPanel Orientation="Horizontal">
                                <avalonDock:LayoutDocumentPaneGroup>

                                    <avalonDock:LayoutDocumentPane x:Name="LayoutDocumentPane">
                                        <avalonDock:LayoutDocument Title="{I18N {x:Static r:LangKeys.Welcome}}"
                                                                   ContentId="welcome">
                                            <Border Background="{DynamicResource AppEditorBg}"
                                                    Padding="40">
                                                <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <md:PackIcon  Kind="HandWaveOutline"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Width="80"
                                                                  Height="80" />
                                                    <TextBlock Margin="0 20 0 0"
                                                               Text="{I18N {x:Static r:LangKeys.Direct2dCad}}"
                                                               FontSize="28"
                                                               FontWeight="Light"
                                                               HorizontalAlignment="Center" />

                                                    <TextBlock Margin="0 25 0 0"
                                                               FontSize="13"
                                                               TextAlignment="Center"
                                                               LineHeight="24">
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </avalonDock:LayoutDocument>
                                    </avalonDock:LayoutDocumentPane>
                                </avalonDock:LayoutDocumentPaneGroup>
                            </avalonDock:LayoutPanel>
                        </avalonDock:LayoutRoot>
                    </avalonDock:ToggleDockingManager>
                </Grid>


                <Border Grid.Row="2"
                        Background="{DynamicResource MaterialDesign.Brush.Background}">

                    <StatusBar Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotHiddenInstance}}">
                        <StatusBarItem>

                            <TextBlock Text="{Binding CurrentEditorTabViewModel.CadDocumentViewModel.CadCanvasToolMode}" />
                        </StatusBarItem>

                        <Separator />

                        <StatusBarItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.X}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Width="78"
                                           Margin="4,0,10,0"
                                           Text="{Binding CurrentEditorTabViewModel.CadDocumentViewModel.CurrentPointerWorldX, StringFormat={}{0:F3}}" />
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Y}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Width="78"
                                           Margin="4,0,0,0"
                                           Text="{Binding CurrentEditorTabViewModel.CadDocumentViewModel.CurrentPointerWorldY, StringFormat={}{0:F3}}" />
                            </StackPanel>
                        </StatusBarItem>

                        <Separator />

                        <StatusBarItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Grid}}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <ComboBox Margin="5 0 0 0"
                                          Width="82"
                                          Height="24"
                                          ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadGridType}}}"
                                          SelectedItem="{Binding CurrentEditorTabViewModel.ViewModelCadGridType}" />
                            </StackPanel>
                        </StatusBarItem>

                        <StatusBarItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.OriginMarker}}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,4,0" />
                                <ComboBox Margin="5 0 0 0"
                                          Width="88"
                                          Height="24"
                                          ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadOriginDisplayType}}}"
                                          SelectedItem="{Binding CurrentEditorTabViewModel.ViewModelCadOriginDisplayType}" />
                            </StackPanel>
                        </StatusBarItem>

                        <StatusBarItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.SnapMarker}}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,4,0" />
                                <ComboBox Margin="5 0 0 0"
                                          Width="88"
                                          Height="24"
                                          ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type vm_en:ViewModelCadSnapMarkerType}}}"
                                          SelectedItem="{Binding CurrentEditorTabViewModel.ViewModelCadSnapMarkerType}" />
                            </StackPanel>
                        </StatusBarItem>

                        <Separator />

                        <StatusBarItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{I18N {x:Static r:LangKeys.Background}}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />

                                <mah:ColorPicker Margin="5 0 0 0"
                                                 Width="160"
                                                 Height="24"
                                                 AdvancedTabHeader="{I18N {x:Static r:LangKeys.ColorPickerAdvanced}}"
                                                 ColorPalettesTabHeader="{I18N {x:Static r:LangKeys.ColorPickerPalettes}}"
                                                 AvailableColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerAvailableColors}}"
                                                 RecentColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerRecentColors}}"
                                                 StandardColorPaletteHeader="{I18N {x:Static r:LangKeys.ColorPickerStandardColors}}"
                                                 mah:TextBoxHelper.AutoWatermark="True"
                                                 mah:TextBoxHelper.ClearTextButton="False"
                                                 AddToRecentColorsTrigger="SelectedColorChanged"
                                                 SelectedColor="{Binding CurrentEditorTabViewModel.ViewModelCadBackgroundColor, Mode=TwoWay, Converter={x:Static cv:CadColorToMediaColorConverter.Instance}}" />
                            </StackPanel>
                        </StatusBarItem>
                    </StatusBar>
                </Border>

            </Grid>
        </md:DialogHost>

        <md:Snackbar Margin="10"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     ass:SnackbarIdentifierAssist.SnackbarIdentifier="{x:Static svc:ViewServiceIdentifiers.RootSnackbar}"
                     MessageQueue="{md:MessageQueue}" />
    </Grid>
</mah:MetroWindow>
