<mah:MetroWindow x:Class="Direct2dCad.wpf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:controls="clr-namespace:Direct2dCad.wpf.Controls"
                 xmlns:views="clr-namespace:Direct2dCad.wpf.Views"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ex="clr-namespace:Direct2dCad.wpf.Extensions"
                 xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
                 xmlns:viewmodels="clr-namespace:Direct2dCad.ViewModels;assembly=Direct2dCad.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
                 Topmost="{Binding Topmost}"
                 Title="Direct2dCad"
                 TitleAlignment="Left"
                 TitleCharacterCasing="Normal"
                 WindowStartupLocation="CenterScreen"
                 Height="900"
                 Width="1200">
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button  Content="{md:PackIcon Kind=Github, Size=20}"
                     Click="IconClicked"
                     Width="35"
                     Height="22" />
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>

            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource MaterialDesignActionSecondaryToggleButton}"
                              Content="{md:PackIcon Kind=PinOff,  Size=20}"
                              IsChecked="{Binding Topmost}"
                              Background="Transparent"
                              Foreground="White"
                              md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=Pin}" />
                <ToggleButton md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=WeatherNight}"
                              Background="Transparent"
                              Content="{md:PackIcon Kind=WhiteBalanceSunny,Size=20}"
                              Foreground="White"
                              IsChecked="{Binding IsDarkTheme}"
                              Style="{StaticResource MaterialDesignActionSecondaryToggleButton}" />

                <Menu VerticalAlignment="Center"
                      md:MenuAssist.TopLevelMenuItemHeight="25"
                      Width="70">
                    <MenuItem Foreground="White"
                              Header="{Binding CurrentCultureLCID, Converter={x:Static cv:LCIDToStringConverter.Instance}}">
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="1033"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="EN" />
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="1041"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="JP" />
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="2052"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="CN" />
                    </MenuItem>
                </Menu>
            </StackPanel>

        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>



    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button ToolTip="Open"
                    Content="{md:PackIcon Kind=File,  Size=20}"
                    Command="{Binding OpenFileCommand}" />
            <Button ToolTip="Save"
                    Content="{md:PackIcon Kind=ContentSave,  Size=20}"
                    Command="{Binding SaveFileCommand}" />
            <Button ToolTip="Save As"
                    Content="{md:PackIcon Kind=ContentSaveAdd,  Size=20}"
                    Command="{Binding SaveAsFileCommand}" />
            <Separator Margin="20 0 0 0" />
            <Button ToolTip="Undo"
                    Content="{md:PackIcon Kind=Undo,  Size=20}"
                    Command="{Binding UndoCommand}" />
            <Button ToolTip="Redo"
                    Content="{md:PackIcon Kind=Redo,  Size=20}"
                    Command="{Binding RedoCommand}" />

            <Separator Margin="20 0 0 0" />
            <TextBlock Text="Grid"
                       VerticalAlignment="Center" />
            <ComboBox Width="78"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type viewmodels:ViewModelCadGridType}}}"
                      SelectedItem="{Binding ViewModelCadGridType}" />
            <TextBlock Text="Snap Marker"
                       VerticalAlignment="Center" />
            <ComboBox Width="92"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type viewmodels:ViewModelCadSnapMarkerType}}}"
                      SelectedItem="{Binding ViewModelCadSnapMarkerType}" />
            <Separator />

        </ToolBar>

        <ToolBar DockPanel.Dock="Top">

            <Separator />
            <Button Content="Select"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Select" />
            <Separator />
            <Button Content="Line"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Line" />
            <Button Content="Circle"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Circle" />
            <Button Content="Ellipse"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Ellipse" />
            <Button Content="Arc"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Arc" />
            <Button Content="Rectangle"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Rectangle" />
            <Button Content="Polygon"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Polygon" />
            <Button Content="Spline"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Spline" />
            <Button Content="Text"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="Text" />
            <Button Content="Set Origin"
                    Command="{Binding SetCadCanvasToolModeCommand}"
                    CommandParameter="SetOrigin" />
            <TextBox Width="120"
                     Text="{Binding TextInput}" />


        </ToolBar>
        <ToolBar DockPanel.Dock="Top">
            <TextBlock Text="Origin"
                       VerticalAlignment="Center" />
            <ComboBox Width="112"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type viewmodels:ViewModelCadOriginDisplayType}}}"
                      SelectedItem="{Binding ViewModelCadOriginDisplayType}" />
            <TextBlock Text="X"
                       VerticalAlignment="Center" />
            <TextBox Width="64"
                     Text="{Binding ViewModelCadOriginX, UpdateSourceTrigger=LostFocus, StringFormat=F2}" />
            <TextBlock Text="Y"
                       VerticalAlignment="Center" />
            <TextBox Width="64"
                     Text="{Binding ViewModelCadOriginY, UpdateSourceTrigger=LostFocus, StringFormat=F2}" />
            <TextBlock Text="Origin Marker"
                       VerticalAlignment="Center" />
            <ComboBox Width="82"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type viewmodels:ViewModelCadOriginMarkerType}}}"
                      SelectedItem="{Binding ViewModelCadOriginMarkerType}" />
            <TextBlock Text="Origin Line"
                       VerticalAlignment="Center" />
            <ComboBox Width="82"
                      ItemsSource="{Binding Source={ex:EnumBindingSource {x:Type viewmodels:ViewModelCadOriginLinePattern}}}"
                      SelectedItem="{Binding ViewModelCadOriginLinePattern}" />
            <TextBlock Text="Size"
                       VerticalAlignment="Center" />
            <TextBox Width="48"
                     Text="{Binding ViewModelCadOriginSize, UpdateSourceTrigger=LostFocus, StringFormat=F1}" />
            <TextBlock Text="Stroke"
                       VerticalAlignment="Center" />
            <TextBox Width="48"
                     Text="{Binding ViewModelCadOriginStrokeWidth, UpdateSourceTrigger=LostFocus, StringFormat=F2}" />
            <TextBlock Text="Color"
                       VerticalAlignment="Center" />
            <Border Width="18"
                    Height="18"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    Background="{Binding ViewModelCadOriginColorText}" />
            <TextBox Width="86"
                     Text="{Binding ViewModelCadOriginColorText, UpdateSourceTrigger=LostFocus}" />

        </ToolBar>

        <ToolBar DockPanel.Dock="Top">
            <TextBlock Text="User"
                       VerticalAlignment="Center" />
            <CheckBox Content="Antialias"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsAntialiasingEnabled}" />
            <CheckBox Content="Text AA"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsTextAntialiasingEnabled}" />
            <Separator />
            <TextBlock Text="Selected"
                       VerticalAlignment="Center" />
            <Border Width="18"
                    Height="18"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    Background="{Binding SelectedEntityColorText}" />
            <TextBox Width="86"
                     Text="{Binding SelectedEntityColorText, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Window"
                       VerticalAlignment="Center" />
            <Border Width="18"
                    Height="18"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    Background="{Binding SelectionWindowStrokeColorText}" />
            <TextBox Width="86"
                     Text="{Binding SelectionWindowStrokeColorText, UpdateSourceTrigger=LostFocus}" />
            <Border Width="18"
                    Height="18"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    Background="{Binding SelectionWindowFillColorText}" />
            <TextBox Width="86"
                     Text="{Binding SelectionWindowFillColorText, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Crossing"
                       VerticalAlignment="Center" />
            <Border Width="18"
                    Height="18"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    Background="{Binding SelectionCrossingStrokeColorText}" />
            <TextBox Width="86"
                     Text="{Binding SelectionCrossingStrokeColorText, UpdateSourceTrigger=LostFocus}" />
            <Border Width="18"
                    Height="18"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    Background="{Binding SelectionCrossingFillColorText}" />
            <TextBox Width="86"
                     Text="{Binding SelectionCrossingFillColorText, UpdateSourceTrigger=LostFocus}" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding CadDocumentViewModel.CadCanvasToolMode}" />
        </StatusBar>
        <Grid>
            <views:CadDocumentView x:Name="cadDocumentView"
                                   DataContext="{Binding CadDocumentViewModel}" />
            <Button HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="{md:PackIcon Kind=FitToScreen,  Size=25}"
                    Background="Transparent"
                    Foreground="White"
                    Margin="12"
                    ToolTip="Fit"
                    Command="{Binding FitToWindowCommand}" />
        </Grid>
    </DockPanel>
</mah:MetroWindow>
