<mah:MetroWindow x:Class="Direct2dCad.wpf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:controls="clr-namespace:Direct2dCad.wpf.Controls"
                 xmlns:views="clr-namespace:Direct2dCad.wpf.Views"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
                 xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                 xmlns:avalonDockThemes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Arc"
                 xmlns:tb_vm="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
                 xmlns:tb_v="clr-namespace:Direct2dCad.wpf.Views.Toolboxes"
                 xmlns:selectors="clr-namespace:Direct2dCad.wpf.Selectors"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ass="clr-namespace:Direct2dCad.wpf.Assists"
                 xmlns:ex="clr-namespace:Direct2dCad.wpf.Extensions"
                 xmlns:cv="clr-namespace:Direct2dCad.wpf.Converters"
                 xmlns:r="clr-namespace:Direct2dCad.Lang;assembly=Direct2dCad.Lang"
                 xmlns:vm="clr-namespace:Direct2dCad.ViewModels;assembly=Direct2dCad.ViewModels"
                 xmlns:vm_en="clr-namespace:Direct2dCad.ViewModels.Enums;assembly=Direct2dCad.ViewModels"
                 xmlns:svc="clr-namespace:Direct2dCad.ViewModels.Services;assembly=Direct2dCad.ViewModels"
                 xmlns:vm_tb="clr-namespace:Direct2dCad.ViewModels.Toolboxes;assembly=Direct2dCad.ViewModels"
                 xmlns:v_tb="clr-namespace:Direct2dCad.wpf.Views.Toolboxes"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                 Icon="Direct2dCad.ico"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Topmost="{Binding Topmost}"
                 TitleAlignment="Left"
                 TitleCharacterCasing="Normal"
                 ShowIconOnTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 Height="1100"
                 Width="1400">
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button Margin="15 0 0 0"
                    Content="{md:PackIcon Kind=Github, Size=20}"
                    Click="IconClicked"
                    Width="35"
                    Height="22" />
            <Menu VerticalAlignment="Center"
                  md:MenuAssist.TopLevelMenuItemHeight="25">
                <MenuItem Header="{I18N {x:Static r:LangKeys.File}}">
                    <MenuItem Command="{Binding NewCommand}"
                              Icon="{md:PackIcon Kind=FilePlus}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Header="{I18N {x:Static r:LangKeys.New}}" />
                    <MenuItem Command="{Binding OpenFileCommand}"
                              Icon="{md:PackIcon Kind=FolderOpen}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Header="{I18N {x:Static r:LangKeys.OpenFile}}" />
                    <MenuItem Command="{Binding CurrentEditorTabViewModel.SaveFileCommand}"
                              Icon="{md:PackIcon Kind=ContentSave}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}"
                              Header="{I18N {x:Static r:LangKeys.Save}}" />
                    <MenuItem Command="{Binding CurrentEditorTabViewModel.SaveAsFileCommand}"
                              Icon="{md:PackIcon Kind=ContentSaveAdd}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}"
                              Header="{I18N {x:Static r:LangKeys.SaveAs}}" />
                </MenuItem>
            </Menu>

        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>

            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource MaterialDesignActionSecondaryToggleButton}"
                              Content="{md:PackIcon Kind=PinOff,  Size=20}"
                              IsChecked="{Binding Topmost}"
                              Background="Transparent"
                              Foreground="White"
                              md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=Pin}" />
                <ToggleButton md:ToggleButtonAssist.OnContent="{md:PackIcon Kind=WeatherNight}"
                              Background="Transparent"
                              Content="{md:PackIcon Kind=WhiteBalanceSunny,Size=20}"
                              Foreground="White"
                              IsChecked="{Binding IsDarkTheme}"
                              Style="{StaticResource MaterialDesignActionSecondaryToggleButton}" />

                <Menu VerticalAlignment="Center"
                      md:MenuAssist.TopLevelMenuItemHeight="25"
                      Width="70">
                    <MenuItem Foreground="White"
                              Header="{Binding CurrentCultureLCID, Converter={x:Static cv:LCIDToStringConverter.Instance}}">
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="1033"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="{I18N {x:Static r:LangKeys.English}}" />
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="1041"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="{I18N {x:Static r:LangKeys.Japanese}}" />
                        <MenuItem Command="{Binding ChangeCultureCommand}"
                                  CommandParameter="2052"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Header="{I18N {x:Static r:LangKeys.Chinese}}" />
                    </MenuItem>
                </Menu>
            </StackPanel>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <Grid>
        <md:DialogHost Style="{StaticResource MaterialDesignEmbeddedDialogHost}"
                       Identifier="{x:Static svc:ViewServiceIdentifiers.RootDialogHost}"
                       Background="{DynamicResource MaterialDesign.Brush.Background}"
                       DialogTheme="Inherit">

            <Grid RowDefinitions="auto * auto"
                  Background="{DynamicResource MaterialDesign.Brush.Background}">
                <Grid Grid.Row="0"
                      Height="150">

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0 0 10 5"
                                Orientation="Horizontal"
                                Panel.ZIndex="11">
                        <StackPanel.Resources>
                            <Style x:Key="LayoutToggleButton"
                                   TargetType="ToggleButton">
                                <Setter Property="Width"
                                        Value="26" />
                                <Setter Property="Height"
                                        Value="22" />
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="BorderThickness"
                                        Value="0" />
                                <Setter Property="Cursor"
                                        Value="Hand" />
                                <Setter Property="Margin"
                                        Value="1,0" />
                                <Setter Property="Padding"
                                        Value="4,3" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="#30FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="#20FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <!--Toggle Primary Side Bar (Left)-->

                        <ToggleButton Style="{StaticResource LayoutToggleButton}"
                                      ToolTip="{I18N {x:Static r:LangKeys.TogglePrimarySideBar}}"
                                      IsChecked="{Binding IsPrimarySideBarOpen, Mode=OneWay}"
                                      Command="{Binding TogglePrimarySideBarCommand}">
                            <Viewbox Width="20"
                                     Height="20">
                                <Canvas Width="20"
                                        Height="20">
                                    <Rectangle Width="15"
                                               Height="13"
                                               RadiusX="1"
                                               RadiusY="1"
                                               StrokeThickness="1"
                                               Fill="Transparent"
                                               Stroke="{DynamicResource MaterialDesign.Brush.Foreground}"
                                               Canvas.Left="0.5"
                                               Canvas.Top="1.5" />
                                    <Rectangle Width="4.5"
                                               Height="11"
                                               Fill="{DynamicResource MaterialDesign.Brush.Foreground}"
                                               Opacity="0.4"
                                               Canvas.Left="1.5"
                                               Canvas.Top="2.5" />
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>


                        <!--Toggle Panel (Bottom)-->

                        <ToggleButton Style="{StaticResource LayoutToggleButton}"
                                      ToolTip="{I18N {x:Static r:LangKeys.TogglePanel}}"
                                      IsChecked="{Binding IsBottomPanelOpen, Mode=OneWay}"
                                      Command="{Binding ToggleBottomPanelCommand}">
                            <Viewbox Width="14"
                                     Height="14">
                                <Canvas Width="16"
                                        Height="16">
                                    <Rectangle Width="15"
                                               Height="13"
                                               RadiusX="1"
                                               RadiusY="1"
                                               StrokeThickness="1"
                                               Fill="Transparent"
                                               Stroke="{DynamicResource MaterialDesign.Brush.Foreground}"
                                               Canvas.Left="0.5"
                                               Canvas.Top="1.5" />
                                    <Rectangle Width="13"
                                               Height="4.5"
                                               Fill="{DynamicResource MaterialDesign.Brush.Foreground}"
                                               Opacity="0.4"
                                               Canvas.Left="1.5"
                                               Canvas.Top="9" />
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>


                        <!--Toggle Secondary Side Bar (Right)-->

                        <ToggleButton Style="{StaticResource LayoutToggleButton}"
                                      ToolTip="{I18N {x:Static r:LangKeys.ToggleSecondarySideBar}}"
                                      IsChecked="{Binding IsSecondarySideBarOpen, Mode=OneWay}"
                                      Command="{Binding ToggleSecondarySideBarCommand}">
                            <Viewbox Width="14"
                                     Height="14">
                                <Canvas Width="16"
                                        Height="16">
                                    <Rectangle Width="15"
                                               Height="13"
                                               RadiusX="1"
                                               RadiusY="1"
                                               StrokeThickness="1"
                                               Fill="Transparent"
                                               Stroke="{DynamicResource MaterialDesign.Brush.Foreground}"
                                               Canvas.Left="0.5"
                                               Canvas.Top="1.5" />
                                    <Rectangle Width="4.5"
                                               Height="11"
                                               Fill="{DynamicResource MaterialDesign.Brush.Foreground}"
                                               Opacity="0.4"
                                               Canvas.Left="10"
                                               Canvas.Top="2.5" />
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>
                    </StackPanel>

                    <TabControl Style="{StaticResource MahApps.Styles.TabControl}"
                                SelectedIndex="{Binding TabControlSelectedIndex}"
                                TabStripPlacement="Bottom"
                                mah:TabControlHelper.Underlined="TabPanel"
                                mah:TabControlHelper.UnderlinePlacement="Top"
                                mah:HeaderedControlHelper.HeaderFontFamily="Segoe Script"
                                mah:HeaderedControlHelper.HeaderFontSize="18">

                        <TabItem Header="{I18N {x:Static r:LangKeys.File}}"
                                 Style="{StaticResource MahApps.Styles.TabItem}">
                            <WrapPanel Margin="10">

                                <Button ToolTip="{I18N {x:Static r:LangKeys.New}}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Width="80"
                                        Height="80"
                                        Padding="0"
                                        Command="{Binding NewCommand}">
                                    <Grid RowDefinitions="* auto">

                                        <md:PackIcon Kind="FilePlus"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Width="50"
                                                     Height="50" />
                                        <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   Text="{I18N {x:Static r:LangKeys.New}}" />

                                    </Grid>
                                </Button>

                                <Button ToolTip="{I18N {x:Static r:LangKeys.OpenFile}}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Width="80"
                                        Height="80"
                                        Padding="0"
                                        Command="{Binding OpenFileCommand}">
                                    <Grid RowDefinitions="* auto">

                                        <md:PackIcon Kind="FolderOpen"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Width="50"
                                                     Height="50" />
                                        <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   Text="{I18N {x:Static r:LangKeys.OpenFile}}" />

                                    </Grid>
                                </Button>
                                <Button ToolTip="{I18N {x:Static r:LangKeys.Save}}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Width="80"
                                        Height="80"
                                        Padding="0"
                                        Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}"
                                        Command="{Binding CurrentEditorTabViewModel.SaveFileCommand}">
                                    <Grid RowDefinitions="* auto"
                                          Margin="0">
                                        <md:PackIcon Kind="ContentSave"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Width="50"
                                                     Height="50" />
                                        <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   Text="{I18N {x:Static r:LangKeys.Save}}" />

                                    </Grid>
                                </Button>
                                <Button ToolTip="{I18N {x:Static r:LangKeys.SaveAs}}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Width="80"
                                        Height="80"
                                        Padding="0"
                                        Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}"
                                        Command="{Binding CurrentEditorTabViewModel.SaveAsFileCommand}">
                                    <Grid RowDefinitions="* auto">
                                        <md:PackIcon Kind="ContentSaveAdd"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Width="50"
                                                     Height="50" />
                                        <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   Text="{I18N {x:Static r:LangKeys.SaveAs}}" />

                                    </Grid>
                                </Button>
                            </WrapPanel>
                        </TabItem>

                        <TabItem Header="{I18N {x:Static r:LangKeys.Draw}}"
                                 Style="{StaticResource MahApps.Styles.TabItem}"
                                 Visibility="{Binding CurrentEditorTabViewModel, Converter={x:Static cv:DefaultToVisibilityConverter.NotCollapsedInstance}}">
                            <WrapPanel Margin="10">

                                <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.Select}}"
                                              Style="{StaticResource MaterialDesignFlatToggleButton}"
                                              IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.Select}}"
                                              Width="80"
                                              Height="80"
                                              Padding="0"
                                              Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                              CommandParameter="Select">
                                    <Grid RowDefinitions="* auto">

                                        <md:PackIcon Kind="ArrowAll"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Width="50"
                                                     Height="50" />
                                        <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   Text="{I18N {x:Static r:LangKeys.Select}}" />

                                    </Grid>
                                </ToggleButton>

                                <!--<Button ToolTip="{I18N {x:Static r:LangKeys.Undo}}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="{md:PackIcon Kind=Undo,  Size=20}"
                                        Command="{Binding CurrentEditorTabViewModel.UndoCommand}" />
                                <Button ToolTip="{I18N {x:Static r:LangKeys.Redo}}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="{md:PackIcon Kind=Redo,  Size=20}"
                                        Command="{Binding CurrentEditorTabViewModel.RedoCommand}" />-->

                                <Separator />
                                <WrapPanel Margin="50 0 0 0"
                                           Width="500">
                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.Line}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.Line}}"
                                                  Width="20"
                                                  Height="20"
                                                  Margin="5"
                                                  Padding="0"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="Line">
                                        <Viewbox Width="16"
                                                 Height="16"
                                                 Stretch="Uniform">
                                            <Canvas Width="512"
                                                    Height="512">
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="48"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Fill="Transparent"
                                                      d:Stroke="#616161"
                                                      Data="M 96,416 L 416,96" />
                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>

                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.CircleCenterRadius}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.CircleCenterRadius}}"
                                                  Width="24"
                                                  Height="24"
                                                  Margin="0"
                                                  Padding="0"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="CircleCenterRadius">
                                        <Viewbox Width="20"
                                                 Height="20"
                                                 Stretch="Uniform">
                                            <Canvas Width="512"
                                                    Height="512">

                                                <Ellipse Width="300"
                                                         Height="300"
                                                         Canvas.Left="106"
                                                         Canvas.Top="106"
                                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         StrokeThickness="38"
                                                         Fill="Transparent"
                                                         d:Stroke="#616161" />

                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="32"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Fill="Transparent"
                                                      d:Stroke="#616161"
                                                      Data="M 256,256 L 350,180" />

                                                <Ellipse Width="40"
                                                         Height="40"
                                                         Canvas.Left="236"
                                                         Canvas.Top="236"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         d:Fill="#616161" />

                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>

                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.CircleCenterDiameter}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.CircleCenterDiameter}}"
                                                  Width="24"
                                                  Height="24"
                                                  Margin="3"
                                                  Padding="0"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="CircleCenterDiameter">
                                        <Viewbox Width="20"
                                                 Height="20"
                                                 Stretch="Uniform">
                                            <Canvas Width="512"
                                                    Height="512">

                                                <Ellipse Width="300"
                                                         Height="300"
                                                         Canvas.Left="106"
                                                         Canvas.Top="106"
                                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         StrokeThickness="38"
                                                         Fill="Transparent"
                                                         d:Stroke="#616161" />

                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="10"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Fill="Transparent"
                                                      d:Stroke="#616161"
                                                      Data="M 160,320 L 352,192" />

                                                <Ellipse Width="40"
                                                         Height="40"
                                                         Canvas.Left="236"
                                                         Canvas.Top="236"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         d:Fill="#616161" />

                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>
                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.CircleTwoPoint}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.CircleTwoPoint}}"
                                                  Width="24"
                                                  Height="24"
                                                  Margin="3"
                                                  Padding="0"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="CircleTwoPoint">
                                        <Viewbox Width="20"
                                                 Height="20"
                                                 Stretch="Uniform">
                                            <Canvas Width="512"
                                                    Height="512">

                                                <!-- 圆 -->
                                                <Ellipse Width="300"
                                                         Height="300"
                                                         Canvas.Left="106"
                                                         Canvas.Top="106"
                                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         StrokeThickness="22"
                                                         Fill="Transparent"
                                                         d:Stroke="#616161" />



                                                <!-- 点1 -->
                                                <Ellipse Width="44"
                                                         Height="44"
                                                         Canvas.Left="128"
                                                         Canvas.Top="308"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         d:Fill="#616161" />

                                                <!-- 点2 -->
                                                <Ellipse Width="44"
                                                         Height="44"
                                                         Canvas.Left="340"
                                                         Canvas.Top="160"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         d:Fill="#616161" />

                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>
                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.CircleThreePoint}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.CircleThreePoint}}"
                                                  Width="24"
                                                  Height="24"
                                                  Margin="3"
                                                  Padding="0"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="CircleThreePoint">
                                        <Viewbox Width="20"
                                                 Height="20"
                                                 Stretch="Uniform">
                                            <Canvas Width="512"
                                                    Height="512">

                                                <!-- 圆 -->
                                                <Ellipse Width="300"
                                                         Height="300"
                                                         Canvas.Left="106"
                                                         Canvas.Top="106"
                                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         StrokeThickness="22"
                                                         Fill="Transparent"
                                                         d:Stroke="#616161" />


                                                <!-- 三个点 -->
                                                <Ellipse Width="44"
                                                         Height="44"
                                                         Canvas.Left="108"
                                                         Canvas.Top="292"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         d:Fill="#616161" />

                                                <Ellipse Width="44"
                                                         Height="44"
                                                         Canvas.Left="234"
                                                         Canvas.Top="94"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         d:Fill="#616161" />

                                                <Ellipse Width="44"
                                                         Height="44"
                                                         Canvas.Left="360"
                                                         Canvas.Top="292"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         d:Fill="#616161" />

                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>

                                    <ToggleButton ToolTip="{I18N {x:Static r:LangKeys.EllipseCenter}}"
                                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                                  IsChecked="{Binding CurrentEditorTabViewModel.CadCanvasToolMode, Mode=OneWay, Converter={x:Static cv:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm_en:CadCanvasToolMode.EllipseCenter}}"
                                                  Width="24"
                                                  Height="24"
                                                  Margin="3"
                                                  Padding="0"
                                                  Command="{Binding CurrentEditorTabViewModel.SetCadCanvasToolModeCommand}"
                                                  CommandParameter="EllipseCenter">
                                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                                            <Canvas Width="512" Height="512">
                                                <Ellipse Width="330"
                                                         Height="220"
                                                         Canvas.Left="91"
                                                         Canvas.Top="146"
                                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         StrokeThickness="34"
                                                         Fill="Transparent"
                                                         d:Stroke="#616161" />
                                                <Line X1="256"
                                                      Y1="256"
                                                      X2="421"
                                                      Y2="256"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="24"
                                                      StrokeDashArray="2 2"
                                                      d:Stroke="#616161" />
                                                <Ellipse Width="46"
                                                         Height="46"
                                                         Canvas.Left="233"
                                                         Canvas.Top="233"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         d:Fill="#616161" />
                                                <Ellipse Width="46"
                                                         Height="46"
                                                         Canvas.Left="398"
